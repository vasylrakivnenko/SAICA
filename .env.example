# Copy to .env.local and fill in the xxx values. NEVER commit .env.local.
#
# Quick start:
#   cp .env.example .env.local
#   chmod 600 .env.local
#   $EDITOR .env.local

SEMANTIC_SCHOLAR_API_KEY=xxx
ELICIT_API_KEY=xxx
PERPLEXITY_API_KEY=xxx

# Azure AI Foundry -- Kimi-K2.5 backend (OpenAI-compatible client)
AZURE_KIMI_API_KEY=xxx
AZURE_KIMI_ENDPOINT=https://<resource>.services.ai.azure.com/openai/v1/
AZURE_KIMI_REGION=eastus2
AZURE_KIMI_MODEL=Kimi-K2.5

# Azure AI Foundry -- Cohere Rerank v4.0 Pro (use `api-key` header, not Bearer)
AZURE_COHERE_RERANK_API_KEY=xxx
AZURE_COHERE_RERANK_ENDPOINT=https://<resource>.services.ai.azure.com/providers/cohere/v2/rerank
AZURE_COHERE_RERANK_MODEL=Cohere-rerank-v4.0-pro

# Postgres (local dev). Default port 5432 works with Homebrew Postgres;
# use 5433 with `docker compose up -d postgres`.
POSTGRES_URL=postgresql://saica:saica_local_dev@localhost:5432/saica_kg

# Observability -- DEBUG, INFO, WARNING, ERROR, CRITICAL.
SAICA_LOG_LEVEL=INFO

# Optional: authenticated GitHub API quota (5000 req/hour vs 60 anonymous).
GITHUB_TOKEN=
