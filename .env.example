# Copy to .env.local and fill in the xxx values. NEVER commit .env.local.
#
# Quick start:
#   cp .env.example .env.local
#   chmod 600 .env.local
#   $EDITOR .env.local

SEMANTIC_SCHOLAR_API_KEY=xxx
ELICIT_API_KEY=xxx
PERPLEXITY_API_KEY=xxx

# Azure AI Foundry -- Kimi-K2.5 backend (OpenAI-compatible client)
AZURE_KIMI_API_KEY=xxx
AZURE_KIMI_ENDPOINT=https://<resource>.services.ai.azure.com/openai/v1/
AZURE_KIMI_REGION=eastus2
AZURE_KIMI_MODEL=Kimi-K2.5

# Azure AI Foundry -- Cohere Rerank v4.0 Pro (use `api-key` header, not Bearer)
AZURE_COHERE_RERANK_API_KEY=xxx
AZURE_COHERE_RERANK_ENDPOINT=https://<resource>.services.ai.azure.com/providers/cohere/v2/rerank
AZURE_COHERE_RERANK_MODEL=Cohere-rerank-v4.0-pro

# Postgres (local dev). Default port 5432 works with Homebrew Postgres;
# use 5433 with `docker compose up -d postgres`.
POSTGRES_URL=postgresql://saica:saica_local_dev@localhost:5432/saica_kg

# Observability -- DEBUG, INFO, WARNING, ERROR, CRITICAL.
SAICA_LOG_LEVEL=INFO

# Optional: authenticated GitHub API quota (5000 req/hour vs 60 anonymous).
GITHUB_TOKEN=

# ---------------------------------------------------------------------------
# Web service: python -m pipeline.webapp (/api/ask, /api/assess, /api/health).
# Defaults and meaning of every limit: pipeline/ask/README.md.
# ---------------------------------------------------------------------------
# Model for /api/ask: either the hosted provider below, or the AZURE_KIMI_*
# variables above (those win when both are set).
HYPERBOLIC_API_KEY=xxx
# ASK_MODEL=deepseek-v4.1-flash
#
# Server. (SAICA_ASK_PORT is gone; use ASK_PORT.)
# ASK_HOST=127.0.0.1
# ASK_PORT=4322
# SERVE_STATIC=1                  also serve the built site from site/dist
# FORWARDED_ALLOW_IPS=
#
# Limits (optional; each has a default).
# SAICA_ASK_BUDGET=50             questions per UTC day, all visitors together
# SAICA_ASK_TOKEN_BUDGET=600000   model tokens per UTC day
# SAICA_ASK_PER_CLIENT=10         questions per hour per client address
# SAICA_ASK_CONCURRENCY=4         questions answered at once
# SAICA_ASSESS_BUDGET=100         audits per UTC day
# SAICA_ASSESS_PER_CLIENT=10      audits per hour per client address
# SAICA_ASSESS_CONCURRENCY=2      audits running at once
# SAICA_TRUSTED_PROXY_HOPS=1      proxies in front of the app
# SAICA_CORS_ORIGINS=             comma-separated; default: the site and local dev origins
# SAICA_API_DOCS=1                turn /docs and /openapi.json on (default: off)
