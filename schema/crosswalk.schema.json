{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://saica-kg.dev/schema/crosswalk.schema.json",
  "title": "Crosswalk",
  "description": "A bulk mapping between a SAICA-KG axis and an external taxonomy's categories. Complements inline `crosswalks` declared on FailureMode nodes.",
  "type": "object",
  "required": [
    "id",
    "saica_axis",
    "taxonomy",
    "mappings"
  ],
  "properties": {
    "id": {
      "pattern": "^[a-z0-9][a-z0-9-]*[a-z0-9]$",
      "type": "string"
    },
    "saica_axis": {
      "enum": [
        "failure_mode",
        "control_paradigm",
        "temporal_phase",
        "autonomy_level",
        "locus_of_control"
      ],
      "type": "string"
    },
    "taxonomy": {
      "description": "Taxonomy node id.",
      "type": "string"
    },
    "authored_by": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "reviewed_by": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "last_reviewed": {
      "format": "date",
      "type": "string"
    },
    "mappings": {
      "items": {
        "type": "object",
        "required": [
          "saica_value",
          "external_id",
          "confidence"
        ],
        "properties": {
          "saica_value": {
            "description": "Value on the SAICA axis (e.g., a FailureMode id).",
            "type": "string"
          },
          "external_id": {
            "description": "Category id in the external taxonomy.",
            "type": "string"
          },
          "confidence": {
            "enum": [
              "exact",
              "partial",
              "broader",
              "narrower",
              "related"
            ],
            "type": "string"
          },
          "note": {
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "minItems": 1,
      "type": "array"
    }
  },
  "additionalProperties": false
}
