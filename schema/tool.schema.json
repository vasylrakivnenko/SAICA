{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://saica-kg.dev/schema/tool.schema.json",
  "title": "Tool",
  "description": "A software artifact that supervises AI coding agents.",
  "type": "object",
  "required": [
    "id",
    "name",
    "description",
    "first_released",
    "maturity_status",
    "license",
    "control_paradigm",
    "temporal_phase",
    "autonomy_level",
    "addresses_failure_modes"
  ],
  "properties": {
    "id": {
      "description": "Stable kebab-case slug. Never changes.",
      "pattern": "^[a-z0-9][a-z0-9-]*[a-z0-9]$",
      "type": "string"
    },
    "name": {
      "minLength": 1,
      "type": "string"
    },
    "tagline": {
      "maxLength": 140,
      "type": "string"
    },
    "description": {
      "maxLength": 800,
      "type": "string"
    },
    "first_released": {
      "format": "date",
      "type": "string"
    },
    "last_updated": {
      "format": "date",
      "type": "string"
    },
    "maturity_status": {
      "enum": [
        "experimental",
        "stable",
        "at_risk",
        "deprecated",
        "abandoned"
      ],
      "type": "string"
    },
    "published_by": {
      "type": "string",
      "description": "Organization node id."
    },
    "repository_url": {
      "type": "string",
      "format": "uri"
    },
    "documentation_url": {
      "type": "string",
      "format": "uri"
    },
    "license": {
      "description": "SPDX identifier or 'proprietary'.",
      "type": "string"
    },
    "control_paradigm": {
      "enum": [
        "prevention",
        "detection",
        "correction",
        "recovery"
      ],
      "type": "string"
    },
    "temporal_phase": {
      "enum": [
        "pre_generation",
        "in_generation",
        "post_generation"
      ],
      "type": "string"
    },
    "autonomy_level": {
      "enum": [
        "fully_autonomous",
        "graduated_hitl",
        "full_hitl"
      ],
      "type": "string"
    },
    "addresses_failure_modes": {
      "items": {
        "enum": [
          "fabrication",
          "obsolescence",
          "dependency_blindness",
          "logic_error",
          "security_vulnerability",
          "scope_creep",
          "context_pollution",
          "supply_chain_attack",
          "cascading_failure",
          "incomplete_execution",
          "test_manipulation"
        ],
        "type": "string"
      },
      "minItems": 1,
      "type": "array"
    },
    "locus_of_control": {
      "items": {
        "enum": [
          "model",
          "prompt",
          "context",
          "environment",
          "human"
        ],
        "type": "string"
      },
      "type": "array"
    },
    "integration_surfaces": {
      "items": {
        "description": "How a Tool is deployed / consumed.\n\nMulti-valued: a tool can ship as several surfaces (e.g. Semgrep is\ncli + ci_app + library). Orthogonal to ControlParadigm /\nTemporalPhase / AutonomyLevel — those describe what the tool does;\nthis describes how a caller wires it in.",
        "enum": [
          "ide_plugin",
          "desktop_app",
          "web_app",
          "cli",
          "library",
          "http_service",
          "mcp_server",
          "ci_app",
          "proxy_gateway"
        ],
        "type": "string"
      },
      "type": "array",
      "description": "How this tool is deployed / consumed. Multi-valued — a tool can ship as several surfaces (e.g. cli + ci_app + library)."
    },
    "implements_techniques": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "composes_with": {
      "items": {
        "type": "string"
      },
      "type": "array",
      "description": "Symmetric; both sides must declare."
    },
    "feeds_into": {
      "items": {
        "type": "string"
      },
      "type": "array",
      "description": "Directed composition. A feeds_into B means A's output is consumed by B."
    },
    "supersedes": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "runtime_requires": {
      "items": {
        "type": "string"
      },
      "type": "array",
      "description": "Libraries/runtimes the tool itself imports."
    },
    "supervises_targets": {
      "items": {
        "type": "string"
      },
      "type": "array",
      "description": "Library / language / ecosystem the tool watches over."
    },
    "cited_in": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "documented_in": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "evaluated_on": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "security_notes": {
      "type": "string"
    },
    "signed_manifest": {
      "type": "boolean"
    },
    "openssf_scorecard_score": {
      "type": [
        "number",
        "null"
      ],
      "maximum": 10,
      "minimum": 0
    },
    "stars": {
      "minimum": 0,
      "type": "integer",
      "description": "GitHub stargazer count, refreshed periodically by validator/fetch_github_stars.py."
    },
    "stars_updated_at": {
      "format": "date",
      "type": "string",
      "description": "Date the stars count was last fetched (YYYY-MM-DD)."
    },
    "contributors": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "editorial_notes": {
      "type": "string"
    },
    "inclusion_rationale": {
      "type": "string"
    },
    "provenance": {
      "type": "object",
      "required": [
        "source",
        "ingested_at"
      ],
      "properties": {
        "source": {
          "description": "Where this node came from (e.g. 'manual', 'pipeline-v0.1', 'import-from-awesome-list').",
          "type": "string"
        },
        "ingested_at": {
          "description": "Date the node entered data/ (YYYY-MM-DD).",
          "format": "date",
          "type": "string"
        },
        "extractor_model": {
          "type": "string",
          "description": "LLM identifier that produced the structured draft (e.g. 'Kimi-K2.5')."
        },
        "extractor_confidence": {
          "maximum": 1.0,
          "minimum": 0.0,
          "type": "number",
          "description": "Overall LLM confidence attached to the extraction payload (0-1)."
        },
        "rerank_score": {
          "maximum": 1.0,
          "minimum": 0.0,
          "type": "number",
          "description": "Cohere rerank score used to prioritize this candidate (0-1)."
        },
        "candidate_id": {
          "type": "integer",
          "description": "Link back to candidate_tools.id (or equivalent) in Postgres."
        },
        "reviewer": {
          "type": "string",
          "description": "GitHub handle of the person who merged the node."
        },
        "review_date": {
          "format": "date",
          "type": "string",
          "description": "Date the merge was accepted."
        }
      },
      "additionalProperties": false,
      "description": "How this tool entered the KG. Optional on pre-existing nodes; newly-graduated tools must populate this."
    }
  },
  "additionalProperties": false
}
