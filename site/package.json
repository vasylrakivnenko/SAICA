{
  "name": "saica-kg-site",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "dev": "astro dev --ignore-lock",
    "start": "astro dev --ignore-lock",
    "build": "npm run gen-types && node scripts/check-public-data.mjs && astro build && node scripts/gen-sitemap.mjs",
    "check": "astro check",
    "check:links": "node scripts/check-links.mjs",
    "check:wording": "node scripts/check-bench-wording.mjs",
    "check:mutation": "node scripts/check-results-mutation.mjs",
    "preview": "astro preview",
    "astro": "astro",
    "gen-types": "node scripts/gen-types.mjs"
  },
  "dependencies": {
    "astro": "^7.4.12",
    "cytoscape": "3.35.0",
    "js-yaml": "^5.5.0",
    "tailwindcss": "^4.3.5"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@types/cytoscape": "^3.31.0",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^26.6.6",
    "json-schema-to-typescript": "^16.0.0",
    "postcss": "^8.5.33",
    "typescript": "^7.0.2"
  }
}
