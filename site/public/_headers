# Response headers for Cloudflare Pages (https://developers.cloudflare.com/pages/configuration/headers/).
# These are the rules the Python server applies when it serves the site (pipeline/webapp.py: SECURITY_HEADERS,
# HSTS_HEADER, NOINDEX_PREFIXES, NOINDEX_SUFFIXES, IMMUTABLE_PREFIX). tests/test_static_host_files.py fails
# when the two drift apart.
#
# A request that matches several rules gets the headers of all of them, and a header set twice is sent as
# "noindex, noindex" (for example /api/v1/snapshot.json). Crawlers read that as noindex.
# No Content-Security-Policy yet: the pages ship inline scripts and styles, so a policy needs hashes first.

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
  Strict-Transport-Security: max-age=31536000

# Astro writes content-hashed file names here, so a file never changes in place.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# Data files stay fetchable (the graph page reads /api/v1/*.json) but out of search results.
/api/*
  X-Robots-Tag: noindex

/kit/*
  X-Robots-Tag: noindex

/*.json
  X-Robots-Tag: noindex

/*.jsonl
  X-Robots-Tag: noindex

/*.py
  X-Robots-Tag: noindex

/*.md
  X-Robots-Tag: noindex

/*.yml
  X-Robots-Tag: noindex

/*.yaml
  X-Robots-Tag: noindex
