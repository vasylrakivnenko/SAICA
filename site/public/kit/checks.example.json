{
  "version": 1,
  "kit": "optimal",
  "builtin": {
    "enabled": true,
    "blocking": false
  },
  "tools": [
    {
      "id": "semgrep",
      "failure_modes": [
        "security_vulnerability"
      ],
      "runs_per_commit": true,
      "command": "semgrep scan --config auto --error --quiet {files}",
      "blocking": true,
      "timeout_s": 300
    },
    {
      "id": "sentrux",
      "failure_modes": [
        "cascading_failure",
        "dependency_blindness"
      ],
      "runs_per_commit": true,
      "command": "sentrux gate",
      "blocking": false,
      "metric": {
        "name": "quality",
        "regex": "quality[^0-9]*([0-9]+(?:\\.[0-9]+)?)"
      }
    },
    {
      "id": "pytest",
      "failure_modes": [
        "logic_error"
      ],
      "runs_per_commit": true,
      "command": "python3 -m pytest -q -x",
      "blocking": true,
      "timeout_s": 600
    }
  ]
}
