---
// Best tool per failure mode, rendered at build time (crawlable without JS). Used on /tools/ (above the catalog) and
// on /findings/. Each mode links to its failure-mode page and its leaderboard tab.
import { logoSvg } from '../../lib/providers';
import { CLASSIC as SUMMARIES, TYPE_LABEL, TYPE_VAR, THINKING_LABEL, pct, costLabel, shortName, toolHref } from './bench';

interface Props {
  /** Order rows by best J (solved first) instead of the leaderboard's mode order. */
  byJ?: boolean;
  /** Show a key for the type dots under the table (for pages without the leaderboard's legend). */
  legend?: boolean;
}
const { byJ = false, legend = false } = Astro.props;
const rows = byJ ? [...SUMMARIES].sort((a, b) => b.best.j - a.best.j) : SUMMARIES;
const types = [...new Set(rows.flatMap((s) => (s.free ? [s.best.type, s.free.type] : [s.best.type])))];
---

<div class="bpm-wrap">
  <table class="bpm">
    <thead>
      <tr>
        <th>Failure mode</th>
        <th>Best reviewer</th>
        <th title="Whether a model thinks before it answers, and at what effort level (models only)">Thinking</th>
        <th class="num">J</th>
        <th class="num">TPR</th>
        <th class="num">FPR</th>
        <th class="num">Cost / 1k</th>
        <th>Best free option</th>
        <th><span class="sr-only">Leaderboard tab</span></th>
      </tr>
    </thead>
    <tbody>
      {rows.map((s) => {
        const b = s.best, f = s.free, bh = toolHref(b), fh = f ? toolHref(f) : null;
        return (
          <tr>
            <td class="mode"><a href={s.url}>{s.m.name}</a></td>
            <td class="tool" title={b.tool}>
              <i class="dot" style={`background:var(${TYPE_VAR[b.type]})`} title={TYPE_LABEL[b.type]}></i>
              {b.type === 'baseline_model' && <Fragment set:html={logoSvg(b.tool)} />}
              {bh ? <a href={bh}>{shortName(s.m, b)}</a> : shortName(s.m, b)}
            </td>
            <td class="think" title={b.thinking_note || (b.thinking ? THINKING_LABEL[b.thinking] : undefined)}>{b.thinking ?? '—'}</td>
            <td class="num j">{pct(b.j)}</td>
            <td class="num">{pct(b.catch)}</td>
            <td class="num">{pct(b.fa)}</td>
            <td class="num">{costLabel(b, s.m)}</td>
            <td class="free" title={f ? f.tool : ''}>
              {f ? (
                <>
                  {fh ? <a href={fh}>{shortName(s.m, f)}</a> : shortName(s.m, f)}
                  <span class="fj">J {pct(f.j)}</span>
                </>
              ) : (
                '—'
              )}
            </td>
            <td class="tab"><a href={s.tab}>All {s.rows.length} →</a></td>
          </tr>
        );
      })}
    </tbody>
  </table>
</div>
{legend && (
  <p class="bpm-legend">
    {types.map((t) => <span><i class="dot" style={`background:var(${TYPE_VAR[t]})`}></i>{TYPE_LABEL[t]}</span>)}
  </p>
)}

<style>
  .bpm-wrap, .bpm-legend {
    --t-free: #1f3a93; --t-ai: #8a3f9e; --t-hybrid: #b7791f; --t-skill: #3b7d4f; --t-base: #5f6676; --t-rule: #9a9fab;
  }
  .bpm-wrap {
    overflow-x: auto; padding-bottom: 4px;
    position: relative; /* keeps the absolutely positioned sr-only header inside the scroller (else the page scrolls sideways on phones) */
  }
  .bpm { width: 100%; border-collapse: collapse; font: 14px ui-sans-serif, system-ui, sans-serif; font-variant-numeric: tabular-nums; }
  .bpm th, .bpm td { text-align: left; padding: .5rem .6rem; border-bottom: 1px solid rgb(17 20 24 / .08); white-space: nowrap; }
  .bpm th { font-size: 12px; font-weight: 600; color: #4a5160; text-transform: uppercase; letter-spacing: .04em; }
  .bpm .num { text-align: right; }
  .bpm td.j { font-weight: 600; }
  .bpm td.think { color: #5b6370; font-size: 13px; }
  .bpm td.mode a { color: #111418; text-decoration: none; border-bottom: 1px dotted #6b7180; font-weight: 500; }
  .bpm td.mode a:hover, .bpm td.mode a:focus-visible { color: #1f3a93; }
  .bpm td.tool a, .bpm td.free a { color: #1f3a93; }
  .bpm .plogo { width: 14px; height: 14px; vertical-align: -2px; margin-right: 5px; color: #2b3038; }
  .bpm-legend { display: flex; flex-wrap: wrap; gap: .3rem 1rem; margin: .6rem 0 0; font: 12px ui-sans-serif, system-ui, sans-serif; color: #4a5160; }
  .bpm .dot, .bpm-legend .dot { display: inline-block; width: 9px; height: 9px; border-radius: 50%; margin-right: 8px; vertical-align: 1px; }
  .bpm .fj { color: #6b7180; margin-left: .45rem; }
  .bpm td.tab { text-align: right; font-size: 13px; }
  .bpm td.tab a { color: #4a5160; }
  .bpm td.tab a:hover { color: #1f3a93; }
</style>
