---
// "How well can it be caught?" for one benchmarked failure mode, rendered at build time from results.json
// (through components/home/bench.ts): what the set scores and where its bad samples come from, who is best by the
// file's naming rules, the full results table with run cards, the same answers scored another way (strata), setup
// and caveats. No number, name or tier is typed here.
import ModeFacts from '../bench/ModeFacts.astro';
import ResultsTable from '../bench/ResultsTable.astro';
import Strata from '../bench/Strata.astro';
import { leaderboardUrl } from '../../lib/seo.ts';
import { bestLabel, bestState, highestJ, modeLinks, rowByKey, rowHref, topShortcut, type Mode } from '../home/bench.ts';
import { pct, signedPct } from '../../lib/format.ts';

interface Props {
  m: Mode;
  /** Noun phrase for the heading: "How well can <subject> be caught?" */
  subject: string;
}
const { m, subject } = Astro.props;
const tool = m.best_catalog_tool;
const toolRow = tool ? rowByKey(m, tool.key) : undefined;
const toolHref = toolRow ? rowHref(toolRow) : null;
const shortcut = topShortcut(m);
const hasStrata = Object.keys(m.strata ?? {}).length + Object.keys(m.tables ?? {}).length > 0;
---

<section aria-labelledby="caught">
  <h2 id="caught">How well can {subject} be caught?</h2>
  <p class="leading-7 max-w-3xl">
    <span class="inline-block align-middle mr-1 rounded-full border border-ink/15 bg-paper-alt px-2.5 py-0.5 font-sans text-xs font-semibold text-ink" data-tier-for={m.id}>{m.tier_label}</span>
    {m.title !== m.name && <>SAICA-Bench scores this mode as <strong>{m.title.replace(/^./, (c) => c.toLowerCase())}</strong>. </>}
    {m.summary} <span data-ranking-for={m.id}>{m.ranking}</span>
  </p>

  <div class="mt-5 grid gap-4 sm:grid-cols-3">
    <div class="card !p-4">
      <h3 class="!mt-0 !mb-0 text-xs uppercase tracking-wide text-ink-faint font-semibold">Best reviewer</h3>
      <p class="font-sans text-[11px] text-ink-faint">any ranked row; a tie is shown as a top group</p>
      <p class="mt-2 font-sans font-semibold leading-snug" data-best-for={m.id} data-best-state={bestState(m)}>{bestLabel(m, 4)}</p>
      <p class="mt-1 font-sans text-sm tabular-nums text-ink-muted">Highest J {highestJ(m)}</p>
    </div>
    <div class="card !p-4">
      <h3 class="!mt-0 !mb-0 text-xs uppercase tracking-wide text-ink-faint font-semibold">Best catalog tool</h3>
      <p class="font-sans text-[11px] text-ink-faint">a tool of the catalog running its own check</p>
      {!tool ? (
        <p class="mt-2 text-sm text-ink-muted">No tool of the catalog ran a check of its own on this set.</p>
      ) : m.below_floor ? (
        <p class="mt-2 text-sm text-ink-muted">None reaches J {pct(m.floor, 0)} on this set, so none is named.</p>
      ) : (
        <>
          <p class="mt-2 font-sans font-semibold leading-snug">{toolHref ? <a href={toolHref}>{tool.short}</a> : tool.short}</p>
          <p class="mt-1 font-sans text-sm tabular-nums text-ink-muted">J {signedPct(tool.j)} (95% interval {signedPct(tool.j_ci[0])} to {signedPct(tool.j_ci[1])})</p>
        </>
      )}
    </div>
    <div class="card !p-4">
      <h3 class="!mt-0 !mb-0 text-xs uppercase tracking-wide text-ink-faint font-semibold">Shortcut baseline</h3>
      <p class="font-sans text-[11px] text-ink-faint">a rule that understands nothing about the failure</p>
      {shortcut ? (
        <>
          <p class="mt-2 font-sans font-semibold leading-snug">{shortcut.short}</p>
          <p class="mt-1 font-sans text-sm tabular-nums text-ink-muted">J {signedPct(shortcut.j)}. Read the reviewers against this, not against 0.</p>
        </>
      ) : (
        <p class="mt-2 text-sm text-ink-muted">None is published for this set.</p>
      )}
    </div>
  </div>

  <h3>What was tested</h3>
  <ModeFacts m={m} ranking={false} />

  <h3>All results on this set</h3>
  <ResultsTable m={m} />

  {hasStrata && (
    <>
      <h3>The same answers, scored another way</h3>
      <p class="text-sm text-ink-muted max-w-3xl">
        Parts of the set, or the same set under another labelling. They show how far the headline J depends on how
        the set was built.
      </p>
      <Strata m={m} />
    </>
  )}

  <h3>How it was tested</h3>
  <ul class="list-disc pl-5 text-sm leading-6 space-y-1 max-w-4xl">
    {m.setup.map((s) => <li>{s}</li>)}
  </ul>
  <h3>Caveats</h3>
  <ul class="list-disc pl-5 text-sm leading-6 space-y-1 max-w-4xl">
    {m.caveats.map((s) => <li>{s}</li>)}
  </ul>

  <p class="mt-5 font-sans text-sm flex flex-wrap gap-x-5 gap-y-1">
    <a href={leaderboardUrl(m.id)}>{m.title} on the leaderboard →</a>
    <a href={modeLinks(m).method}>How this set was built →</a>
    <a href="/benchmark/#threats">Threats to validity →</a>
    <a href="/tool-coverage/">Build a supervision kit →</a>
  </p>
</section>
