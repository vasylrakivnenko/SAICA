---
// The same answers scored on parts of a set or under another labelling (results.json modes[].strata, passed
// through from bench/<mode>/published/extras.json). They change how the headline J should be read, so they sit
// next to it. With fewer than MIN_FOR_RATES samples in a class a rate would mislead, so counts are printed.
// The mode's extra tables (modes[].tables) have no common shape; they are named here with their notes and
// left to the JSON file.
import { rowByKey, type Mode, type StratumRow } from '../home/bench';
import { int, pct, signedPct } from '../../lib/format';

interface Props {
  m: Mode;
}
const { m } = Astro.props;
const MIN_FOR_RATES = 20;
const strata = Object.entries(m.strata ?? {});
const tables = Object.entries(m.tables ?? {});
const title = (k: string) => k.replace(/_/g, ' ').replace(/^./, (c) => c.toUpperCase());
const name = (key: string) => rowByKey(m, key)?.short ?? key;
const order = (rows: Record<string, StratumRow>) => Object.entries(rows).sort((a, b) => b[1].j - a[1].j);
const noteOf = (t: unknown): string => (t && typeof t === 'object' && typeof (t as any).note === 'string' ? (t as any).note : '');
---

{(strata.length > 0 || tables.length > 0) && (
  <div class="st">
    {strata.map(([key, s]) => {
      const rows = order(s.rows ?? {});
      const small = (s.n_pos ?? 0) < MIN_FOR_RATES || (s.n_neg ?? 0) < MIN_FOR_RATES;
      return (
        <details class="st-one" data-stratum={`${m.id}/${key}`}>
          <summary>
            {title(key)}
            {s.n_pos != null && s.n_neg != null && <span class="st-n"> · {int(s.n_pos)} bad, {int(s.n_neg)} clean</span>}
          </summary>
          {s.description && <p class="st-desc">{s.description}</p>}
          {rows.length > 0 && (
            <div class="st-wrap">
              <table>
                <thead>
                  {small ? (
                    <tr><th scope="col">Row</th><th scope="col" class="num">Bad samples flagged</th><th scope="col" class="num">Clean samples flagged</th></tr>
                  ) : (
                    <tr><th scope="col">Row</th><th scope="col" class="num">J</th><th scope="col" class="num">95% interval</th><th scope="col" class="num">TPR</th><th scope="col" class="num">FPR</th></tr>
                  )}
                </thead>
                <tbody>
                  {rows.map(([k, r]) =>
                    small ? (
                      <tr><th scope="row">{name(k)}</th><td class="num">{int(r.tp)} of {int(r.n_pos)}</td><td class="num">{int(r.fp)} of {int(r.n_neg)}</td></tr>
                    ) : (
                      <tr><th scope="row">{name(k)}</th><td class="num strong">{signedPct(r.j)}</td><td class="num">{signedPct(r.j_lo)} to {signedPct(r.j_hi)}</td><td class="num">{pct(r.tpr)}</td><td class="num">{pct(r.fpr)}</td></tr>
                    ),
                  )}
                </tbody>
              </table>
            </div>
          )}
          {small && <p class="st-desc">Counts, not rates: a class of this part has fewer than {MIN_FOR_RATES} samples.</p>}
        </details>
      );
    })}
    {tables.length > 0 && (
      <details class="st-one">
        <summary>More tables for this set in results.json</summary>
        <ul class="st-tables">
          {tables.map(([key, t]) => <li><code>{key}</code>{noteOf(t) && <>: {noteOf(t)}</>}</li>)}
        </ul>
        <p class="st-desc">They are under <code>modes[].tables</code> of <a href="/bench/results.json">results.json</a>.</p>
      </details>
    )}
  </div>
)}

<style>
  .st { margin-top: .5rem; max-width: 56rem; }
  .st-one { border-bottom: 1px solid rgb(17 20 24 / .08); padding: .35rem 0; font: 13.5px/1.45 ui-sans-serif, system-ui, sans-serif; }
  .st-one summary { cursor: pointer; color: #1f3a93; }
  .st-n { color: #6b7180; }
  .st-desc { margin: .4rem 0; max-width: 80ch; color: #4a5160; }
  .st-wrap { overflow-x: auto; }
  .st table { border-collapse: collapse; font-variant-numeric: tabular-nums; }
  .st th, .st td { padding: .3rem .6rem; border-bottom: 1px solid rgb(17 20 24 / .06); text-align: left; }
  .st thead th { font-size: 12px; font-weight: 600; color: #4a5160; }
  .st tbody th { font-weight: 500; }
  .st .num { text-align: right; white-space: nowrap; }
  .st td.strong { font-weight: 600; }
  .st-tables { margin: .4rem 0 0; padding-left: 1.1rem; list-style: disc; color: #4a5160; }
  .st-tables li { margin: .2rem 0; max-width: 80ch; }
</style>
