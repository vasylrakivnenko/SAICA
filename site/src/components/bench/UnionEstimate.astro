---
// What running the prompt of every mode on every change would do to false alarms (results.overview
// .union_false_alarm). It is an estimate under independence, not a measurement, and the block says so in the
// file's own words. Shown next to the grid and wherever per-mode scores could be read as a product.
import { UNION } from '../home/bench';
import { money, num, pct } from '../../lib/format';
---

{UNION && (
  <div class="ue">
    <p class="ue-what">
      <span class="ue-status">{UNION.status}</span>
      {UNION.what}.
    </p>
    <div class="ue-wrap">
      <table>
        <thead>
          <tr>
            <th scope="col">Model</th>
            <th scope="col" class="num">Prompts run on each change</th>
            <th scope="col" class="num">Clean changes with at least one flag</th>
            <th scope="col" class="num">Expected false alarms per clean change</th>
            <th scope="col" class="num">Cost per 1,000 changes, all prompts</th>
            <th scope="col" class="num">Only the prompts of modes above the floor</th>
          </tr>
        </thead>
        <tbody>
          {UNION.rows.map((r) => (
            <tr>
              <th scope="row">{r.model}</th>
              <td class="num">{r.n_prompts}</td>
              <td class="num strong">{pct(r.any_flag, 0)}</td>
              <td class="num">{num(r.expected_false_alarms_per_clean_change, 2)}</td>
              <td class="num">{money(r.cost1k_all_prompts)}</td>
              <td class="num">{r.above_floor ? `${pct(r.above_floor.any_flag, 0)} with ${r.above_floor.n_prompts} prompts` : 'n/a'}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
    <p class="ue-note">{UNION.assumption}</p>
  </div>
)}

<style>
  .ue { margin-top: .6rem; }
  .ue-what { margin: 0 0 .4rem; max-width: 80ch; font: 14px/1.5 ui-sans-serif, system-ui, sans-serif; color: #111418; }
  .ue-status { display: inline-block; margin-right: .4rem; padding: 1px 8px; border: 1px solid #b7791f; border-radius: 999px; font-size: 12px; font-weight: 600; color: #8a5a12; background: #fdf6e7; }
  .ue-wrap { overflow-x: auto; padding-bottom: 4px; }
  .ue table { border-collapse: collapse; font: 13.5px/1.35 ui-sans-serif, system-ui, sans-serif; font-variant-numeric: tabular-nums; }
  .ue th, .ue td { padding: .4rem .6rem; border-bottom: 1px solid rgb(17 20 24 / .08); text-align: left; vertical-align: bottom; }
  .ue thead th { font-size: 12px; font-weight: 600; color: #4a5160; max-width: 9.5rem; }
  .ue tbody th { font-weight: 500; white-space: nowrap; }
  .ue .num { text-align: right; }
  .ue td.strong { font-weight: 600; }
  .ue-note { margin: .4rem 0 0; max-width: 80ch; font: 13px/1.5 ui-sans-serif, system-ui, sans-serif; color: #4a5160; }
</style>
