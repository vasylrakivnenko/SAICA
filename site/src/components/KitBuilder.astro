    '- A change to the kit itself (.saica/, the hooks, saica-ci.yml) is stopped by the built-in saica:kit-tamper check. Commit an intended kit change on its own with SAICA_KIT_CHANGE_OK=1; never set that variable for other commits.', '');
  lines.push('## Process', '', ...steps.map((s, k) => `${k + 1}. ${s}`), '', '## Draft .saica/checks.json', '', '```json', JSON.stringify(buildChecks(), null, 2), '```', '',
    '## Report', '', 'Report per check: configured / not configured / blocked, the self-test result, the benchmark J of each configured check and what that check sees at commit time. Do not claim protection just because a package is installed.', '');
  return lines.filter((x) => x != null).join('\n');
}
// For tests (tests/kit/kb_harness.mjs): the same functions the page uses.
if (typeof globalThis.__SAICA_KB_TEST__ === 'object') Object.assign(globalThis.__SAICA_KB_TEST__, { state, choose, buildChecks, buildPrompt, render });

