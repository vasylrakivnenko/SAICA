---
// /explore — Interactive 2D projection of KG embeddings.
// Loads /embeddings.json at runtime and renders with raw SVG (no chart lib).
// Consistent with /graph: tool blue, failure_mode rose, taxonomy violet, paper slate.
import BaseLayout from "../layouts/BaseLayout.astro";
import { breadcrumbs } from "../lib/seo";
const title = "Semantic map of AI coding agent failures, tools and papers";
const description =
  "A 2D map of the AI coding agent failure modes, supervision tools, taxonomies and papers in the SAICA catalog, placed by how similar their descriptions are.";
const jsonld = breadcrumbs([
  ["SAICA-Bench", "/"],
  ["Semantic map", "/explore/"],
]);
---

<BaseLayout title={title} description={description} jsonld={jsonld}>
  <section class="mb-4">
    <h1>Semantic map of failures, tools and papers</h1>
    <p class="text-sm text-ink-muted max-w-3xl">
      This map places the catalog's <a href="/failure-modes/">AI coding agent failure modes</a>,
      <a href="/tools/">supervision tools</a>, <a href="/taxonomies/">failure taxonomies</a> and
      <a href="/papers/">research papers</a> by how similar their descriptions are, so tools that talk about
      the same failures sit near them. For the explicit links between them (which tool addresses which failure,
      which paper defines it) see the <a href="/graph/">knowledge graph</a>.
    </p>
    <p class="mt-2 text-sm text-ink-muted max-w-3xl">
      Each dot is a KG node projected from a 384-dim sentence-transformer
      embedding down to 2D via UMAP. Nearby points share vocabulary — not
      necessarily facet labels. Hover to identify, click to open. With a keyboard, Tab into the map, move between
      dots with the arrow keys and press Enter to open one.
    </p>
  </section>

  <div class="grid grid-cols-1 md:grid-cols-[14rem_minmax(0,1fr)] gap-4" id="explore-root">
    <aside class="ui text-sm">
      <div class="mb-4">
        <div class="text-xs font-semibold text-ink-faint uppercase tracking-wide mb-1">Projection</div>
        <select id="ex-proj" class="w-full border border-ink/15 rounded px-2 py-1 bg-white">
          <option value="combined" selected>combined (all types)</option>
          <option value="tool">tools only</option>
          <option value="failure_mode">failure modes only</option>
          <option value="taxonomy">taxonomies only</option>
          <option value="paper">papers only</option>
        </select>
      </div>

      <fieldset class="mb-4">
        <legend class="text-xs font-semibold text-ink-faint uppercase tracking-wide mb-1">Node types</legend>
        <label class="block"><input type="checkbox" data-type="tool" checked /> <span class="inline-block w-2 h-2 rounded-full align-middle" style="background:#2563eb"></span> Tools</label>
        <label class="block"><input type="checkbox" data-type="failure_mode" checked /> <span class="inline-block w-2 h-2 rounded-full align-middle" style="background:#e11d48"></span> Failure modes</label>
        <label class="block"><input type="checkbox" data-type="taxonomy" checked /> <span class="inline-block w-2 h-2 rounded-full align-middle" style="background:#7c3aed"></span> Taxonomies</label>
        <label class="block"><input type="checkbox" data-type="paper" checked /> <span class="inline-block w-2 h-2 rounded-full align-middle" style="background:#64748b"></span> Papers</label>
      </fieldset>

      <fieldset class="mb-4">
        <legend class="text-xs font-semibold text-ink-faint uppercase tracking-wide mb-1">Tool facets</legend>
        <label for="ex-cp" class="block text-xs text-ink-faint mt-1">control_paradigm</label>
        <select id="ex-cp" class="w-full border border-ink/15 rounded px-2 py-1 bg-white">
          <option value="">any</option>
          <option value="prevention">prevention</option>
          <option value="detection">detection</option>
          <option value="correction">correction</option>
          <option value="recovery">recovery</option>
        </select>
        <label for="ex-tp" class="block text-xs text-ink-faint mt-2">temporal_phase</label>
        <select id="ex-tp" class="w-full border border-ink/15 rounded px-2 py-1 bg-white">
          <option value="">any</option>
          <option value="pre_generation">pre_generation</option>
          <option value="in_generation">in_generation</option>
          <option value="post_generation">post_generation</option>
        </select>
        <label for="ex-al" class="block text-xs text-ink-faint mt-2">autonomy_level</label>
        <select id="ex-al" class="w-full border border-ink/15 rounded px-2 py-1 bg-white">
          <option value="">any</option>
          <option value="fully_autonomous">fully_autonomous</option>
          <option value="graduated_hitl">graduated_hitl</option>
          <option value="full_hitl">full_hitl</option>
        </select>
      </fieldset>

      <div id="ex-count" class="text-xs text-ink-faint"></div>
    </aside>

    <div class="relative border border-ink/10 rounded bg-white" style="height:78vh; min-height:360px; max-height:900px">
      <noscript>
        <div class="p-3 text-sm">
          The embedding explorer requires JavaScript. You can still read the raw
          data at <a href="/embeddings.json">/embeddings.json</a>.
        </div>
      </noscript>
      <p id="ex-kbd-help" class="sr-only">
        Each dot is a link to that node's page. Use the arrow keys to move to the nearest dot in that direction,
        Home and End for the first and last dot, and Enter or Space to open the focused one. Escape hides its label.
      </p>
      <svg id="ex-svg" role="group" aria-label="2D semantic map of catalog nodes" aria-describedby="ex-kbd-help"
           style="width:100%; height:100%; display:block"></svg>
      <div id="ex-live" class="sr-only" role="status" aria-live="polite" aria-atomic="true"></div>
      <div id="ex-tooltip"
           class="pointer-events-none absolute hidden bg-ink text-white text-xs rounded px-2 py-1 shadow"
           style="transform: translate(-50%, -110%);"></div>
      <div id="ex-fallback" class="hidden absolute inset-0 p-6 text-sm bg-white"></div>
    </div>
  </div>
</BaseLayout>

<script>
  import { fmUrl, toolUrl } from "../lib/seo";

  type Facet = { control_paradigm: string; temporal_phase: string; autonomy_level: string } | null;
  interface Row {
    id: string; name: string; type: string;
    x: number; y: number;
    top_similar_ids: string[];
    facet: Facet;
  }
  interface Payload {
    model: string; dim: number; count: number;
    by_type: Record<string, Row[]>;
    combined: Row[];
  }

  const COLORS: Record<string, string> = {
    tool: "#2563eb",
    failure_mode: "#e11d48",
    taxonomy: "#7c3aed",
    paper: "#64748b",
  };
  const NODE_URL: Record<string, (id: string) => string> = {
    tool: (id) => toolUrl(id),
    failure_mode: (id) => fmUrl(id),
    taxonomy: (id) => `/taxonomies/${id}/`,
    paper: (id) => `/papers/${id}/`,
  };

  const svg = document.getElementById("ex-svg") as unknown as SVGSVGElement | null;
  const tooltip = document.getElementById("ex-tooltip") as HTMLDivElement | null;
  const fallback = document.getElementById("ex-fallback") as HTMLDivElement | null;
  const projSelect = document.getElementById("ex-proj") as HTMLSelectElement | null;
  const cpSelect = document.getElementById("ex-cp") as HTMLSelectElement | null;
  const tpSelect = document.getElementById("ex-tp") as HTMLSelectElement | null;
  const alSelect = document.getElementById("ex-al") as HTMLSelectElement | null;
  const countEl = document.getElementById("ex-count") as HTMLElement | null;
  const typeBoxes = Array.from(
    document.querySelectorAll<HTMLInputElement>("input[data-type]")
  );
  const svgNS = "http://www.w3.org/2000/svg";
  let payload: Payload | null = null;

  function visibleRows(): Row[] {
    if (!payload) return [];
    const mode = projSelect?.value ?? "combined";
    const base = mode === "combined" ? payload.combined : (payload.by_type[mode] ?? []);
    const activeTypes = new Set(
      typeBoxes.filter((b) => b.checked).map((b) => b.dataset.type as string)
    );
    const cp = cpSelect?.value ?? "";
    const tp = tpSelect?.value ?? "";
    const al = alSelect?.value ?? "";
    return base.filter((r) => {
      if (!activeTypes.has(r.type)) return false;
      if (r.type === "tool" && (cp || tp || al)) {
        if (!r.facet) return false;
        if (cp && r.facet.control_paradigm !== cp) return false;
        if (tp && r.facet.temporal_phase !== tp) return false;
        if (al && r.facet.autonomy_level !== al) return false;
      }
      return true;
    });
  }

  const TYPE_LABEL: Record<string, string> = {
    tool: "tool", failure_mode: "failure mode", taxonomy: "taxonomy", paper: "paper",
  };
  // Keyboard access: each dot is an SVG <a> (so Enter, middle-click and screen-reader link lists work
  // natively). Only one dot is in the Tab order at a time (roving tabindex); arrows move between dots.
  let currentId: string | null = null;
  let focusRing: SVGCircleElement | null = null;
  const liveEl = document.getElementById("ex-live");

  function links(): SVGAElement[] {
    return svg ? Array.from(svg.querySelectorAll<SVGAElement>("a[data-id]")) : [];
  }
  function dotOf(a: SVGAElement): SVGCircleElement {
    return a.querySelector("circle") as SVGCircleElement;
  }
  function setCurrent(a: SVGAElement | null, focus: boolean): void {
    for (const l of links()) l.setAttribute("tabindex", l === a ? "0" : "-1");
    if (!a) return;
    currentId = a.dataset.id ?? null;
    if (focus) a.focus({ preventScroll: true });
  }
  function showFocusRing(a: SVGAElement | null): void {
    if (!svg) return;
    if (!a) {
      focusRing?.remove();
      focusRing = null;
      tooltip?.classList.add("hidden");
      return;
    }
    const dot = dotOf(a);
    if (!focusRing) {
      focusRing = document.createElementNS(svgNS, "circle") as SVGCircleElement;
      focusRing.setAttribute("fill", "none");
      focusRing.setAttribute("stroke", "#1f3a93");
      focusRing.setAttribute("stroke-width", "3");
      focusRing.setAttribute("pointer-events", "none");
      focusRing.setAttribute("aria-hidden", "true");
    }
    focusRing.setAttribute("cx", dot.getAttribute("cx") ?? "0");
    focusRing.setAttribute("cy", dot.getAttribute("cy") ?? "0");
    focusRing.setAttribute("r", String(Number(dot.getAttribute("r") ?? 6) + 4));
    svg.appendChild(focusRing); // last child = drawn on top
    if (tooltip) {
      tooltip.textContent = `${a.dataset.name ?? ""} · ${a.dataset.id ?? ""}`;
      tooltip.style.left = `${dot.getAttribute("cx")}px`;
      tooltip.style.top = `${Number(dot.getAttribute("cy")) - 8}px`;
      tooltip.classList.remove("hidden");
    }
  }
  // Nearest dot in a direction: inside a ~70 degree cone, scored by distance along the axis plus twice the
  // sideways offset; falls back to the whole half-plane when the cone is empty.
  function nearestInDirection(from: SVGAElement, dx: number, dy: number): SVGAElement | null {
    const d0 = dotOf(from);
    const x0 = Number(d0.getAttribute("cx")), y0 = Number(d0.getAttribute("cy"));
    let best: SVGAElement | null = null, bestScore = Infinity;
    for (const a of links()) {
      if (a === from) continue;
      const d = dotOf(a);
      const vx = Number(d.getAttribute("cx")) - x0, vy = Number(d.getAttribute("cy")) - y0;
      const along = vx * dx + vy * dy;
      if (along <= 0.5) continue;
      const perp = Math.abs(vx * dy - vy * dx);
      const score = along + 2 * perp + (perp > along * 1.4 ? 1e7 : 0);
      if (score < bestScore) { bestScore = score; best = a; }
    }
    return best;
  }
  function onKeydown(e: KeyboardEvent): void {
    const a = (e.target as Element | null)?.closest?.("a[data-id]") as SVGAElement | null;
    if (!a || e.altKey || e.ctrlKey || e.metaKey) return;
    const dirs: Record<string, [number, number]> = {
      ArrowLeft: [-1, 0], ArrowRight: [1, 0], ArrowUp: [0, -1], ArrowDown: [0, 1],
    };
    if (e.key in dirs) {
      e.preventDefault();
      const [dx, dy] = dirs[e.key];
      const next = nearestInDirection(a, dx, dy);
      if (next) setCurrent(next, true);
      else if (liveEl) {
        liveEl.textContent = "";
        setTimeout(() => { liveEl.textContent = `No dot further ${e.key.replace("Arrow", "").toLowerCase()}.`; }, 40);
      }
    } else if (e.key === "Home" || e.key === "End") {
      e.preventDefault();
      const all = links();
      setCurrent(e.key === "Home" ? all[0] : all[all.length - 1], true);
    } else if (e.key === " ") {
      e.preventDefault();
      const href = a.getAttribute("href");
      if (href) window.location.href = href;
    } else if (e.key === "Escape") {
      showFocusRing(null);
    }
  }

  function render(): void {
    if (!svg) return;
    const hadFocus = !!svg.contains(document.activeElement) && document.activeElement !== svg;
    focusRing = null;
    while (svg.firstChild) svg.removeChild(svg.firstChild);
    // DOM (and so Tab / screen-reader) order = reading order: top to bottom, then left to right.
    const rows = visibleRows().slice().sort((a, b) => (b.y - a.y) || (a.x - b.x));
    if (countEl) countEl.textContent = `${rows.length} nodes`;
    // Draw in pixels (viewBox = the box's own size) so dots stay round whatever the box's aspect ratio;
    // PAD keeps dots off the edge. render() runs again on resize.
    const w = Math.max(1, svg.clientWidth), h = Math.max(1, svg.clientHeight), PAD = 14;
    svg.setAttribute("viewBox", `0 0 ${w} ${h}`);
    for (const r of rows) {
      const cx = PAD + r.x * (w - 2 * PAD);
      const cy = PAD + (1 - r.y) * (h - 2 * PAD); // flip y so "up" = larger
      const dot = document.createElementNS(svgNS, "circle");
      dot.setAttribute("cx", cx.toFixed(1));
      dot.setAttribute("cy", cy.toFixed(1));
      dot.setAttribute("r", r.type === "tool" ? "6" : "5.5");
      dot.setAttribute("fill", COLORS[r.type] ?? "#6b7280");
      dot.setAttribute("fill-opacity", "0.8");
      dot.setAttribute("stroke", "white");
      dot.setAttribute("stroke-width", "1.2");
      dot.style.cursor = "pointer";
      dot.dataset.id = r.id;
      dot.dataset.name = r.name;
      dot.dataset.type = r.type;
      const link = document.createElementNS(svgNS, "a") as SVGAElement;
      link.setAttribute("href", NODE_URL[r.type]?.(r.id) ?? "#");
      link.setAttribute("aria-label", `${r.name}, ${TYPE_LABEL[r.type] ?? r.type}`);
      link.setAttribute("tabindex", "-1");
      link.dataset.id = r.id;
      link.dataset.name = r.name;
      link.appendChild(dot);
      svg.appendChild(link);
    }
    const all = links();
    const keep = all.find((l) => l.dataset.id === currentId) ?? all[0] ?? null;
    setCurrent(keep, hadFocus);
  }

  function onMove(e: MouseEvent): void {
    const target = e.target as Element | null;
    if (!target || target.tagName !== "circle" || !tooltip || !svg) {
      if (tooltip) tooltip.classList.add("hidden");
      return;
    }
    const rect = svg.getBoundingClientRect();
    const name = (target as SVGCircleElement).dataset.name ?? "";
    const id = (target as SVGCircleElement).dataset.id ?? "";
    tooltip.textContent = `${name} · ${id}`;
    tooltip.style.left = `${e.clientX - rect.left}px`;
    tooltip.style.top = `${e.clientY - rect.top}px`;
    tooltip.classList.remove("hidden");
  }

  async function init(): Promise<void> {
    try {
      const res = await fetch("/embeddings.json");
      if (!res.ok) throw new Error(`HTTP ${res.status}`);
      payload = (await res.json()) as Payload;
    } catch (err) {
      if (fallback) {
        fallback.classList.remove("hidden");
        fallback.textContent = `Failed to load /embeddings.json (${err}). ` +
          "Run: .venv/bin/python -m pipeline.cli.embed";
      }
      return;
    }
    render();
    svg?.addEventListener("mousemove", onMove);
    svg?.addEventListener("mouseleave", () => tooltip?.classList.add("hidden"));
    svg?.addEventListener("keydown", onKeydown);
    svg?.addEventListener("focusin", (e) => {
      const a = (e.target as Element | null)?.closest?.("a[data-id]") as SVGAElement | null;
      if (!a) return;
      setCurrent(a, false);
      // Ring + label only for keyboard focus; a mouse click on a dot just navigates.
      let kbd = true;
      try { kbd = a.matches(":focus-visible"); } catch { /* old browsers: always show */ }
      if (kbd) showFocusRing(a);
    });
    svg?.addEventListener("focusout", () => showFocusRing(null));
    [projSelect, cpSelect, tpSelect, alSelect].forEach((el) =>
      el?.addEventListener("change", render)
    );
    typeBoxes.forEach((b) => b.addEventListener("change", render));
    let rt: number | undefined;
    window.addEventListener("resize", () => { clearTimeout(rt); rt = window.setTimeout(render, 100); });
  }

  init();
</script>

<style is:global>
  /* Keyboard focus on map dots: a separate navy ring circle is drawn (see showFocusRing); the default
     outline on an SVG <a> is a loose rectangle, so it is suppressed here. */
  #ex-svg a:focus { outline: none; }
  #ex-svg a:focus-visible circle { fill-opacity: 1; }
</style>
