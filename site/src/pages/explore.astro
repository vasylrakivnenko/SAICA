---
// /explore — Interactive 2D projection of KG embeddings.
// Loads /embeddings.json at runtime and renders with raw SVG (no chart lib).
// Consistent with /graph: tool blue, failure_mode rose, taxonomy violet, paper slate.
import BaseLayout from "../layouts/BaseLayout.astro";
const title = "Explore";
---

<BaseLayout title={title}>
  <section class="mb-4">
    <h1>Explore embeddings</h1>
    <p class="text-sm text-ink-muted">
      Each dot is a KG node projected from a 384-dim sentence-transformer
      embedding down to 2D via UMAP. Nearby points share vocabulary — not
      necessarily facet labels. Hover to identify, click to open.
    </p>
  </section>

  <div class="grid grid-cols-[14rem_1fr] gap-4" id="explore-root">
    <aside class="ui text-sm">
      <div class="mb-4">
        <div class="text-xs font-semibold text-ink-faint uppercase tracking-wide mb-1">Projection</div>
        <select id="ex-proj" class="w-full border border-ink/15 rounded px-2 py-1 bg-white">
          <option value="combined" selected>combined (all types)</option>
          <option value="tool">tools only</option>
          <option value="failure_mode">failure modes only</option>
          <option value="taxonomy">taxonomies only</option>
          <option value="paper">papers only</option>
        </select>
      </div>

      <fieldset class="mb-4">
        <legend class="text-xs font-semibold text-ink-faint uppercase tracking-wide mb-1">Node types</legend>
        <label class="block"><input type="checkbox" data-type="tool" checked /> <span class="inline-block w-2 h-2 rounded-full align-middle" style="background:#2563eb"></span> Tools</label>
        <label class="block"><input type="checkbox" data-type="failure_mode" checked /> <span class="inline-block w-2 h-2 rounded-full align-middle" style="background:#e11d48"></span> Failure modes</label>
        <label class="block"><input type="checkbox" data-type="taxonomy" checked /> <span class="inline-block w-2 h-2 rounded-full align-middle" style="background:#7c3aed"></span> Taxonomies</label>
        <label class="block"><input type="checkbox" data-type="paper" checked /> <span class="inline-block w-2 h-2 rounded-full align-middle" style="background:#64748b"></span> Papers</label>
      </fieldset>

      <fieldset class="mb-4">
        <legend class="text-xs font-semibold text-ink-faint uppercase tracking-wide mb-1">Tool facets</legend>
        <label class="block text-xs text-ink-faint mt-1">control_paradigm</label>
        <select id="ex-cp" class="w-full border border-ink/15 rounded px-2 py-1 bg-white">
          <option value="">any</option>
          <option value="prevention">prevention</option>
          <option value="detection">detection</option>
          <option value="correction">correction</option>
          <option value="recovery">recovery</option>
        </select>
        <label class="block text-xs text-ink-faint mt-2">temporal_phase</label>
        <select id="ex-tp" class="w-full border border-ink/15 rounded px-2 py-1 bg-white">
          <option value="">any</option>
          <option value="pre_generation">pre_generation</option>
          <option value="in_generation">in_generation</option>
          <option value="post_generation">post_generation</option>
        </select>
        <label class="block text-xs text-ink-faint mt-2">autonomy_level</label>
        <select id="ex-al" class="w-full border border-ink/15 rounded px-2 py-1 bg-white">
          <option value="">any</option>
          <option value="fully_autonomous">fully_autonomous</option>
          <option value="graduated_hitl">graduated_hitl</option>
          <option value="full_hitl">full_hitl</option>
        </select>
      </fieldset>

      <div id="ex-count" class="text-xs text-ink-faint"></div>
    </aside>

    <div class="relative border border-ink/10 rounded bg-white" style="height:78vh">
      <noscript>
        <div class="p-3 text-sm">
          The embedding explorer requires JavaScript. You can still read the raw
          data at <a href="/embeddings.json">/embeddings.json</a>.
        </div>
      </noscript>
      <svg id="ex-svg" viewBox="0 0 100 100" preserveAspectRatio="none"
           style="width:100%; height:100%; display:block"></svg>
      <div id="ex-tooltip"
           class="pointer-events-none absolute hidden bg-ink text-white text-xs rounded px-2 py-1 shadow"
           style="transform: translate(-50%, -110%);"></div>
      <div id="ex-fallback" class="hidden absolute inset-0 p-6 text-sm bg-white"></div>
    </div>
  </div>
</BaseLayout>

<script>
  type Facet = { control_paradigm: string; temporal_phase: string; autonomy_level: string } | null;
  interface Row {
    id: string; name: string; type: string;
    x: number; y: number;
    top_similar_ids: string[];
    facet: Facet;
  }
  interface Payload {
    model: string; dim: number; count: number;
    by_type: Record<string, Row[]>;
    combined: Row[];
  }

  const COLORS: Record<string, string> = {
    tool: "#2563eb",
    failure_mode: "#e11d48",
    taxonomy: "#7c3aed",
    paper: "#64748b",
  };
  const NODE_URL: Record<string, (id: string) => string> = {
    tool: (id) => `/tools/${id}/`,
    failure_mode: (id) => `/failure-modes/${id}/`,
    taxonomy: (id) => `/taxonomies/${id}/`,
    paper: (id) => `/papers/${id}/`,
  };

  const svg = document.getElementById("ex-svg") as unknown as SVGSVGElement | null;
  const tooltip = document.getElementById("ex-tooltip") as HTMLDivElement | null;
  const fallback = document.getElementById("ex-fallback") as HTMLDivElement | null;
  const projSelect = document.getElementById("ex-proj") as HTMLSelectElement | null;
  const cpSelect = document.getElementById("ex-cp") as HTMLSelectElement | null;
  const tpSelect = document.getElementById("ex-tp") as HTMLSelectElement | null;
  const alSelect = document.getElementById("ex-al") as HTMLSelectElement | null;
  const countEl = document.getElementById("ex-count") as HTMLElement | null;
  const typeBoxes = Array.from(
    document.querySelectorAll<HTMLInputElement>("input[data-type]")
  );
  const svgNS = "http://www.w3.org/2000/svg";
  let payload: Payload | null = null;

  function visibleRows(): Row[] {
    if (!payload) return [];
    const mode = projSelect?.value ?? "combined";
    const base = mode === "combined" ? payload.combined : (payload.by_type[mode] ?? []);
    const activeTypes = new Set(
      typeBoxes.filter((b) => b.checked).map((b) => b.dataset.type as string)
    );
    const cp = cpSelect?.value ?? "";
    const tp = tpSelect?.value ?? "";
    const al = alSelect?.value ?? "";
    return base.filter((r) => {
      if (!activeTypes.has(r.type)) return false;
      if (r.type === "tool" && (cp || tp || al)) {
        if (!r.facet) return false;
        if (cp && r.facet.control_paradigm !== cp) return false;
        if (tp && r.facet.temporal_phase !== tp) return false;
        if (al && r.facet.autonomy_level !== al) return false;
      }
      return true;
    });
  }

  function render(): void {
    if (!svg) return;
    while (svg.firstChild) svg.removeChild(svg.firstChild);
    const rows = visibleRows();
    if (countEl) countEl.textContent = `${rows.length} nodes`;
    // Padding inside the 100x100 viewBox so dots don't clip at the edge.
    const PAD = 3;
    for (const r of rows) {
      const cx = PAD + r.x * (100 - 2 * PAD);
      const cy = PAD + (1 - r.y) * (100 - 2 * PAD); // flip y so "up" = larger
      const dot = document.createElementNS(svgNS, "circle");
      dot.setAttribute("cx", cx.toFixed(3));
      dot.setAttribute("cy", cy.toFixed(3));
      dot.setAttribute("r", r.type === "tool" ? "0.8" : "0.7");
      dot.setAttribute("fill", COLORS[r.type] ?? "#6b7280");
      dot.setAttribute("fill-opacity", "0.8");
      dot.setAttribute("stroke", "white");
      dot.setAttribute("stroke-width", "0.15");
      dot.style.cursor = "pointer";
      dot.dataset.id = r.id;
      dot.dataset.name = r.name;
      dot.dataset.type = r.type;
      svg.appendChild(dot);
    }
  }

  function onMove(e: MouseEvent): void {
    const target = e.target as Element | null;
    if (!target || target.tagName !== "circle" || !tooltip || !svg) {
      if (tooltip) tooltip.classList.add("hidden");
      return;
    }
    const rect = svg.getBoundingClientRect();
    const name = (target as SVGCircleElement).dataset.name ?? "";
    const id = (target as SVGCircleElement).dataset.id ?? "";
    tooltip.textContent = `${name} · ${id}`;
    tooltip.style.left = `${e.clientX - rect.left}px`;
    tooltip.style.top = `${e.clientY - rect.top}px`;
    tooltip.classList.remove("hidden");
  }

  function onClick(e: MouseEvent): void {
    const target = e.target as Element | null;
    if (!target || target.tagName !== "circle") return;
    const id = (target as SVGCircleElement).dataset.id;
    const type = (target as SVGCircleElement).dataset.type;
    if (!id || !type) return;
    const url = NODE_URL[type]?.(id);
    if (url) window.location.href = url;
  }

  async function init(): Promise<void> {
    try {
      const res = await fetch("/embeddings.json");
      if (!res.ok) throw new Error(`HTTP ${res.status}`);
      payload = (await res.json()) as Payload;
    } catch (err) {
      if (fallback) {
        fallback.classList.remove("hidden");
        fallback.textContent = `Failed to load /embeddings.json (${err}). ` +
          "Run: .venv/bin/python -m pipeline.cli.embed";
      }
      return;
    }
    render();
    svg?.addEventListener("mousemove", onMove);
    svg?.addEventListener("mouseleave", () => tooltip?.classList.add("hidden"));
    svg?.addEventListener("click", onClick);
    [projSelect, cpSelect, tpSelect, alSelect].forEach((el) =>
      el?.addEventListener("change", render)
    );
    typeBoxes.forEach((b) => b.addEventListener("change", render));
  }

  init();
</script>
