---
import BaseLayout from '../../layouts/BaseLayout.astro';
import InlineCode from '../../components/InlineCode.astro';
import { graph, failureModeLabel } from '../../lib/data.ts';
import { breadcrumbs, clip, fmUrl } from '../../lib/seo.ts';

// Newest incidents first.
const incidents = Object.values(graph.incidents)
  .slice()
  .sort((a, b) => b.incident_date.localeCompare(a.incident_date));
const description = clip(
  `${incidents.length} real incidents where AI coding agents caused harm (deleted databases, hallucinated packages, prompt injection, leaked secrets), by failure mode.`,
  155,
);
const jsonld = breadcrumbs([
  ['SAICA-Bench', '/'],
  ['Incidents', '/incidents/'],
]);
---

<BaseLayout title="AI coding agent incidents: real-world failures" description={description} jsonld={jsonld}>
  <h1>AI coding agent incidents</h1>
  <p class="text-ink-muted mt-2 max-w-3xl">
    {incidents.length} documented failure events where AI coding agents (or analogous
    systems) produced harm. Each incident is tagged with the <a href="/failure-modes/">failure modes</a> it exhibited
    and the <a href="/tools/">tools</a> whose supervision would plausibly prevent recurrence.
  </p>

  <ul class="mt-6 divide-y divide-ink/10 border-y border-ink/10">
    {incidents.map((inc) => (
      <li class="py-4">
        <div class="flex items-baseline justify-between gap-4">
          <h2 class="!mt-0 mb-2 text-lg">
            <a href={`/incidents/${inc.id}/`}>{inc.title}</a>
          </h2>
          <span class="font-sans text-xs text-ink-faint whitespace-nowrap">
            {inc.incident_date}
          </span>
        </div>
        {inc.tagline && <p class="mt-1 text-ink-muted"><InlineCode text={inc.tagline} /></p>}
        <div class="mt-2 flex flex-wrap gap-1.5">
          <span class="chip-accent" title="Harm class">{inc.harm_class.replace(/_/g, ' ')}</span>
          <span class="chip-accent" title="Reproducibility">{inc.reproducibility}</span>
          {inc.exhibited_failure_modes.map((fm) => (
            <a class="chip no-underline hover:text-accent" href={fmUrl(fm)} title="Failure mode">{failureModeLabel(fm)}</a>
          ))}
        </div>
      </li>
    ))}
  </ul>
</BaseLayout>
