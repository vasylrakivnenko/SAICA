---
// /tool-coverage: the kit builder. The measured coverage matrix (components/MeasuredMatrix.astro, kit.json "matrix") is
// hidden for now (user, 2026-11-20); re-add <MeasuredMatrix /> to bring it back. Data: /bench/kit.json, written by
// bench/kitbuilder/build_kit.py from the published results.
// The earlier declared-coverage heatmap (catalog tags, research/plot_tool_fm_heatmap.py) is in git history; its data file
// /tool_fm_heatmap.json is still published. Untested catalog tools are hidden here until they can be scored.
import BaseLayout from "../layouts/BaseLayout.astro";
import KitBuilder from "../components/KitBuilder.astro";
import { breadcrumbs } from "../lib/seo";
const title = "Build a Supervision Kit for Your AI Coding Agent";
// No score in the search snippet: a benchmark J describes the benchmark input, not the check a reader installs.
const description = "Pick the failure modes you care about; get a check that scored among the best on SAICA-Bench for each, what it sees at commit time, and one setup prompt for your AI coding agent.";
---

<BaseLayout title={title} description={description} jsonld={breadcrumbs([["SAICA-Bench", "/"], ["Supervision kit", "/tool-coverage/"]])}>
  <KitBuilder />
</BaseLayout>
