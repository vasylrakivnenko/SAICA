---
// /tool-coverage: measured coverage matrix (tools and models we ran on SAICA-Bench, J per failure mode, threshold slider)
// and the kit builder. Data: /bench/kit.json, written by bench/build_report.py.
// The earlier declared-coverage heatmap (catalog tags, research/plot_tool_fm_heatmap.py) is in git history; its data file
// /tool_fm_heatmap.json is still published. Untested catalog tools are hidden here until they can be scored.
import BaseLayout from "../layouts/BaseLayout.astro";
import MeasuredMatrix from "../components/MeasuredMatrix.astro";
import KitBuilder from "../components/KitBuilder.astro";
const title = "Coverage: measured tools by failure mode";
---

<BaseLayout title={title}>
  <MeasuredMatrix />
  <KitBuilder />
</BaseLayout>
