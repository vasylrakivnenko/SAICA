---
import BaseLayout from '../../layouts/BaseLayout.astro';
import RawYamlLink from '../../components/RawYamlLink.astro';
import { graph } from '../../lib/data.ts';
import { abs, breadcrumbs, clip, fmUrl, toolUrl } from '../../lib/seo.ts';
import { paperDuplicates } from '../../lib/catalog.ts';
import type { Paper } from '../../lib/types.ts';

export function getStaticPaths() {
  return Object.values(graph.papers).map((p) => ({
    params: { id: p.id },
    props: { paper: p },
  }));
}

interface Props { paper: Paper }
const { paper } = Astro.props;

// Ids that stand for this paper: itself plus any duplicate records of it (see paperDuplicates).
const ids = [paper.id, ...Object.keys(paperDuplicates).filter((d) => paperDuplicates[d] === paper.id)];
const cites = (list: string[]) => ids.some((id) => list.includes(id));
// Reverse-lookup: which FailureModes cite this paper in prior_work?
const citingFailureModes = Object.values(graph.failureModes).filter((fm) => cites(fm.prior_work));
// Which Taxonomies point to this paper via paper_id?
const citingTaxonomies = Object.values(graph.taxonomies).filter((t) => !!t.paper_id && ids.includes(t.paper_id));
// Which Tools point to this paper?
const citingTools = Object.values(graph.tools).filter(
  (t) => cites(t.cited_in) || cites(t.documented_in) || cites(t.evaluated_on),
);

const desc = clip(paper.tldr ?? paper.title, 155);
const pagePath = `/papers/${paper.id}/`;
// Same work recorded twice in the KG: keep the page (other pages link to it) but keep it out of search results.
const primary = paperDuplicates[paper.id] ? graph.papers[paperDuplicates[paper.id]] : undefined;
const sameAs = [
  paper.arxiv_id ? `https://arxiv.org/abs/${paper.arxiv_id}` : null,
  paper.doi ? `https://doi.org/${paper.doi}` : null,
  paper.semantic_scholar_id ? `https://www.semanticscholar.org/paper/${paper.semantic_scholar_id}` : null,
].filter((u): u is string => !!u && u !== paper.url);
const jsonld = [
  ...(primary
    ? []
    : [
        {
          '@context': 'https://schema.org',
          '@type': 'ScholarlyArticle',
          name: paper.title,
          headline: clip(paper.title, 110),
          ...(paper.authors.length ? { author: paper.authors.map((name) => ({ '@type': 'Person', name })) } : {}),
          ...(Number.isFinite(paper.year) ? { datePublished: String(paper.year) } : {}),
          description: desc,
          ...(paper.url ? { url: paper.url } : {}),
          ...(sameAs.length ? { sameAs } : {}),
          mainEntityOfPage: abs(pagePath),
        },
      ]),
  breadcrumbs([
    ['SAICA-Bench', '/'],
    ['Papers', '/papers/'],
    [clip(paper.title, 80), pagePath],
  ]),
];
---

<BaseLayout title={paper.title} description={desc} jsonld={jsonld} ogType="article" noindex={!!primary}>
  <p class="font-sans text-xs uppercase tracking-widest text-ink-faint">
    <a href="/papers/" class="no-underline hover:underline">Papers</a>
  </p>
  <h1 class="mt-1">{paper.title}</h1>
  {primary && (
    <p class="mt-2 rounded border border-ink/10 bg-paper-alt px-3 py-2 font-sans text-sm">
      Duplicate record of the same paper: see <a href={`/papers/${primary.id}/`}>{primary.title}</a>.
    </p>
  )}
  <p class="mt-2 text-ink-muted font-sans">
    {paper.authors.join(', ')} · {paper.year}{paper.venue && ` · ${paper.venue}`}
  </p>

  <div class="mt-3 flex flex-wrap gap-3 text-sm font-sans">
    {paper.url && <a class="chip" href={paper.url} rel="noopener">Source &rarr;</a>}
    {paper.arxiv_id && (
      <a class="chip" href={`https://arxiv.org/abs/${paper.arxiv_id}`} rel="noopener">
        arXiv:{paper.arxiv_id}
      </a>
    )}
    {paper.doi && (
      <a class="chip" href={`https://doi.org/${paper.doi}`} rel="noopener">DOI: {paper.doi}</a>
    )}
    {typeof paper.citation_count === 'number' && (
      <span class="chip">{paper.citation_count} citations</span>
    )}
  </div>

  {paper.relevance_tags.length > 0 && (
    <div class="mt-3 flex flex-wrap gap-1.5">
      {paper.relevance_tags.map((t) => <span class="chip">{t}</span>)}
    </div>
  )}

  {paper.tldr && (
    <>
      <h2>TL;DR</h2>
      <p class="whitespace-pre-line leading-7">{paper.tldr}</p>
    </>
  )}

  {paper.abstract && (
    <>
      <h2>Abstract</h2>
      <p class="whitespace-pre-line leading-7">{paper.abstract}</p>
    </>
  )}

  {paper.notes && (
    <>
      <h2>Editorial notes</h2>
      <p class="whitespace-pre-line leading-7 text-ink-muted">{paper.notes}</p>
    </>
  )}

  {(citingFailureModes.length > 0 || citingTaxonomies.length > 0 || citingTools.length > 0) && (
    <>
      <h2>Referenced from</h2>
      {citingFailureModes.length > 0 && (
        <>
          <h3>Failure modes</h3>
          <ul class="list-disc pl-5">
            {citingFailureModes.map((fm) => (
              <li><a href={fmUrl(fm.id)}>{fm.name}</a></li>
            ))}
          </ul>
        </>
      )}
      {citingTaxonomies.length > 0 && (
        <>
          <h3>Taxonomies</h3>
          <ul class="list-disc pl-5">
            {citingTaxonomies.map((t) => (
              <li><a href={`/taxonomies/${t.id}/`}>{t.name}</a></li>
            ))}
          </ul>
        </>
      )}
      {citingTools.length > 0 && (
        <>
          <h3>Tools</h3>
          <ul class="list-disc pl-5">
            {citingTools.map((t) => (
              <li><a href={toolUrl(t.id)}>{t.name}</a></li>
            ))}
          </ul>
        </>
      )}
    </>
  )}

  <RawYamlLink kind="papers" id={paper.id} />
</BaseLayout>
