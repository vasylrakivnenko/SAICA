---
import BaseLayout from '../../layouts/BaseLayout.astro';
import RawYamlLink from '../../components/RawYamlLink.astro';
import { graph } from '../../lib/data.ts';
import type { Taxonomy } from '../../lib/types.ts';

export function getStaticPaths() {
  return Object.values(graph.taxonomies).map((t) => ({
    params: { id: t.id },
    props: { taxonomy: t },
  }));
}

interface Props { taxonomy: Taxonomy }
const { taxonomy } = Astro.props;

const byCategory = graph.failureModesByTaxonomyCategory[taxonomy.id] ?? {};
const paper = taxonomy.paper_id ? graph.papers[taxonomy.paper_id] : undefined;
const desc = taxonomy.scope ?? `External taxonomy: ${taxonomy.name}.`;
---

<BaseLayout title={taxonomy.name} description={desc.slice(0, 160)}>
  <p class="font-sans text-xs uppercase tracking-widest text-ink-faint">
    <a href="/taxonomies" class="no-underline hover:underline">Taxonomies</a>
  </p>
  <h1 class="mt-1">{taxonomy.name}</h1>
  <p class="mt-2 text-ink-muted font-sans text-sm">
    {taxonomy.owner} · v{taxonomy.version}
    {taxonomy.first_published && ` · first published ${taxonomy.first_published}`}
  </p>

  {taxonomy.scope && (
    <>
      <h2>Scope</h2>
      <p class="whitespace-pre-line leading-7">{taxonomy.scope}</p>
    </>
  )}

  <div class="mt-4 flex flex-wrap gap-3 text-sm font-sans">
    {taxonomy.url && (
      <a class="chip" href={taxonomy.url} rel="noopener">Source &rarr;</a>
    )}
    {taxonomy.license && <span class="chip">License: {taxonomy.license}</span>}
    {paper && (
      <a class="chip" href={`/papers/${paper.id}`}>Paper &rarr;</a>
    )}
  </div>

  {taxonomy.inclusion_rationale && (
    <>
      <h2>Why it's ingested</h2>
      <p class="whitespace-pre-line leading-7">{taxonomy.inclusion_rationale}</p>
    </>
  )}

  <h2>Categories &amp; crosswalks</h2>
  <p class="text-sm text-ink-muted">
    Each row lists one external category and any SAICA-KG FailureModes that cross-walk
    into it.
  </p>
  <ul class="mt-3 space-y-3">
    {taxonomy.categories.map((cat) => {
      const fmIds = byCategory[cat.external_id] ?? [];
      return (
        <li class="card">
          <div class="flex flex-wrap items-baseline gap-x-3 gap-y-1">
            <code class="font-sans text-sm font-semibold">{cat.external_id}</code>
            <span class="font-sans font-semibold">{cat.label}</span>
          </div>
          {cat.description && <p class="mt-2 text-sm leading-6">{cat.description}</p>}
          {fmIds.length > 0 && (
            <div class="mt-3 text-sm">
              <span class="font-sans text-xs uppercase tracking-wide text-ink-faint">SAICA-KG crosswalks:</span>
              <ul class="mt-1 flex flex-wrap gap-1.5">
                {fmIds.map((fmId) => (
                  <li>
                    <a class="chip-accent" href={`/failure-modes/${fmId}`}>
                      {graph.failureModes[fmId]?.name ?? fmId}
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          )}
        </li>
      );
    })}
  </ul>

  {taxonomy.notes && (
    <>
      <h2>Notes</h2>
      <p class="whitespace-pre-line text-sm text-ink-muted">{taxonomy.notes}</p>
    </>
  )}

  <RawYamlLink kind="taxonomies" id={taxonomy.id} />
</BaseLayout>
