        <a href="/graph"><strong>Graph</strong></a>
      </nav>

      <section class="kg-wrap">
        <noscript>
          <div style="padding:12px;background:#fef9c3;border:1px solid #fde68a;border-radius:4px;margin-bottom:8px;font-size:14px">
            The interactive graph requires JavaScript. You can still view the
