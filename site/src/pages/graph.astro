          </div>
        </noscript>

        <div class="kg-toolbar">
          <h1>Knowledge Graph</h1>
          <input id="kg-search" type="search" placeholder="Search name or id…" style="flex:1;min-width:180px;max-width:320px" aria-label="Search nodes" />
          <select id="kg-layout" aria-label="Layout algorithm">
            <option value="cose" selected>cose (force-directed)</option>
            <option value="grid">grid</option>
            <option value="circle">circle</option>
            <option value="breadthfirst">breadthfirst</option>
          </select>
          <button id="kg-reset" type="button">Reset view</button>
          <button id="kg-filters-toggle" type="button" aria-expanded="false" aria-controls="kg-filters-drawer">Filters</button>
          <button id="kg-legend-toggle" type="button" aria-expanded="false" aria-controls="kg-legend-popover">Legend</button>
        </div>

        <div class="kg-canvas">
          <div id="cy" style="width:100%;height:100%"></div>
          <div id="kg-fallback" class="hidden"
               style="position:absolute;inset:0;padding:24px;background:#fff;font-size:14px"></div>

          <aside id="kg-filters-drawer" class="kg-drawer hidden" aria-hidden="true" aria-label="Graph filters" role="dialog" aria-modal="false">
            <div class="kg-drawer-head">
              <span class="title">Filters</span>
              <button id="kg-filters-close" class="kg-close" type="button" aria-label="Close filters">×</button>
            </div>
            <div id="kg-filters" class="kg-drawer-body">
              <fieldset>
                <legend>Node types</legend>
                <label><input type="checkbox" name="type-tool" checked /> Tools</label>
                <label><input type="checkbox" name="type-failure_mode" checked /> Failure modes</label>
                <label><input type="checkbox" name="type-taxonomy" checked /> Taxonomies</label>
                <label><input type="checkbox" name="type-paper" /> Papers</label>
              </fieldset>
              <fieldset>
                <legend>Edge types</legend>
                <label><input type="checkbox" name="edge-addresses" checked /> addresses</label>
                <label><input type="checkbox" name="edge-composes_with" checked /> composes_with</label>
                <label><input type="checkbox" name="edge-feeds_into" checked /> feeds_into</label>
                <label><input type="checkbox" name="edge-supersedes" checked /> supersedes</label>
                <label><input type="checkbox" name="edge-crosswalks" checked /> crosswalks</label>
