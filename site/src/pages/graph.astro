<script>
  import { mountKGGraph } from "../components/KGGraph.ts";

  const container = document.getElementById("cy") as HTMLElement | null;
  const sidebar = document.getElementById("kg-sidebar") as HTMLElement | null;
  const sidebarCard = document.getElementById("kg-sidebar-card") as HTMLElement | null;
  const sidebarClose = document.getElementById("kg-sidebar-close") as HTMLButtonElement | null;
  const filters = document.getElementById("kg-filters") as HTMLElement | null;
  const filtersDrawer = document.getElementById("kg-filters-drawer") as HTMLElement | null;
  const filtersToggle = document.getElementById("kg-filters-toggle") as HTMLButtonElement | null;
  const filtersClose = document.getElementById("kg-filters-close") as HTMLButtonElement | null;
  const legendPopover = document.getElementById("kg-legend-popover") as HTMLElement | null;
  const legendToggle = document.getElementById("kg-legend-toggle") as HTMLButtonElement | null;
  const legendClose = document.getElementById("kg-legend-close") as HTMLButtonElement | null;
  const layoutSelect = document.getElementById("kg-layout") as HTMLSelectElement | null;
  const resetBtn = document.getElementById("kg-reset") as HTMLButtonElement | null;
  const search = document.getElementById("kg-search") as HTMLInputElement | null;

  // ----- UI: drawer + popover toggles -----
  const FOCUSABLE = 'a[href], button:not([disabled]), input:not([disabled]), select:not([disabled]), textarea:not([disabled]), [tabindex]:not([tabindex="-1"])';

  let lastFocus: HTMLElement | null = null;
  let trapHandler: ((e: KeyboardEvent) => void) | null = null;

  function trapFocus(root: HTMLElement): void {
    const focusables = Array.from(root.querySelectorAll<HTMLElement>(FOCUSABLE))
      .filter((el) => el.offsetParent !== null);
    if (focusables.length === 0) return;
    const first = focusables[0];
    const last = focusables[focusables.length - 1];
    trapHandler = (e: KeyboardEvent) => {
      if (e.key !== "Tab") return;
      if (e.shiftKey && document.activeElement === first) {
        e.preventDefault(); last.focus();
      } else if (!e.shiftKey && document.activeElement === last) {
        e.preventDefault(); first.focus();
      }
    };
    root.addEventListener("keydown", trapHandler as EventListener);
  }
  function releaseFocus(root: HTMLElement): void {
    if (trapHandler) {
      root.removeEventListener("keydown", trapHandler as EventListener);
      trapHandler = null;
    }
  }

  function setFiltersOpen(open: boolean): void {
    if (!filtersDrawer || !filtersToggle) return;
    filtersDrawer.classList.toggle("hidden", !open);
    filtersDrawer.setAttribute("aria-hidden", open ? "false" : "true");
    filtersToggle.setAttribute("aria-expanded", open ? "true" : "false");
    document.body.setAttribute("data-panel-open", open ? "filters" : "");
    if (open) {
      lastFocus = document.activeElement as HTMLElement | null;
      const firstInput = filtersDrawer.querySelector<HTMLElement>(FOCUSABLE);
      firstInput?.focus();
      trapFocus(filtersDrawer);
    } else {
      releaseFocus(filtersDrawer);
      lastFocus?.focus?.();
    }
  }

  function setLegendOpen(open: boolean): void {
    if (!legendPopover || !legendToggle) return;
    legendPopover.classList.toggle("hidden", !open);
    legendPopover.setAttribute("aria-hidden", open ? "false" : "true");
    legendToggle.setAttribute("aria-expanded", open ? "true" : "false");
    if (open) {
      legendClose?.focus();
    }
  }

  function setSidebarOpen(open: boolean): void {
    if (!sidebarCard) return;
    sidebarCard.classList.toggle("hidden", !open);
    sidebarCard.setAttribute("aria-hidden", open ? "false" : "true");
  }

  filtersToggle?.addEventListener("click", () => {
    const open = filtersDrawer?.classList.contains("hidden");
    setFiltersOpen(!!open);
  });
  filtersClose?.addEventListener("click", () => setFiltersOpen(false));

  legendToggle?.addEventListener("click", () => {
    const open = legendPopover?.classList.contains("hidden");
    setLegendOpen(!!open);
  });
  legendClose?.addEventListener("click", () => setLegendOpen(false));

  sidebarClose?.addEventListener("click", () => setSidebarOpen(false));

  document.addEventListener("keydown", (e) => {
    if (e.key !== "Escape") return;
    if (filtersDrawer && !filtersDrawer.classList.contains("hidden")) {
      setFiltersOpen(false);
    } else if (legendPopover && !legendPopover.classList.contains("hidden")) {
      setLegendOpen(false);
    } else if (sidebarCard && !sidebarCard.classList.contains("hidden")) {
      setSidebarOpen(false);
    }
  });

  // When KGGraph.ts writes into #kg-sidebar (on node click), auto-open the
  // floating details card. Empty state (initial/deselect) keeps it hidden.
  if (sidebar && sidebarCard) {
    const mo = new MutationObserver(() => {
      const hasContent = sidebar.querySelector("a, div > strong, [style*='font-size:18px']") !== null
        || (sidebar.textContent?.trim().length ?? 0) > 0;
      const isEmptyHint = sidebar.textContent?.includes("Click a node to see details");
      setSidebarOpen(!!hasContent && !isEmptyHint);
    });
    mo.observe(sidebar, { childList: true, subtree: true, characterData: true });
  }

  if (container && sidebar && filters && layoutSelect && resetBtn && search) {
    const params = new URLSearchParams(window.location.search);
    const focusNodeId = params.get("node");
    mountKGGraph({
      container,
      sidebar,
      filters,
      layoutSelect,
      resetBtn,
      search,
      focusNodeId,
    }).catch((err) => {
      const fb = document.getElementById("kg-fallback");
      if (fb) {
        (fb as HTMLElement).style.display = "block";
        fb.classList.remove("hidden");
        fb.innerHTML =
          `<p>Failed to initialize graph: ${String(err).replace(/</g, "&lt;")}.</p>` +
          `<p>See <a href="/api/v1/snapshot.json">/api/v1/snapshot.json</a>.</p>`;
      }
    });
  }
</script>
