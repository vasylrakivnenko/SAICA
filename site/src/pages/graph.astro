          padding: 8px 10px; border-bottom: 1px solid #e5e7eb; position: sticky; top: 0; background: #fff; }
        .kg-card-head .title { font-size: 11px; font-weight: 600; color: #4b5563; }
        .hidden { display: none !important; }
      </style>
