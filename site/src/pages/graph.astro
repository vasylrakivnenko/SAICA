---
// /graph — Interactive Cytoscape.js knowledge-graph visualization for SAICA-KG.
// Fetches /api/v1/snapshot.json at runtime; no data loaded at build time.
// Attempts to use site's BaseLayout if present; otherwise falls back to a
// minimal self-contained shell so the page builds independently.

let Layout: any = null;
try {
  Layout = (await import("../layouts/BaseLayout.astro")).default;
} catch {
  try {
    Layout = (await import("../layouts/Layout.astro")).default;
  } catch {
    Layout = null;
  }
}

const title = "Knowledge Graph — SAICA-KG";
---

{Layout ? (
  <Layout title={title}>
    <section class="px-3 py-2">
      <noscript>
        <div class="p-3 bg-yellow-50 border border-yellow-200 rounded mb-2 text-sm">
          The interactive graph requires JavaScript. You can still view the raw
          data at <a href="/api/v1/snapshot.json">/api/v1/snapshot.json</a>.
        </div>
      </noscript>

      {/* Toolbar: thin horizontal bar above the canvas */}
      <div class="flex flex-wrap items-center gap-2 mb-2 p-2 bg-white border border-gray-200 rounded">
        <h1 class="text-base font-semibold text-gray-800 mr-2">Knowledge Graph</h1>

        <input id="kg-search" type="search" placeholder="Search name or id…"
               class="flex-1 min-w-[180px] max-w-xs border border-gray-300 rounded px-2 py-1 text-sm"
               aria-label="Search nodes" />

        <label for="kg-layout" class="sr-only">Layout</label>
        <select id="kg-layout"
                class="border border-gray-300 rounded px-2 py-1 text-sm"
                aria-label="Layout algorithm">
          <option value="cose" selected>cose (force-directed)</option>
          <option value="grid">grid</option>
          <option value="circle">circle</option>
          <option value="breadthfirst">breadthfirst</option>
        </select>

        <button id="kg-reset" type="button"
                class="border border-gray-300 rounded px-2 py-1 text-sm hover:bg-gray-50">
          Reset view
        </button>

        <button id="kg-filters-toggle" type="button"
                aria-expanded="false" aria-controls="kg-filters-drawer"
                class="border border-gray-300 rounded px-2 py-1 text-sm hover:bg-gray-50">
          Filters
        </button>

        <button id="kg-legend-toggle" type="button"
                aria-expanded="false" aria-controls="kg-legend-popover"
                class="border border-gray-300 rounded px-2 py-1 text-sm hover:bg-gray-50">
          Legend
        </button>
      </div>

      {/* Canvas region: full width, ~88vh tall */}
      <div class="relative border border-gray-200 rounded bg-white overflow-hidden"
           style="height:88vh">
        <div id="cy" style="width:100%; height:100%;"></div>
        <div id="kg-fallback" class="hidden absolute inset-0 p-6 bg-white text-sm"></div>

        {/* Filters drawer — overlay from left, starts hidden */}
        <aside id="kg-filters-drawer"
               class="hidden absolute top-0 left-0 h-full w-72 bg-white border-r border-gray-200 shadow-lg overflow-y-auto z-20"
               aria-hidden="true" aria-label="Graph filters" role="dialog" aria-modal="false">
          <div class="flex items-center justify-between p-3 border-b border-gray-200 sticky top-0 bg-white">
            <div class="text-sm font-semibold text-gray-700">Filters</div>
            <button id="kg-filters-close" type="button" aria-label="Close filters"
                    class="text-gray-500 hover:text-gray-800 text-lg leading-none px-2">×</button>
          </div>
          <div id="kg-filters" class="p-3 text-sm">
            <fieldset class="mb-3">
              <legend class="text-xs font-semibold text-gray-600 mb-1">Node types</legend>
              <label class="block"><input type="checkbox" name="type-tool" checked /> Tools</label>
              <label class="block"><input type="checkbox" name="type-failure_mode" checked /> Failure modes</label>
              <label class="block"><input type="checkbox" name="type-taxonomy" checked /> Taxonomies</label>
              <label class="block"><input type="checkbox" name="type-paper" /> Papers</label>
            </fieldset>

            <fieldset class="mb-3">
              <legend class="text-xs font-semibold text-gray-600 mb-1">Edge types</legend>
              <label class="block"><input type="checkbox" name="edge-addresses" checked /> addresses</label>
              <label class="block"><input type="checkbox" name="edge-composes_with" checked /> composes_with</label>
              <label class="block"><input type="checkbox" name="edge-feeds_into" checked /> feeds_into</label>
              <label class="block"><input type="checkbox" name="edge-supersedes" checked /> supersedes</label>
              <label class="block"><input type="checkbox" name="edge-crosswalks" checked /> crosswalks</label>
              <label class="block"><input type="checkbox" name="edge-prior_work" /> prior_work</label>
              <label class="block"><input type="checkbox" name="edge-cited_in" /> cited_in</label>
            </fieldset>

            <fieldset class="mb-3">
              <legend class="text-xs font-semibold text-gray-600 mb-1">Tool facets</legend>
              <label class="block text-xs text-gray-600 mt-1">control_paradigm</label>
              <select name="control_paradigm" class="w-full border border-gray-300 rounded px-2 py-1">
                <option value="">any</option>
                <option value="prevention">prevention</option>
                <option value="detection">detection</option>
                <option value="correction">correction</option>
                <option value="observation">observation</option>
              </select>

              <label class="block text-xs text-gray-600 mt-2">temporal_phase</label>
              <select name="temporal_phase" class="w-full border border-gray-300 rounded px-2 py-1">
                <option value="">any</option>
                <option value="pre_generation">pre_generation</option>
                <option value="inline">inline</option>
                <option value="post_generation">post_generation</option>
                <option value="runtime">runtime</option>
              </select>

              <label class="block text-xs text-gray-600 mt-2">autonomy_level</label>
              <select name="autonomy_level" class="w-full border border-gray-300 rounded px-2 py-1">
                <option value="">any</option>
                <option value="human_in_loop">human_in_loop</option>
                <option value="graduated_hitl">graduated_hitl</option>
                <option value="autonomous">autonomous</option>
                <option value="supervised">supervised</option>
              </select>
            </fieldset>
          </div>
        </aside>

        {/* Legend popover — floats near the Legend button, starts hidden */}
        <div id="kg-legend-popover"
             class="hidden absolute top-2 right-2 w-64 bg-white/95 backdrop-blur border border-gray-200 rounded shadow-lg p-3 text-xs z-20"
             aria-hidden="true" role="dialog" aria-label="Graph legend">
          <div class="flex items-center justify-between mb-2">
            <div class="font-semibold text-gray-700">Legend</div>
            <button id="kg-legend-close" type="button" aria-label="Close legend"
                    class="text-gray-500 hover:text-gray-800 text-base leading-none px-1">×</button>
          </div>
          <div class="flex items-center gap-2 mb-1">
            <span style="display:inline-block;width:14px;height:10px;background:#2563eb;border-radius:2px"></span> Tool (rounded)
          </div>
          <div class="flex items-center gap-2 mb-1">
            <span style="display:inline-block;width:12px;height:12px;background:#dc2626;transform:rotate(45deg)"></span> Failure mode (diamond)
          </div>
          <div class="flex items-center gap-2 mb-1">
            <span style="display:inline-block;width:12px;height:12px;background:#7c3aed;clip-path:polygon(25% 0,75% 0,100% 50%,75% 100%,25% 100%,0 50%)"></span> Taxonomy (hex)
          </div>
          <div class="flex items-center gap-2 mb-2">
            <span style="display:inline-block;width:10px;height:10px;background:#6b7280;border-radius:50%"></span> Paper
          </div>
          <div class="text-gray-600">Tool border = control_paradigm</div>
          <div class="mt-2 text-gray-600">Edges:</div>
          <div>— solid red: addresses</div>
          <div>— dashed blue: composes_with</div>
          <div>— solid blue: feeds_into</div>
          <div>— dotted teal: supersedes</div>
          <div>— purple: crosswalks</div>
          <div>— dashed gray: prior_work</div>
          <div>— dotted gray: cited_in</div>
        </div>

        {/* Node-detail floating card — shown when a node is clicked */}
        <aside id="kg-sidebar-card"
               class="hidden absolute top-2 right-2 w-80 max-h-[calc(88vh-1rem)] overflow-y-auto bg-white border border-gray-200 rounded shadow-lg z-10"
               aria-hidden="true" aria-label="Node details">
          <div class="flex items-center justify-between p-2 border-b border-gray-200 sticky top-0 bg-white">
            <div class="text-xs font-semibold text-gray-600">Details</div>
            <button id="kg-sidebar-close" type="button" aria-label="Close details"
                    class="text-gray-500 hover:text-gray-800 text-lg leading-none px-2">×</button>
          </div>
          <div id="kg-sidebar"></div>
        </aside>
      </div>
    </section>
  </Layout>
) : (
  <html lang="en">
    <head>
      <meta charset="utf-8" />
      <meta name="viewport" content="width=device-width, initial-scale=1" />
      <title>{title}</title>
      <style is:global>
        body { margin: 0; font-family: ui-sans-serif, system-ui, sans-serif; color: #111827; background: #f9fafb; }
        a { color: #2563eb; }
        .kg-nav { padding: 10px 16px; border-bottom: 1px solid #e5e7eb; background: #fff; }
        .kg-nav a { margin-right: 16px; text-decoration: none; }
        .kg-wrap { padding: 8px 12px; }
        .kg-toolbar { display: flex; flex-wrap: wrap; align-items: center; gap: 8px; padding: 8px; background: #fff; border: 1px solid #e5e7eb; border-radius: 6px; margin-bottom: 8px; }
        .kg-toolbar h1 { font-size: 15px; font-weight: 600; margin: 0 8px 0 0; }
        .kg-toolbar input, .kg-toolbar select, .kg-toolbar button {
          border: 1px solid #d1d5db; border-radius: 4px; padding: 4px 8px; font-size: 14px; background: #fff;
        }
        .kg-toolbar button { cursor: pointer; }
        .kg-toolbar button:hover { background: #f3f4f6; }
        .kg-canvas { position: relative; height: 88vh; border: 1px solid #e5e7eb; border-radius: 6px; background: #fff; overflow: hidden; }
        .kg-drawer {
          position: absolute; top: 0; left: 0; height: 100%; width: 288px;
          background: #fff; border-right: 1px solid #e5e7eb;
          box-shadow: 2px 0 8px rgba(0,0,0,0.08); overflow-y: auto; z-index: 20;
        }
        .kg-drawer-head { display: flex; align-items: center; justify-content: space-between;
          padding: 10px 12px; border-bottom: 1px solid #e5e7eb; position: sticky; top: 0; background: #fff; }
        .kg-drawer-head .title { font-size: 14px; font-weight: 600; color: #374151; }
        .kg-close { background: none; border: 0; font-size: 18px; line-height: 1; color: #6b7280; cursor: pointer; padding: 0 6px; }
        .kg-close:hover { color: #111827; }
        .kg-drawer-body { padding: 12px; font-size: 14px; }
        .kg-drawer-body fieldset { border: 0; padding: 0; margin: 0 0 12px 0; }
