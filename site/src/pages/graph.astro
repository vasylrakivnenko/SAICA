            </div>
            <div style="display:flex;align-items:center;gap:8px;margin-bottom:4px">
              <span style="display:inline-block;width:14px;height:10px;background:#2563eb;border-radius:2px"></span> Tool (rounded)
            </div>
            <div style="display:flex;align-items:center;gap:8px;margin-bottom:4px">
              <span style="display:inline-block;width:12px;height:12px;background:#dc2626;transform:rotate(45deg)"></span> Failure mode
