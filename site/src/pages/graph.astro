---
// /graph — Interactive Cytoscape.js knowledge-graph visualization for SAICA-KG.
// The page script fetches /api/v1/graph.json at runtime (the slice of the graph it draws; lib/graph-data.ts);
// at build time the same data gives the counts in the meta description.
import BaseLayout from "../layouts/BaseLayout.astro";
import { graphData } from "../lib/graph-data.ts";
import { breadcrumbs } from "../lib/seo";

const g = graphData();
const n = {
  failure_modes: Object.keys(g.nodes.failure_modes).length,
  tools: Object.keys(g.nodes.tools).length,
  taxonomies: Object.keys(g.nodes.taxonomies).length,
  papers: Object.keys(g.nodes.papers).length,
};
const title = "Knowledge graph of AI coding agent failures and tools";
const description = `Interactive knowledge graph linking ${n.failure_modes} AI coding agent failure modes to the ${n.tools} supervision tools that address them, plus ${n.taxonomies} taxonomies and the ${n.papers} papers they cite.`;
const jsonld = breadcrumbs([
  ["SAICA-Bench", "/"],
  ["Knowledge graph", "/graph/"],
]);
---

<BaseLayout title={title} description={description} jsonld={jsonld}>
  <section>
    <h1>Knowledge graph of AI coding agent failures and tools</h1>
    <p class="mt-1 mb-3 max-w-3xl text-sm text-ink-muted">
      Every <a href="/failure-modes/">AI coding agent failure mode</a> (red diamonds) and the
      <a href="/tools/">supervision tools</a> that address it (blue), with the external
      <a href="/taxonomies/">failure taxonomies</a> that map onto them (purple) and, when switched on in Filters,
      the <a href="/papers/">research papers</a> behind them. Edges show which tool addresses which failure, how tools
      compose or feed into each other, and how other taxonomies crosswalk to ours. Click a node for details and a link
      to its page. With a keyboard, Tab into the graph, move between nodes with the arrow keys and press Enter for
      details; a <a href="#kg-node-list-wrap">plain list of all nodes</a> is below the graph.
    </p>
    <noscript>
      <div class="p-3 bg-yellow-50 border border-yellow-200 rounded mb-2 text-sm">
        The interactive graph requires JavaScript. You can still view the raw
        data at <a href="/api/v1/snapshot.json">/api/v1/snapshot.json</a>.
      </div>
    </noscript>

    {/* Toolbar: thin horizontal bar above the canvas */}
    <div class="flex flex-wrap items-center gap-2 mb-2 p-2 bg-white border border-gray-200 rounded">
      <input id="kg-search" type="search" placeholder="Search name or id…"
             class="flex-1 min-w-[180px] max-w-xs border border-gray-300 rounded px-2 py-1 text-sm"
             aria-label="Search nodes" />

      <label for="kg-layout" class="sr-only">Layout</label>
      <select id="kg-layout"
              class="border border-gray-300 rounded px-2 py-1 text-sm"
              aria-label="Layout algorithm">
        <option value="cose" selected>cose (force-directed)</option>
        <option value="grid">grid</option>
        <option value="circle">circle</option>
        <option value="breadthfirst">breadthfirst</option>
      </select>

      <button id="kg-reset" type="button"
              class="border border-gray-300 rounded px-2 py-1 text-sm hover:bg-gray-50">
        Reset view
      </button>

      <button id="kg-filters-toggle" type="button"
              aria-expanded="false" aria-controls="kg-filters-drawer"
              class="border border-gray-300 rounded px-2 py-1 text-sm hover:bg-gray-50">
        Filters
      </button>

      <button id="kg-legend-toggle" type="button"
              aria-expanded="false" aria-controls="kg-legend-popover"
              class="border border-gray-300 rounded px-2 py-1 text-sm hover:bg-gray-50">
        Legend
      </button>
    </div>

    {/* Canvas region: full width, ~88vh tall */}
    <div class="relative border border-gray-200 rounded bg-white overflow-hidden"
         style="height:88vh">
      <div id="cy" style="width:100%; height:100%;"></div>
      <div id="kg-fallback" class="hidden absolute inset-0 p-6 bg-white text-sm"></div>

      {/* Filters drawer — overlay from left, starts hidden */}
      <aside id="kg-filters-drawer"
             class="ui hidden absolute top-0 left-0 h-full w-72 bg-white border-r border-gray-200 shadow-lg overflow-y-auto z-20"
             aria-hidden="true" aria-label="Graph filters" role="dialog" aria-modal="false">
        <div class="flex items-center justify-between p-3 border-b border-gray-200 sticky top-0 bg-white">
          <div class="text-sm font-semibold text-gray-700">Filters</div>
          <button id="kg-filters-close" type="button" aria-label="Close filters"
                  class="text-gray-500 hover:text-gray-800 text-lg leading-none px-2">×</button>
        </div>
        <div id="kg-filters" class="p-3 text-sm">
          <fieldset class="mb-3">
            <legend class="text-xs font-semibold text-gray-600 mb-1">Node types</legend>
            <label class="block"><input type="checkbox" name="type-tool" checked /> Tools</label>
            <label class="block"><input type="checkbox" name="type-failure_mode" checked /> Failure modes</label>
            <label class="block"><input type="checkbox" name="type-taxonomy" checked /> Taxonomies</label>
            <label class="block"><input type="checkbox" name="type-paper" /> Papers</label>
          </fieldset>

          <fieldset class="mb-3">
            <legend class="text-xs font-semibold text-gray-600 mb-1">Edge types</legend>
            <label class="block"><input type="checkbox" name="edge-addresses" checked /> addresses</label>
            <label class="block"><input type="checkbox" name="edge-composes_with" checked /> composes_with</label>
            <label class="block"><input type="checkbox" name="edge-feeds_into" checked /> feeds_into</label>
            <label class="block"><input type="checkbox" name="edge-supersedes" checked /> supersedes</label>
            <label class="block"><input type="checkbox" name="edge-crosswalks" checked /> crosswalks</label>
            <label class="block"><input type="checkbox" name="edge-prior_work" /> prior_work</label>
            <label class="block"><input type="checkbox" name="edge-cited_in" /> cited_in</label>
          </fieldset>

          <fieldset class="mb-3">
            <legend class="text-xs font-semibold text-gray-600 mb-1">Tool facets</legend>
            <label for="kg-f-cp" class="block text-xs text-gray-600 mt-1">control_paradigm</label>
            <select id="kg-f-cp" name="control_paradigm" class="w-full border border-gray-300 rounded px-2 py-1">
              <option value="">any</option>
              <option value="prevention">prevention</option>
              <option value="detection">detection</option>
              <option value="correction">correction</option>
              <option value="recovery">recovery</option>
            </select>

            <label for="kg-f-tp" class="block text-xs text-gray-600 mt-2">temporal_phase</label>
            <select id="kg-f-tp" name="temporal_phase" class="w-full border border-gray-300 rounded px-2 py-1">
              <option value="">any</option>
              <option value="pre_generation">pre_generation</option>
              <option value="in_generation">in_generation</option>
              <option value="post_generation">post_generation</option>
            </select>

            <label for="kg-f-al" class="block text-xs text-gray-600 mt-2">autonomy_level</label>
            <select id="kg-f-al" name="autonomy_level" class="w-full border border-gray-300 rounded px-2 py-1">
              <option value="">any</option>
              <option value="fully_autonomous">fully_autonomous</option>
              <option value="graduated_hitl">graduated_hitl</option>
              <option value="full_hitl">full_hitl</option>
            </select>
          </fieldset>
        </div>
      </aside>

      {/* Legend popover — floats near the Legend button, starts hidden */}
      <div id="kg-legend-popover"
           class="ui hidden absolute top-2 right-2 w-64 bg-white/95 backdrop-blur border border-gray-200 rounded shadow-lg p-3 text-xs z-20"
           aria-hidden="true" role="dialog" aria-label="Graph legend">
        <div class="flex items-center justify-between mb-2">
          <div class="font-semibold text-gray-700">Legend</div>
          <button id="kg-legend-close" type="button" aria-label="Close legend"
                  class="text-gray-500 hover:text-gray-800 text-base leading-none px-1">×</button>
        </div>
        <div class="flex items-center gap-2 mb-1">
          <span style="display:inline-block;width:14px;height:10px;background:#2563eb;border-radius:2px"></span> Tool (rounded)
        </div>
        <div class="flex items-center gap-2 mb-1">
          <span style="display:inline-block;width:12px;height:12px;background:#dc2626;transform:rotate(45deg)"></span> Failure mode (diamond)
        </div>
        <div class="flex items-center gap-2 mb-1">
          <span style="display:inline-block;width:12px;height:12px;background:#7c3aed;clip-path:polygon(25% 0,75% 0,100% 50%,75% 100%,25% 100%,0 50%)"></span> Taxonomy (hex)
        </div>
        <div class="flex items-center gap-2 mb-2">
          <span style="display:inline-block;width:10px;height:10px;background:#6b7280;border-radius:50%"></span> Paper
        </div>
        <div class="text-gray-600">Tool border = control_paradigm</div>
        <div class="mt-2 text-gray-600">Edges:</div>
        <div>— solid red: addresses</div>
        <div>— dashed blue: composes_with</div>
        <div>— solid blue: feeds_into</div>
        <div>— dotted teal: supersedes</div>
        <div>— purple: crosswalks (label: the strongest mapping; “+2” = two more categories)</div>
        <div>— dashed gray: prior_work</div>
        <div>— dotted gray: cited_in</div>
      </div>

      {/* Node-detail floating card — shown when a node is clicked */}
      <aside id="kg-sidebar-card"
             class="ui hidden absolute top-2 right-2 w-80 max-w-[calc(100%-1rem)] max-h-[calc(88vh-1rem)] overflow-y-auto bg-white border border-gray-200 rounded shadow-lg z-10"
             aria-hidden="true" aria-label="Node details">
        <div class="flex items-center justify-between p-2 border-b border-gray-200 sticky top-0 bg-white">
          <div class="text-xs font-semibold text-gray-600">Details</div>
          <button id="kg-sidebar-close" type="button" aria-label="Close details"
                  class="text-gray-500 hover:text-gray-800 text-lg leading-none px-2">×</button>
        </div>
        <div id="kg-sidebar"></div>
      </aside>
    </div>

    {/* Keyboard / screen-reader alternative: every node as a link, filled and filtered by KGGraph.ts */}
    <details id="kg-node-list-wrap" class="ui mt-3 text-sm">
      <summary class="cursor-pointer text-ink-muted">List of all nodes in the graph</summary>
      <div id="kg-node-list" class="mt-2"></div>
    </details>
  </section>
</BaseLayout>

<script>
  import { mountKGGraph } from "../components/KGGraph.ts";

  const container = document.getElementById("cy") as HTMLElement | null;
  const sidebar = document.getElementById("kg-sidebar") as HTMLElement | null;
  const sidebarCard = document.getElementById("kg-sidebar-card") as HTMLElement | null;
  const sidebarClose = document.getElementById("kg-sidebar-close") as HTMLButtonElement | null;
  const filters = document.getElementById("kg-filters") as HTMLElement | null;
  const filtersDrawer = document.getElementById("kg-filters-drawer") as HTMLElement | null;
  const filtersToggle = document.getElementById("kg-filters-toggle") as HTMLButtonElement | null;
  const filtersClose = document.getElementById("kg-filters-close") as HTMLButtonElement | null;
  const legendPopover = document.getElementById("kg-legend-popover") as HTMLElement | null;
  const legendToggle = document.getElementById("kg-legend-toggle") as HTMLButtonElement | null;
  const legendClose = document.getElementById("kg-legend-close") as HTMLButtonElement | null;
  const layoutSelect = document.getElementById("kg-layout") as HTMLSelectElement | null;
  const resetBtn = document.getElementById("kg-reset") as HTMLButtonElement | null;
  const search = document.getElementById("kg-search") as HTMLInputElement | null;

  // ----- UI: drawer + popover toggles -----
  const FOCUSABLE = 'a[href], button:not([disabled]), input:not([disabled]), select:not([disabled]), textarea:not([disabled]), [tabindex]:not([tabindex="-1"])';

  let lastFocus: HTMLElement | null = null;
  let trapHandler: ((e: KeyboardEvent) => void) | null = null;

  function trapFocus(root: HTMLElement): void {
    const focusables = Array.from(root.querySelectorAll<HTMLElement>(FOCUSABLE))
      .filter((el) => el.offsetParent !== null);
    if (focusables.length === 0) return;
    const first = focusables[0];
    const last = focusables[focusables.length - 1];
    trapHandler = (e: KeyboardEvent) => {
      if (e.key !== "Tab") return;
      if (e.shiftKey && document.activeElement === first) {
        e.preventDefault(); last.focus();
      } else if (!e.shiftKey && document.activeElement === last) {
        e.preventDefault(); first.focus();
      }
    };
    root.addEventListener("keydown", trapHandler as EventListener);
  }
  function releaseFocus(root: HTMLElement): void {
    if (trapHandler) {
      root.removeEventListener("keydown", trapHandler as EventListener);
      trapHandler = null;
    }
  }

  function setFiltersOpen(open: boolean): void {
    if (!filtersDrawer || !filtersToggle) return;
    filtersDrawer.classList.toggle("hidden", !open);
    filtersDrawer.setAttribute("aria-hidden", open ? "false" : "true");
    filtersToggle.setAttribute("aria-expanded", open ? "true" : "false");
    document.body.setAttribute("data-panel-open", open ? "filters" : "");
    if (open) {
      lastFocus = document.activeElement as HTMLElement | null;
      const firstInput = filtersDrawer.querySelector<HTMLElement>(FOCUSABLE);
      firstInput?.focus();
      trapFocus(filtersDrawer);
    } else {
      releaseFocus(filtersDrawer);
      lastFocus?.focus?.();
    }
  }

  function setLegendOpen(open: boolean): void {
    if (!legendPopover || !legendToggle) return;
    legendPopover.classList.toggle("hidden", !open);
    legendPopover.setAttribute("aria-hidden", open ? "false" : "true");
    legendToggle.setAttribute("aria-expanded", open ? "true" : "false");
    if (open) {
      legendClose?.focus();
    }
  }

  // Where focus goes back to when the details card closes after a keyboard activation (the graph, or the
  // "Show in graph" button in the node list). Also used when the card is closed with focus inside it.
  let detailsReturnTo: HTMLElement | null = null;

  function setSidebarOpen(open: boolean): void {
    if (!sidebarCard) return;
    const hadFocus = sidebarCard.contains(document.activeElement);
    sidebarCard.classList.toggle("hidden", !open);
    sidebarCard.setAttribute("aria-hidden", open ? "false" : "true");
    if (!open && hadFocus) {
      (detailsReturnTo && detailsReturnTo.isConnected ? detailsReturnTo : container)?.focus();
    }
    if (!open) detailsReturnTo = null;
  }
  const isDetailsOpen = (): boolean => !!sidebarCard && !sidebarCard.classList.contains("hidden");

  filtersToggle?.addEventListener("click", () => {
    const open = filtersDrawer?.classList.contains("hidden");
    setFiltersOpen(!!open);
  });
  filtersClose?.addEventListener("click", () => setFiltersOpen(false));

  legendToggle?.addEventListener("click", () => {
    const open = legendPopover?.classList.contains("hidden");
    setLegendOpen(!!open);
  });
  legendClose?.addEventListener("click", () => setLegendOpen(false));

  sidebarClose?.addEventListener("click", () => setSidebarOpen(false));

  document.addEventListener("keydown", (e) => {
    if (e.key !== "Escape") return;
    if (filtersDrawer && !filtersDrawer.classList.contains("hidden")) {
      setFiltersOpen(false);
    } else if (legendPopover && !legendPopover.classList.contains("hidden")) {
      setLegendOpen(false);
    } else if (sidebarCard && !sidebarCard.classList.contains("hidden")) {
      setSidebarOpen(false);
    }
  });

  // When KGGraph.ts writes into #kg-sidebar (on node click), auto-open the
  // floating details card. Empty state (initial/deselect) keeps it hidden.
  if (sidebar && sidebarCard) {
    const mo = new MutationObserver(() => {
      const hasContent = sidebar.querySelector("a, div > strong, [style*='font-size:18px']") !== null
        || (sidebar.textContent?.trim().length ?? 0) > 0;
      const isEmptyHint = sidebar.textContent?.includes("Click a node to see details");
      setSidebarOpen(!!hasContent && !isEmptyHint);
    });
    mo.observe(sidebar, { childList: true, subtree: true, characterData: true });
  }

  if (container && sidebar && filters && layoutSelect && resetBtn && search) {
    const params = new URLSearchParams(window.location.search);
    const focusNodeId = params.get("node");
    mountKGGraph({
      container,
      sidebar,
      filters,
      layoutSelect,
      resetBtn,
      search,
      focusNodeId,
      nodeList: document.getElementById("kg-node-list"),
      isDetailsOpen,
      onActivate: (returnTo: HTMLElement) => {
        setSidebarOpen(true);
        detailsReturnTo = returnTo;
        document.getElementById("kg-detail-title")?.focus();
      },
    }).catch((err) => {
      const fb = document.getElementById("kg-fallback");
      if (fb) {
        (fb as HTMLElement).style.display = "block";
        fb.classList.remove("hidden");
        fb.innerHTML =
          `<p>Failed to initialize graph: ${String(err).replace(/</g, "&lt;")}.</p>` +
          `<p>See <a href="/api/v1/snapshot.json">/api/v1/snapshot.json</a>.</p>`;
      }
    });
  }
</script>

<style is:global>
  /* Keyboard access (see setupKeyboard in KGGraph.ts). The canvas wrapper clips overflow, so draw the
     container's focus outline inside its edge. The focused node itself gets a navy ring on the canvas. */
  #cy:focus-visible { outline: 2px solid #1f3a93; outline-offset: -3px; }
  #kg-detail-title:focus { outline: none; }
  #kg-search::-webkit-calendar-picker-indicator { display: none !important; }
  #kg-node-list h2 { font-size: 0.8125rem; font-weight: 600; margin: 0.75rem 0 0.25rem; }
  #kg-node-list ul { list-style: none; margin: 0; padding: 0; columns: 18rem; column-gap: 1.5rem; }
  #kg-node-list li { margin: 0.125rem 0; break-inside: avoid; }
  #kg-node-list button {
    font-size: 0.75rem; line-height: 1.25; padding: 0 0.375rem; margin-left: 0.25rem;
    border: 1px solid #d1d5db; border-radius: 4px; background: #fff; color: #4b5563; cursor: pointer;
  }
  #kg-node-list button:hover { background: #f3f4f6; }
  #kg-node-list .kg-list-count { color: #6b7280; font-size: 0.75rem; margin: 0; }
</style>
