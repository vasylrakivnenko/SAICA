---
// /taxonomy-study — cluster-study explorer. Two visualizations:
//   1. UMAP scatter with shaded convex-hull cluster regions and labels, so
//      clusters are visible at a glance rather than drowned in a dot cloud.
//   2. A Sankey-style alluvial diagram across text (K=26) → bipartite (K=7) →
//      SAICA (K=11), making the fan-in / fan-out pattern legible.
// Data: /taxonomy_study.json.
import BaseLayout from "../layouts/BaseLayout.astro";
const title = "Cluster Study";
const STATS: [string, string, string][] = [
  ["ts-k-text", "26", "K<sub>text</sub> (HDBSCAN)"],
  ["ts-k-bipartite", "7", "K<sub>bipartite</sub> (tool-based)"],
  ["ts-k-manual", "11", "K<sub>manual</sub> (SAICA)"],
  ["ts-ari-bip", "0.52", "ARI<sub>bipartite vs SAICA</sub>"],
];
const COLORINGS: [string, string, boolean][] = [
  ["bipartite", "bipartite cluster (K=7)", true],
  ["saica", "SAICA match (K=11)", false],
  ["text", "text cluster (K=26)", false],
  ["taxonomy", "source taxonomy", false],
];
const TAKEAWAYS: [string, string][] = [
  ["Text clustering fragments",
    "26 clusters, most with only 2–4 members; a huge noise bucket (~48 categories) absorbs whatever the prose-similarity signal could not commit to."],
  ["Bipartite clustering concentrates",
    "just 7 clusters, each tall, carving the corpus into tool-response families."],
  ["Fan-in, left → middle",
    "every bipartite bar is fed by many text slivers — text K=26 is too fine for the supervision structure."],
  ["Tight mapping, middle → right",
    "each bipartite bar lines up with 1–2 SAICA modes (ARI 0.52, NMI 0.74), confirming that \"what can stop it\" recovers SAICA's manual partition."],
  ["Text → SAICA is scattered",
    "the prose alone is not enough; supervision-tool reachability is the signal that matches the expert taxonomy."],
];
---

<BaseLayout title={title}>
  <section class="mb-6 max-w-3xl">
    <p class="font-sans text-xs uppercase tracking-widest text-ink-faint">
      Research Study
    </p>
    <h1 class="mt-2">Taxonomy cluster study</h1>
    <p class="mt-4 leading-7">
      If we let embeddings and HDBSCAN choose how many failure classes there
      are across the 121 categories ingested from OWASP, MAST, DAPLab,
      Microsoft AIRT, Swiss Cheese, and Shah 2026, do we converge on SAICA's
      manual 11, or something different? Two algorithmic methods were tried.
      <strong>Text clustering</strong> over MiniLM sentence embeddings of the
      <code>label + description</code> prose landed on
      <strong>K<sub>text</sub> = 26</strong> — finer than SAICA and weakly
      agreeing with it (ARI 0.08, NMI 0.38).
      <strong>Response clustering</strong> over the
      (category &times; tool) bipartite reachability matrix landed on
      <strong>K<sub>bipartite</sub> = 7</strong>, <em>coarser</em> than SAICA's
      11 and substantially more aligned with it
      (<strong>ARI 0.52, NMI 0.74</strong>).
    </p>
  </section>

  <section class="mt-6 grid grid-cols-2 sm:grid-cols-4 gap-3 max-w-3xl">
    {STATS.map(([id, v, lbl]) => (
      <div class="card">
        <div class="text-3xl font-sans font-semibold" id={id}>{v}</div>
        <div class="text-sm text-ink-muted font-sans" set:html={lbl} />
      </div>
    ))}
  </section>

  <section class="mt-10">
    <h2 class="!mt-0">UMAP — categories grouped into cluster regions</h2>
    <div class="grid grid-cols-[14rem_1fr] gap-4" id="ts-root">
      <aside class="ui text-sm">
        <div class="mb-4">
          <div class="text-xs font-semibold text-ink-faint uppercase tracking-wide mb-2">Color by</div>
          {COLORINGS.map(([v, lbl, checked]) => (
            <label class="block mb-1">
              <input type="radio" name="ts-color" value={v} checked={checked} />
              {" " + lbl}
            </label>
          ))}
        </div>

        <div class="mb-4">
          <div class="text-xs font-semibold text-ink-faint uppercase tracking-wide mb-2">Legend</div>
          <div id="ts-legend" class="space-y-1 text-xs"></div>
        </div>

        <div class="text-xs text-ink-faint" id="ts-count"></div>
      </aside>

      <div class="relative border border-ink/10 rounded bg-white" style="min-height: 520px; height: 72vh">
        <noscript>
          <div class="p-3 text-sm">
            The cluster-study explorer requires JavaScript. Raw data:
            <a href="/taxonomy_study.json">/taxonomy_study.json</a>.
          </div>
        </noscript>
        <svg id="ts-svg" viewBox="0 0 100 100" preserveAspectRatio="none"
             style="width: 100%; height: 100%; display: block; min-width: 600px;"></svg>
        <div class="absolute bottom-1 left-2 text-[10px] text-ink-faint font-sans pointer-events-none">
          UMAP 1 &rarr;
        </div>
        <div class="absolute top-2 left-1 text-[10px] text-ink-faint font-sans pointer-events-none"
             style="writing-mode: vertical-rl; transform: rotate(180deg);">
          UMAP 2 &rarr;
        </div>
        <div id="ts-tooltip"
             class="pointer-events-none absolute hidden bg-ink text-white text-xs rounded px-2 py-1 shadow max-w-xs"
             style="transform: translate(-50%, -110%);"></div>
        <div id="ts-fallback" class="hidden absolute inset-0 p-6 text-sm bg-white"></div>
      </div>
    </div>
    <p class="mt-3 max-w-3xl text-sm text-ink-muted leading-6">
      Each shaded polygon is one cluster's convex hull, colored by partition
      and labeled with the cluster's proposed name. Dots are the 121 source
      categories at their UMAP-2D coordinates. Light-gray dots are HDBSCAN
      noise (cluster = -1) — they get no hull. Switch the coloring to see how
      <em>the same</em> 121 points get carved up differently by text
      clustering (many thin hulls), bipartite clustering (few broad hulls),
      and SAICA's manual partition (11 modes). Click any dot for its full
      description and fellow cluster members.
    </p>
  </section>

  <section id="ts-panel" class="mt-6 hidden">
    <div class="card">
      <div class="flex items-baseline justify-between gap-4">
        <div>
          <div class="text-xs text-ink-faint font-sans uppercase tracking-wide" id="ts-panel-sub"></div>
          <h2 class="mt-0 mb-1" id="ts-panel-title"></h2>
        </div>
        <button id="ts-panel-close" class="text-sm text-ink-faint hover:text-ink">close</button>
      </div>
      <p class="text-sm leading-6" id="ts-panel-desc"></p>
      <div class="mt-3 flex flex-wrap gap-1.5 text-xs" id="ts-panel-chips"></div>
      <div class="mt-4" id="ts-panel-members-wrap" hidden>
        <div class="text-xs font-semibold text-ink-faint uppercase tracking-wide mb-1">
          Other members of this cluster
        </div>
        <ul class="text-sm space-y-0.5" id="ts-panel-members"></ul>
      </div>
    </div>
  </section>

  <section class="mt-12">
    <h2>Alluvial — how categories flow between partitions</h2>
    <div class="border border-ink/10 rounded bg-white p-3 overflow-x-auto">
      <svg id="ts-sankey" viewBox="0 0 900 420" preserveAspectRatio="xMidYMid meet"
           style="width: 100%; min-width: 720px; height: 420px; display: block;"></svg>
      <div id="ts-sankey-tip"
           class="pointer-events-none absolute hidden bg-ink text-white text-xs rounded px-2 py-1 shadow max-w-xs"
           style="transform: translate(-50%, -110%);"></div>
    </div>
    <p class="mt-3 max-w-3xl text-sm text-ink-muted leading-6">
      Three stacked columns, each a vertical inventory of clusters at a
      different K: text (26 thin slivers) → bipartite (7 tall blocks) →
      SAICA modes (11). Ribbon thickness = number of categories that belong
      to both the left and right bar; ribbons inherit their source bar's
      color. Read it left-to-right: many text slivers fan into a handful of
      bipartite blocks (concentration), and those blocks map tightly onto
      SAICA's modes (alignment). Hover any bar to light up the ribbons that
      touch it; hover a ribbon to see its size.
    </p>
  </section>

  <section class="mt-8 max-w-3xl">
    <h2>Key takeaways</h2>
    <ul class="list-disc pl-6 text-sm leading-7 space-y-1">
      {TAKEAWAYS.map(([head, body]) => (
        <li><strong>{head}</strong>: {body}</li>
      ))}
    </ul>
  </section>

  <section class="mt-10">
    <h2>Clusters for the current coloring</h2>
    <p class="text-sm text-ink-muted mb-2">Rows correspond to clusters of the currently-selected partition. Noise points (HDBSCAN id = -1) are listed last.</p>
    <div class="overflow-x-auto border border-ink/10 rounded">
      <table class="w-full text-sm font-sans">
        <thead class="bg-paper-alt text-ink-faint text-xs uppercase tracking-wide">
          <tr>
            <th class="text-left px-3 py-2">Cluster</th>
            <th class="text-right px-3 py-2">Size</th>
            <th class="text-left px-3 py-2">SAICA top match</th>
            <th class="text-right px-3 py-2">Coverage</th>
            <th class="text-left px-3 py-2">Top 3 members</th>
          </tr>
        </thead>
        <tbody id="ts-table"></tbody>
      </table>
    </div>
  </section>

  <section class="mt-10 max-w-3xl">
    <h2>Further reading</h2>
    <ul class="text-sm space-y-1">
      <li>Full narrative report: <a href="https://github.com/vasylrakivnenko/SAICA/blob/main/research/TAXONOMY_CLUSTER_STUDY.md" rel="noopener"><code>research/TAXONOMY_CLUSTER_STUDY.md</code></a></li>
      <li>Raw artifacts: <a href="https://github.com/vasylrakivnenko/SAICA/tree/main/research/taxonomy_clustering" rel="noopener"><code>research/taxonomy_clustering/</code></a></li>
      <li>Machine-readable input: <a href="/taxonomy_study.json"><code>/taxonomy_study.json</code></a></li>
    </ul>
  </section>
</BaseLayout>

<script>
  import {
    layoutSankey, renderClusterRegion, renderSankeyInto, mkSvg,
  } from "../lib/cluster-viz";

  interface Point {
    id: string; key: string; source_tax_id: string; label: string;
    description: string; x: number; y: number;
    text_cluster: number; bipartite_cluster: number; saica_match: string;
  }
  interface ClusterRow {
    id: number; name: string; size: number; saica_top: string;
    saica_coverage: number; saica_mode_spread: number;
    disagreement: boolean; member_ids: string[];
  }
  interface TaxonomyMeta { name: string; color: string }
  interface Summary {
    corpus_size: number; k_text: number; k_bipartite: number; k_manual_saica: number;
    ari_text_saica: number; nmi_text_saica: number;
    ari_bipartite_saica: number; nmi_bipartite_saica: number;
    bootstrap_ari_text: number; bootstrap_ari_bipartite: number;
    chosen_text_mcs: number; chosen_bipartite_mcs: number;
  }
  interface Payload {
    summary: Summary; taxonomies: Record<string, TaxonomyMeta>;
    saica_modes: string[]; points: Point[];
    clusters: { bipartite: ClusterRow[]; text: ClusterRow[] };
  }
  type Mode = "taxonomy" | "bipartite" | "text" | "saica";

  const PALETTE: string[] = [
    "#2563eb", "#e11d48", "#7c3aed", "#64748b",
    "#f59e0b", "#0891b2", "#059669", "#db2777",
    "#ea580c", "#4f46e5", "#16a34a", "#9333ea",
    "#0284c7", "#b91c1c", "#ca8a04", "#6d28d9",
    "#1d4ed8", "#be123c", "#15803d", "#a16207",
    "#5b21b6", "#0369a1", "#991b1b", "#4d7c0f",
    "#6b21a8", "#0e7490", "#166534", "#c2410c",
  ];
  const NOISE_FILL = "#d1d5db";
  const NOISE_OPACITY = 0.3;

  const el = <T extends Element>(id: string) => document.getElementById(id) as unknown as T | null;
  const svg = el<SVGSVGElement>("ts-svg");
  const sankeySvg = el<SVGSVGElement>("ts-sankey");
  const sankeyTip = el<HTMLDivElement>("ts-sankey-tip");
  const tooltip = el<HTMLDivElement>("ts-tooltip");
  const fallback = el<HTMLDivElement>("ts-fallback");
  const legendEl = el<HTMLDivElement>("ts-legend");
  const countEl = el<HTMLElement>("ts-count");
  const tableEl = el<HTMLTableSectionElement>("ts-table");
  const panelEl = el<HTMLElement>("ts-panel");
  const panelSub = el<HTMLElement>("ts-panel-sub");
  const panelTitle = el<HTMLElement>("ts-panel-title");
  const panelDesc = el<HTMLElement>("ts-panel-desc");
  const panelChips = el<HTMLElement>("ts-panel-chips");
  const panelMembersWrap = el<HTMLElement>("ts-panel-members-wrap");
  const panelMembers = el<HTMLUListElement>("ts-panel-members");
  const panelClose = el<HTMLButtonElement>("ts-panel-close");

  let payload: Payload | null = null;
  let mode: Mode = "bipartite";

  function allModeValues(p: Payload, m: Mode): string[] {
    if (m === "taxonomy") return Object.keys(p.taxonomies).sort();
    if (m === "saica") {
      const modes = new Set<string>(p.saica_modes);
      for (const pt of p.points) modes.add(pt.saica_match);
      return Array.from(modes).sort();
    }
    const ids = new Set<number>();
    for (const pt of p.points) ids.add(m === "bipartite" ? pt.bipartite_cluster : pt.text_cluster);
    const arr = Array.from(ids).sort((a, b) => a - b);
    const noise = arr.filter((v) => v < 0);
    const rest = arr.filter((v) => v >= 0);
    return [...rest.map(String), ...noise.map(String)];
  }

  function valueForPoint(pt: Point, m: Mode): string {
    if (m === "taxonomy") return pt.source_tax_id;
    if (m === "bipartite") return String(pt.bipartite_cluster);
    if (m === "text") return String(pt.text_cluster);
    return pt.saica_match;
  }

  function isNoise(pt: Point, m: Mode): boolean {
    if (m === "bipartite") return pt.bipartite_cluster < 0;
    if (m === "text") return pt.text_cluster < 0;
    if (m === "saica") return pt.saica_match === "__unmapped__";
    return false;
  }

  function colorFor(value: string, values: string[], m: Mode): string {
    if (m === "taxonomy") return payload?.taxonomies[value]?.color ?? "#64748b";
    if ((m === "bipartite" || m === "text") && value === "-1") return NOISE_FILL;
    if (m === "saica" && value === "__unmapped__") return NOISE_FILL;
    const idx = values.indexOf(value);
    return PALETTE[idx % PALETTE.length];
  }

  function labelFor(value: string, m: Mode): string {
    if (m === "taxonomy") return payload?.taxonomies[value]?.name ?? value;
    if (m === "bipartite" || m === "text") {
      if (value === "-1") return "noise";
      const rows = m === "bipartite" ? payload?.clusters.bipartite : payload?.clusters.text;
      return rows?.find((c) => String(c.id) === value)?.name ?? `cluster ${value}`;
    }
    return value;
  }

  function clusterRowsFor(m: Mode): ClusterRow[] {
    if (!payload) return [];
    if (m === "bipartite") return payload.clusters.bipartite;
    if (m === "text") return payload.clusters.text;
    const getKey = m === "saica"
      ? (pt: Point) => pt.saica_match
      : (pt: Point) => pt.source_tax_id;
    const getName = m === "saica"
      ? (k: string) => k
      : (k: string) => payload!.taxonomies[k]?.name ?? k;
    const by = new Map<string, string[]>();
    for (const pt of payload.points) {
      const arr = by.get(getKey(pt)) ?? [];
      arr.push(pt.key);
      by.set(getKey(pt), arr);
    }
    const rows: ClusterRow[] = [];
    for (const [k, members] of by) {
      rows.push({
        id: rows.length, name: getName(k), size: members.length,
        saica_top: m === "saica" ? k : "n/a",
        saica_coverage: m === "saica" ? 1.0 : 0,
        saica_mode_spread: m === "saica" ? 1 : 0,
        disagreement: m === "saica" && k === "__unmapped__",
        member_ids: members,
      });
    }
    rows.sort((a, b) => b.size - a.size);
    return rows;
  }

  // ─────────── UMAP scatter with cluster hulls ───────────

  function renderScatter(): void {
    if (!svg || !payload) return;
    while (svg.firstChild) svg.removeChild(svg.firstChild);
    const values = allModeValues(payload, mode);
    const PAD = 4;
    const toSvg = (pt: Point) => ({
      x: PAD + pt.x * (100 - 2 * PAD),
      y: PAD + (1 - pt.y) * (100 - 2 * PAD),
    });

    // Bucket points by cluster value for hull drawing.
    const buckets = new Map<string, Point[]>();
    for (const pt of payload.points) {
      if (isNoise(pt, mode)) continue;
      const v = valueForPoint(pt, mode);
      const arr = buckets.get(v) ?? [];
      arr.push(pt);
      buckets.set(v, arr);
    }

    // Layer 1: hulls (under everything). Labels are layered on top later.
    const labelNodes: SVGElement[] = [];
    for (const [v, pts] of buckets) {
      const [hullNode, labelNode] = renderClusterRegion(
        pts.map(toSvg), colorFor(v, values, mode), labelFor(v, mode),
      );
      svg.appendChild(hullNode);
      labelNodes.push(labelNode);
    }

    // Layer 2: noise dots first, then colored dots.
    const noiseDots: Point[] = []; const liveDots: Point[] = [];
    for (const pt of payload.points) (isNoise(pt, mode) ? noiseDots : liveDots).push(pt);
    for (const pt of noiseDots) svg.appendChild(makeDot(pt, NOISE_FILL, NOISE_OPACITY, PAD));
    for (const pt of liveDots) {
      const v = valueForPoint(pt, mode);
      svg.appendChild(makeDot(pt, colorFor(v, values, mode), 0.9, PAD));
    }

    // Layer 3: cluster labels on top so they're readable against dots.
    for (const halo of labelNodes) {
      svg.appendChild(halo);
    }

    if (countEl) countEl.textContent = `${payload.points.length} categories`;
  }

  function makeDot(pt: Point, fill: string, opacity: number, PAD: number): SVGCircleElement {
    const cx = PAD + pt.x * (100 - 2 * PAD);
    const cy = PAD + (1 - pt.y) * (100 - 2 * PAD);
    const dot = mkSvg("circle", {
      cx: cx.toFixed(3), cy: cy.toFixed(3), r: "0.9",
      fill, "fill-opacity": String(opacity),
      stroke: "white", "stroke-width": "0.18",
    });
    dot.style.cursor = "pointer";
    dot.dataset.key = pt.key;
    return dot;
  }

  function renderLegend(): void {
    if (!legendEl || !payload) return;
    const values = allModeValues(payload, mode);
    legendEl.innerHTML = values.map((v) => {
      const c = colorFor(v, values, mode);
      const n = escapeHtml(labelFor(v, mode));
      return `<div class="flex items-center gap-2">`
        + `<span class="inline-block w-2.5 h-2.5 rounded-full shrink-0" style="background:${c}"></span>`
        + `<span class="text-ink-muted truncate" title="${n}">${n}</span></div>`;
    }).join("");
  }

  function renderTable(): void {
    if (!tableEl) return;
    tableEl.innerHTML = clusterRowsFor(mode).map((r) => {
      const idLabel = (mode === "bipartite" || mode === "text")
        ? (r.id === -1 ? "noise" : `#${r.id}`) : "";
      const idHtml = idLabel
        ? `<span class="font-mono text-xs text-ink-faint mr-1">${idLabel}</span>` : "";
      const cov = r.saica_top === "n/a" ? "—" : `${(r.saica_coverage * 100).toFixed(0)}%`;
      const top3 = r.member_ids.slice(0, 3).map((k) => k.split("::")[1] ?? k);
      const more = r.member_ids.length > 3 ? ` +${r.member_ids.length - 3}` : "";
      return `<tr class="border-t border-ink/10 hover:bg-paper-alt">`
        + `<td class="px-3 py-2">${idHtml}${escapeHtml(r.name)}</td>`
        + `<td class="px-3 py-2 text-right font-mono text-xs">${r.size}</td>`
        + `<td class="px-3 py-2">${escapeHtml(r.saica_top || "—")}</td>`
        + `<td class="px-3 py-2 text-right font-mono text-xs">${cov}</td>`
        + `<td class="px-3 py-2 text-ink-muted text-xs font-mono">${escapeHtml(top3.join(", "))}${more}</td>`
        + `</tr>`;
    }).join("");
  }

  function escapeHtml(s: string): string {
    return s.replace(/&/g, "&amp;").replace(/</g, "&lt;")
      .replace(/>/g, "&gt;").replace(/"/g, "&quot;");
  }

  function onMove(e: MouseEvent): void {
    const target = e.target as Element | null;
    if (!target || target.tagName !== "circle" || !tooltip || !svg || !payload) {
      if (tooltip) tooltip.classList.add("hidden");
      return;
    }
    const key = (target as SVGCircleElement).dataset.key;
    if (!key) return;
    const pt = payload.points.find((p) => p.key === key);
    if (!pt) return;
    const taxName = payload.taxonomies[pt.source_tax_id]?.name ?? pt.source_tax_id;
    const clusterTxt = mode === "bipartite" ? `bip #${pt.bipartite_cluster}`
      : mode === "text" ? `text #${pt.text_cluster}`
      : mode === "saica" ? pt.saica_match : taxName;
    tooltip.innerHTML = `<div class="font-semibold">${escapeHtml(pt.label)}</div>`
      + `<div class="opacity-80">${escapeHtml(taxName)} · ${escapeHtml(pt.id)}</div>`
      + `<div class="opacity-80">${escapeHtml(clusterTxt)} · SAICA: ${escapeHtml(pt.saica_match)}</div>`;
    const rect = svg.getBoundingClientRect();
    tooltip.style.left = `${e.clientX - rect.left}px`;
    tooltip.style.top = `${e.clientY - rect.top}px`;
    tooltip.classList.remove("hidden");
  }

  function onClick(e: MouseEvent): void {
    const target = e.target as Element | null;
    if (!target || target.tagName !== "circle" || !payload) return;
    const key = (target as SVGCircleElement).dataset.key;
    if (!key) return;
    const pt = payload.points.find((p) => p.key === key);
    if (pt) openPanel(pt);
  }

  function openPanel(pt: Point): void {
    if (!panelEl || !panelTitle || !panelDesc || !panelSub || !panelChips) return;
    const taxName = payload?.taxonomies[pt.source_tax_id]?.name ?? pt.source_tax_id;
    const bipN = labelFor(String(pt.bipartite_cluster), "bipartite");
    const txtN = labelFor(String(pt.text_cluster), "text");
    panelSub.textContent = `${taxName} · ${pt.id}`;
    panelTitle.textContent = pt.label;
    panelDesc.textContent = pt.description || "(no description)";
    panelChips.innerHTML = [
      [`bipartite #${pt.bipartite_cluster}`, bipN],
      [`text #${pt.text_cluster}`, txtN],
      ["SAICA", pt.saica_match],
    ].map(([k, v]) =>
      `<span class="chip"><span class="text-ink-faint">${escapeHtml(k)}</span> `
      + `<span>${escapeHtml(v)}</span></span>`
    ).join("");
    if (panelMembers && panelMembersWrap) {
      const peers = fellowMembers(pt);
      panelMembersWrap.hidden = peers.length === 0;
      panelMembers.innerHTML = peers.map((peer) => {
        const tn = payload?.taxonomies[peer.source_tax_id]?.name ?? peer.source_tax_id;
        return `<li><span class="font-mono text-xs text-ink-faint">${escapeHtml(peer.id)}</span>`
          + ` · <span>${escapeHtml(peer.label)}</span>`
          + ` <span class="text-ink-faint">(${escapeHtml(tn)})</span></li>`;
      }).join("");
    }
    panelEl.classList.remove("hidden");
    panelEl.scrollIntoView({ behavior: "smooth", block: "nearest" });
  }

  function fellowMembers(pt: Point): Point[] {
    if (!payload) return [];
    const same = (p: Point): boolean => {
      if (p.key === pt.key) return false;
      if (mode === "bipartite") return p.bipartite_cluster === pt.bipartite_cluster && pt.bipartite_cluster >= 0;
      if (mode === "text") return p.text_cluster === pt.text_cluster && pt.text_cluster >= 0;
      if (mode === "saica") return p.saica_match === pt.saica_match && pt.saica_match !== "__unmapped__";
      return p.source_tax_id === pt.source_tax_id;
    };
    return payload.points.filter(same).slice(0, 30);
  }

  // ─────────── Sankey ───────────

  function renderSankey(): void {
    if (!sankeySvg || !payload) return;
    const MARGIN_X = 140; const MARGIN_Y = 12; const barWidth = 18;
    const nm = (k: string, rows: ClusterRow[], fallbackPrefix: string) =>
      k === "-1" ? `${fallbackPrefix} noise`
        : (rows.find((c) => String(c.id) === k)?.name ?? `${fallbackPrefix} #${k}`);
    const layout = layoutSankey<Point>({
      items: payload.points,
      columns: [
        { id: "text", label: "text (K=26)",
          key: (p) => String(p.text_cluster),
          barName: (k) => nm(k, payload!.clusters.text, "text"),
          barColor: (k) => k === "-1" ? NOISE_FILL : undefined },
        { id: "bipartite", label: "bipartite (K=7)",
          key: (p) => String(p.bipartite_cluster),
          barName: (k) => nm(k, payload!.clusters.bipartite, "bip"),
          barColor: (k) => k === "-1" ? NOISE_FILL : undefined },
        { id: "saica", label: "SAICA (K=11)",
          key: (p) => p.saica_match,
          barName: (k) => k === "__unmapped__" ? "unmapped" : k,
          barColor: (k) => k === "__unmapped__" ? NOISE_FILL : undefined },
      ],
      width: 900 - 2 * MARGIN_X,
      height: 420 - 2 * MARGIN_Y - 28,
      barWidth, barGap: 3, palette: PALETTE,
    });

    let ribbonEls: SVGPathElement[] = [];
    const clearHover = () => {
      for (const p of ribbonEls) p.setAttribute("fill-opacity", "0.32");
      sankeyTip?.classList.add("hidden");
    };
    ribbonEls = renderSankeyInto({
      root: sankeySvg, layout, marginX: MARGIN_X, marginY: MARGIN_Y,
      columnTitles: ["text clusters (K=26)", "bipartite clusters (K=7)", "SAICA modes (K=11)"],
      onHover: (r, ev) => {
        for (const p of ribbonEls) p.setAttribute("fill-opacity", "0.08");
        (ev.currentTarget as SVGPathElement).setAttribute("fill-opacity", "0.85");
        if (!sankeyTip || !sankeySvg) return;
        const rect = sankeySvg.getBoundingClientRect();
        sankeyTip.innerHTML = `<div class="font-semibold">${escapeHtml(r.from.name)} → ${escapeHtml(r.to.name)}</div>`
          + `<div class="opacity-80">${r.size} categor${r.size === 1 ? "y" : "ies"}</div>`;
        sankeyTip.style.left = `${ev.clientX - rect.left}px`;
        sankeyTip.style.top = `${ev.clientY - rect.top}px`;
        sankeyTip.classList.remove("hidden");
      },
      onLeave: clearHover,
    });
  }

  // ─────────── lifecycle ───────────

  function setMode(m: Mode): void {
    mode = m;
    renderScatter();
    renderLegend();
    renderTable();
  }

  function updateHeadline(): void {
    if (!payload) return;
    const s = payload.summary;
    const set = (id: string, v: string) => { const el = document.getElementById(id); if (el) el.textContent = v; };
    set("ts-k-text", String(s.k_text));
    set("ts-k-bipartite", String(s.k_bipartite));
    set("ts-k-manual", String(s.k_manual_saica));
    set("ts-ari-bip", s.ari_bipartite_saica.toFixed(2));
  }

  async function init(): Promise<void> {
    try {
      const res = await fetch("/taxonomy_study.json");
      if (!res.ok) throw new Error(`HTTP ${res.status}`);
      payload = (await res.json()) as Payload;
    } catch (err) {
      if (fallback) {
        fallback.classList.remove("hidden");
        fallback.textContent = `Failed to load /taxonomy_study.json (${err}). `
          + "Run: .venv/bin/python -m pipeline.taxonomy_cluster.export_site_data";
      }
      return;
    }
    updateHeadline();
    setMode("bipartite");
    renderSankey();

    svg?.addEventListener("mousemove", onMove);
    svg?.addEventListener("mouseleave", () => tooltip?.classList.add("hidden"));
    svg?.addEventListener("click", onClick);
    document.querySelectorAll<HTMLInputElement>('input[name="ts-color"]').forEach((el) => {
      el.addEventListener("change", () => { if (el.checked) setMode(el.value as Mode); });
    });
    panelClose?.addEventListener("click", () => panelEl?.classList.add("hidden"));
  }

  init();
</script>
