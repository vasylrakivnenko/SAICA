---
// SAICA-Bench overview: one block per failure mode (what it tests, data, counts, caveats).
import BaseLayout from '../layouts/BaseLayout.astro';
import results from '../../public/bench/results.json';
const modes = results.modes;
const planned = ['Obsolescence', 'Dependency blindness', 'Incomplete execution', 'Scope creep', 'Logic error', 'Supply-chain attack', 'Cascading failure', 'Context pollution'];
---

<BaseLayout title="Benchmark" description="What SAICA-Bench tests, on which data, and how it is scored.">
  <h1>SAICA-Bench</h1>
  <p class="mt-3 max-w-3xl">
    Each failure mode is tested on a public dataset whose labels were confirmed by execution, construction or expert
    review. A tool sees the agent's change (or full session), and we record whether it flags it. Bad and clean samples are
    mixed, so every tool gets a true positive rate (TPR: share of bad samples it flags) and a false positive rate (FPR: share
    of clean samples it flags). The headline score is <strong>J = TPR − FPR</strong>, which does not depend on the mix and
    compares across modes.
  </p>

  <div class="mt-8 grid gap-5">
    {modes.map((m) => (
      <section class="card p-5 border border-ink/10 rounded-lg bg-white" id={m.id}>
        <div class="font-sans text-xs uppercase tracking-wide text-ink-faint">{m.n_pos} {m.pos_label} · {m.n_neg} clean · {m.rows.length} tools</div>
        <h2 class="mt-1 mb-1">{m.name}</h2>
        <p class="text-ink-muted">{m.summary}</p>
        <p class="mt-2 font-mono text-xs text-ink-faint">Data: {m.dataset}</p>
        <details class="mt-3">
          <summary class="font-sans text-sm cursor-pointer">Setup and caveats</summary>
          <ul class="mt-2 list-disc pl-5 text-sm leading-6">
            {m.setup.map((s) => <li>{s}</li>)}
            {m.caveats.map((s) => <li>{s}</li>)}
          </ul>
        </details>
        <p class="mt-3 font-sans text-sm"><a href={`/#${m.id}`}>Leaderboard →</a></p>
      </section>
    ))}
  </div>

  <p class="mt-8 text-sm text-ink-muted max-w-3xl">
    Coming next: {planned.join(', ')}. Modes without a public dataset with confirmed labels are left out rather than
    filled with synthetic data.
  </p>
</BaseLayout>
