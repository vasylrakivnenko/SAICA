---
// SAICA-Bench home: the leaderboard. Data: /bench/results.json, written by
// bench/build_report.py from each failure mode's results. An Overview tab (results.overview: reviewer x mode
// grid, best tool per mode, findings) and one tab per mode.
import BaseLayout from '../layouts/BaseLayout.astro';
import results from '../../public/bench/results.json';
---

<BaseLayout title="SAICA-Bench">
  <div class="lb">
    <h1>Leaderboard</h1>
    <p class="lead">
      How often each supervision tool flags a real failure of an AI coding agent (<b>true positive rate</b>, TPR) and how often
      it flags clean work (<b>false positive rate</b>, FPR). Each entry reports <b>J = TPR − FPR</b> (0% = chance, 100% = perfect).
    </p>

    <div class="tabs" role="tablist" id="lb-tabs"></div>

    <section id="lb-ov" hidden>
      <p class="fine ov-intro">J for each reviewer that ran on several failure modes. The bottom row names the best tool in each mode, of any type. Hover a cell for the exact tool, its false positive rate and cost; click a mode to open its tab.</p>
      <div class="tbl-wrap"><table class="ov" id="lb-ov-table"></table></div>
      <div class="legend" id="lb-ov-legend"></div>
      <h2>Average quality vs average cost</h2>
      <p class="fine">Each point is one reviewer’s average J and cost over the checked modes (darker = higher J); the dashed line marks the best J at each price. “(3 of 7)” means the tool ran on only 3 of them.</p>
      <div class="ov-modes" id="lb-ov-modes" role="group" aria-label="Failure modes included in the averages"></div>
      <div class="chart" id="lb-ov-chart"></div>
      <h2>What the grid says</h2>
      <ul class="findings" id="lb-ov-findings"></ul>
      <h2>Read before citing</h2>
      <ul class="ov-caveats" id="lb-ov-caveats"></ul>
    </section>

    <div id="lb-mode">
    <div class="controls">
      <div class="types" id="lb-types" role="group" aria-label="Filter by type"></div>
      <label><input type="checkbox" id="lb-stars" checked /> Show GitHub stars</label>
      <span class="mode-note" id="lb-note"></span>
    </div>

    <div class="tbl-wrap">
      <table id="lb-table">
        <thead>
          <tr>
            <th class="num">#</th>
            <th>Tool</th>
            <th>Type</th>
            <th class="num"><button class="sort" data-k="j" type="button" data-tip="J = TPR − FPR. 0% = no better than chance, 100% = flags every bad sample and no clean one">J</button></th>
            <th class="num"><button class="sort" data-k="catch" type="button" data-tip="True positive rate (recall)">TPR</button></th>
            <th class="num"><button class="sort" data-k="fa" type="button" data-tip="False positive rate">FPR</button></th>
            <th class="num"><button class="sort" data-k="cost" type="button" data-tip="Cost per 1,000 reviews, averaged over our run">Cost</button></th>
            <th class="num col-stars"><button class="sort" data-k="stars" type="button">★ Stars</button></th>
          </tr>
        </thead>
        <tbody></tbody>
      </table>
    </div>
    <p class="fine">
      <b>Cost / 1k reviews</b>: what the tool costs to review 1,000 items of this mode (code changes or agent sessions), averaged
      over our run. API models: price reported by the API (Azure: list price × tokens). Self-hosted: GPU time at $0.89/h while
      requests ran. Free programs: $0. Hover a number for the run total and its 95% confidence interval. Stars are a popularity
      reference only, not part of the score.
    </p>

    <h2>Quality vs cost</h2>
    <p class="fine">Up is better, left is cheaper. The dashed line is the Pareto frontier: nothing cheaper scores higher.</p>
    <div class="chart" id="lb-chart"></div>
    <div class="legend" id="lb-legend"></div>
    </div>

    <p class="more"><a href="/benchmark">How each failure mode is tested →</a> · <a href="/graph">Knowledge graph of supervision tools →</a></p>
  </div>
</BaseLayout>

<script is:inline define:vars={{ results }}>
const DATA = results.modes, TYPE_LABEL = results.type_label, OV = results.overview;
const TYPE_VAR = {deterministic: '--t-free', llm_based: '--t-ai', hybrid: '--t-hybrid', prompt_artifact: '--t-skill', baseline_model: '--t-base', baseline_rule: '--t-rule'};
const isBaseline = (r) => r.type === 'baseline_model' || r.type === 'baseline_rule';
const pct = (x) => (x * 100).toFixed(1) + '%';
const money = (c) => (c === 0 ? '$0' : '$' + c.toFixed(2));
const col = (t) => `var(${TYPE_VAR[t]})`;
const el = (tag, attrs = {}, ...kids) => { const e = document.createElement(tag);
  for (const [k, v] of Object.entries(attrs)) { if (k === 'text') e.textContent = v; else if (k === 'style') e.style.cssText = v; else e.setAttribute(k, v); }
  kids.flat().forEach((k) => k != null && e.append(k)); return e; };
const svgEl = (tag, attrs = {}) => { const e = document.createElementNS('http://www.w3.org/2000/svg', tag);
  for (const [k, v] of Object.entries(attrs)) e.setAttribute(k, v); return e; };
const ALL_TYPES = Object.keys(TYPE_LABEL).filter((t) => DATA.some((m) => m.rows.some((r) => r.type === t)));
const state = { mode: OV ? 'overview' : DATA[0].id, key: 'j', types: new Set(ALL_TYPES), stars: true };
const store = (k, v) => { try { localStorage.setItem('saica-lb-' + k, JSON.stringify(v)); } catch (e) {} };
const load = (k, d) => { try { const v = localStorage.getItem('saica-lb-' + k); return v === null ? d : JSON.parse(v); } catch (e) { return d; } };
state.stars = load('stars', true);
const savedTypes = load('types', null); if (Array.isArray(savedTypes) && savedTypes.length) state.types = new Set(savedTypes.filter((t) => ALL_TYPES.includes(t)));

function rowsFor(m) { return m.rows.filter((r) => state.types.has(r.type)); }
function pareto(rows) { return rows.filter((r) => !rows.some((o) => o !== r && o.cost <= r.cost && o.j > r.j)).sort((a, b) => a.cost - b.cost); }

function renderTable(m) {
  const asc = state.key === 'fa' || state.key === 'cost';
  const rows = [...rowsFor(m)].sort((a, b) => {
    const av = a[state.key] ?? -1, bv = b[state.key] ?? -1; return asc ? av - bv : bv - av; });
  const tb = document.querySelector('#lb-table tbody');
  tb.replaceChildren(...rows.map((r, i) => el('tr', { class: isBaseline(r) ? 'baseline' : '' },
    el('td', { class: 'num rank', text: String(i + 1) }),
    el('td', {}, r.repository_url ? el('a', { href: r.repository_url, rel: 'noopener', text: r.tool }) : r.tool),
    el('td', {}, el('span', { class: 'pill', style: `color:${col(r.type)}`, text: TYPE_LABEL[r.type] })),
    el('td', { class: 'num j' }, el('span', { class: 'bar', style: `width:${Math.max(2, r.j * 56)}px` }), pct(r.j)),
    el('td', { class: 'num', 'data-tip': `95% CI ${Math.round(r.catch_ci[0] * 100)}–${Math.round(r.catch_ci[1] * 100)}%`, text: pct(r.catch) }),
    el('td', { class: 'num', 'data-tip': `95% CI ${Math.round(r.fa_ci[0] * 100)}–${Math.round(r.fa_ci[1] * 100)}%`, text: pct(r.fa) }),
    el('td', { class: 'num', 'data-tip': `${money(r.cost)} for all ${m.n} reviews in this run` + (r.cost_note ? `. ${r.cost_note}` : ''), text: (r.cost_note && r.cost_note.includes('estimated') ? '~' : '') + money(r.cost / m.n * 1000) }),
    el('td', { class: 'num col-stars', 'data-tip': r.stars_updated_at ? `as of ${r.stars_updated_at}` : '', text: r.stars ? r.stars.toLocaleString('en-US') : '—' }))));
  document.querySelectorAll('#lb-table .sort').forEach((b) => b.toggleAttribute('aria-pressed', b.dataset.k === state.key));
  document.getElementById('lb-table').classList.toggle('no-stars', !state.stars);
  document.getElementById('lb-note').textContent = `${m.n_pos} ${m.pos_label} vs ${m.n_neg} clean · ${m.dataset}`;
}

function renderChart(m) {
  const box = document.getElementById('lb-chart'); box.replaceChildren();
  const rows = rowsFor(m); if (!rows.length) return;
  const W = Math.max(320, box.clientWidth), H = Math.round(Math.min(420, Math.max(280, W * 0.48)));
  const narrow = W < 560, M = { l: 46, r: 16, t: 12, b: 44 }, freeW = 54;
  const per1k = (r) => r.cost / m.n * 1000; const paid = rows.filter((r) => r.cost > 0);
  const lo = paid.length ? Math.min(...paid.map(per1k)) : 0.1, hi = paid.length ? Math.max(...paid.map(per1k)) : 1;
  const xmin = Math.pow(10, Math.floor(Math.log10(lo))), xmax = Math.pow(10, Math.ceil(Math.log10(hi)));
  const x0 = M.l + freeW + 14, x1 = W - M.r, L = (v) => (Math.log10(v) - Math.log10(xmin)) / (Math.log10(xmax) - Math.log10(xmin) || 1);
  const xs = (r) => (r.cost === 0 ? M.l + freeW / 2 : x0 + L(per1k(r)) * (x1 - x0));
  const jmin = Math.max(0, Math.floor(Math.min(...rows.map((r) => r.j)) * 10) / 10 - 0.05);
  const ys = (j) => M.t + (1 - (j - jmin) / (1 - jmin)) * (H - M.t - M.b);
  const svg = svgEl('svg', { viewBox: `0 0 ${W} ${H}`, role: 'img', 'aria-label': `${m.name}: J versus cost per 1,000 reviews` });
  svg.append(svgEl('rect', { class: 'band', x: M.l, y: M.t, width: freeW, height: H - M.t - M.b, rx: 4 }));
  for (let j = Math.ceil(jmin * 10) / 10; j <= 1.0001; j += 0.1) { const y = ys(j);
    svg.append(svgEl('line', { class: 'grid', x1: M.l, x2: x1, y1: y, y2: y }));
    const t = svgEl('text', { x: M.l - 8, y: y + 4, 'text-anchor': 'end' }); t.textContent = Math.round(j * 100) + '%'; svg.append(t); }
  for (let v = xmin; v <= xmax * 1.0001; v *= 10) { const x = x0 + L(v) * (x1 - x0);
    const t = svgEl('text', { x, y: H - M.b + 17, 'text-anchor': 'middle' }); t.textContent = '$' + (v < 1 ? v.toFixed(v < 0.1 ? 2 : 1) : v.toFixed(0)); svg.append(t); }
  const tf = svgEl('text', { x: M.l + freeW / 2, y: H - M.b + 17, 'text-anchor': 'middle' }); tf.textContent = 'free'; svg.append(tf);
  svg.append(svgEl('line', { class: 'axis', x1: M.l, x2: x1, y1: H - M.b, y2: H - M.b }));
  const xl = svgEl('text', { x: (x0 + x1) / 2, y: H - 8, 'text-anchor': 'middle' }); xl.textContent = 'Cost per 1,000 reviews (log scale)'; svg.append(xl);
  const front = pareto(rows);
  if (front.length > 1) { let d = ''; front.forEach((r, i) => { d += i === 0 ? `M${xs(r)},${ys(r.j)}` : `H${xs(r)}V${ys(r.j)}`; }); svg.append(svgEl('path', { class: 'front', d })); }
  const tip = el('div', { class: 'tip', hidden: '' }); const placed = [];
  for (const r of [...rows].sort((a, b) => b.j - a.j)) {
    const x = xs(r), y = ys(r.j), onF = front.includes(r);
    const c = svgEl('circle', { cx: x, cy: y, r: onF ? 6 : 4.5, tabindex: 0, style: `fill:${col(r.type)};stroke:${onF ? 'var(--frontier)' : '#fff'};stroke-width:${onF ? 2 : 1.5};cursor:pointer` });
    const show = () => { tip.hidden = false; tip.replaceChildren(el('b', { text: r.tool }), `J ${pct(r.j)} · TPR ${pct(r.catch)} · FPR ${pct(r.fa)}`, el('br'), r.cost === 0 ? 'Free: $0' : `Cost: ${money(r.cost / m.n * 1000)} per 1,000 reviews`, el('br'), r.cost === 0 ? '' : `(our run: ${money(r.cost)} for ${m.n} reviews)`);
      const s = box.clientWidth / W; let left = x * s + 12; if (left + 230 > box.clientWidth) left = x * s - 242; tip.style.left = Math.max(0, left) + 'px'; tip.style.top = Math.max(0, y * s - 10) + 'px'; };
    c.addEventListener('mouseenter', show); c.addEventListener('focus', show);
    c.addEventListener('mouseleave', () => (tip.hidden = true)); c.addEventListener('blur', () => (tip.hidden = true));
    svg.append(c);
    if (!narrow || onF) {
      const short = r.tool.replace(', asked directly', '').replace(/ \(deepseek\)$/, '').replace(' on one RTX 4090', ' (4090)');
      const label = svgEl('text', { class: 'lbl' }); label.textContent = short; svg.append(label);
      const w = short.length * 6.3; let lx = x + 9, anchor = 'start'; if (lx + w > W - 2) { lx = x - 9; anchor = 'end'; }
      let ly = y + 4; const span = () => (anchor === 'start' ? [lx, lx + w] : [lx - w, lx]);
      for (let k = 0; k < 8 && placed.some((p) => { const [a, b] = span(); return a < p.b && b > p.a && Math.abs(ly - p.y) < 13; }); k++) ly += 13;
      label.setAttribute('x', lx); label.setAttribute('y', ly); label.setAttribute('text-anchor', anchor); const [a, b] = span(); placed.push({ a, b, y: ly });
    }
  }
  box.append(svg, tip);
  const types = [...new Set(rows.map((r) => r.type))];
  document.getElementById('lb-legend').replaceChildren(...types.map((t) => el('span', {}, el('i', { style: `background:${col(t)}` }), TYPE_LABEL[t])),
    el('span', {}, el('i', { class: 'fl' }), 'Pareto frontier'));
}

function renderOverview() {
  const short = (t) => t.replace(', asked directly', '').split(' (')[0].split(':')[0];
  const fill = (j) => `color-mix(in srgb, #1f3a93 ${Math.round(Math.max(0, j) * 85)}%, transparent)`;
  const head = el('thead', {}, el('tr', {}, el('th', { text: 'Reviewer' }),
    OV.modes.map((m) => el('th', { class: 'mcol' }, el('button', { type: 'button', class: 'mlink', text: m.name, 'data-id': m.id }))),
    el('th', { class: 'num', 'data-tip': 'Mean J over the modes the tool ran (number of modes in brackets)' }, 'Average')));
  const body = OV.rows.map((r) => el('tr', {},
    el('td', { class: 'rname' }, el('i', { class: 'dot', style: `background:${col(r.type)}` }), r.tool),
    OV.modes.map((m) => { const c = r.cells[m.id];
      if (!c) return el('td', { class: 'na', 'data-tip': 'not run on this mode', text: '·' });
      return el('td', { class: 'cell' + (c.j < 0.05 ? ' low' : ''), style: `background:${fill(c.j)};${c.j > 0.55 ? 'color:#fff' : ''}`,
        'data-tip': `${m.name} · ${c.tool}: J ${pct(c.j)}, FPR ${pct(c.fa)}, ` + (c.cost1k === 0 ? 'free' : `${money(c.cost1k)} per 1,000 reviews`), text: Math.round(c.j * 100) + '%' }); }),
    el('td', { class: 'num avg' }, `${Math.round(r.avg * 100)}%`, el('span', { class: 'nm', text: ` (${r.n_modes})` }))));
  const best = el('tr', { class: 'best' }, el('td', {}, el('b', { text: 'Best in this mode' })),
    OV.modes.map((m) => { const b = OV.best[m.id];
      return el('td', { class: 'cell', 'data-tip': `${b.tool}: J ${pct(b.j)}` }, el('b', { text: Math.round(b.j * 100) + '%' }), el('br'), b.short || short(b.tool)); }),
    el('td', {}));
  document.getElementById('lb-ov-table').replaceChildren(head, el('tbody', {}, body, best));
  document.querySelectorAll('#lb-ov-table .mlink').forEach((b) => b.addEventListener('click', () => go(b.dataset.id)));
  document.getElementById('lb-ov-legend').replaceChildren(
    ...[...new Set(OV.rows.map((r) => r.type))].map((t) => el('span', {}, el('i', { style: `background:${col(t)}` }), TYPE_LABEL[t])),
    el('span', { text: 'Darker cell = higher J · “·” = not run' }));
  document.getElementById('lb-ov-findings').replaceChildren(...OV.findings.map(([lead, rest]) => el('li', {}, el('b', { text: lead }), rest)));
  document.getElementById('lb-ov-caveats').replaceChildren(...OV.caveats.map((c) => el('li', { text: c })));
}

const OV_DEFAULT_OFF = ['security', 'incomplete_execution'];
const ovSel = new Set(OV ? (() => { const saved = load('ovModes', null); const ids = OV.modes.map((m) => m.id);
  return Array.isArray(saved) ? saved.filter((id) => ids.includes(id)) : ids.filter((id) => !OV_DEFAULT_OFF.includes(id)); })() : []);
function renderOvModes() {
  const box = document.getElementById('lb-ov-modes');
  box.replaceChildren(...OV.modes.map((m) => { const cb = el('input', { type: 'checkbox', value: m.id });
    cb.checked = ovSel.has(m.id);
    cb.addEventListener('change', () => { if (cb.checked) ovSel.add(m.id); else ovSel.delete(m.id); store('ovModes', [...ovSel]); renderOvChart(); });
    return el('label', {}, cb, m.name); }));
}
function renderOvChart() {
  const BLUE = '#1f3a93';
  const box = document.getElementById('lb-ov-chart'); box.replaceChildren();
  const sel = OV.modes.map((m) => m.id).filter((id) => ovSel.has(id));
  if (!sel.length) { box.append(el('p', { class: 'fine', text: 'Check at least one failure mode to draw the chart.' })); return; }
  const mean = (xs) => xs.reduce((a, b) => a + b, 0) / xs.length;
  const rows = OV.rows.map((r) => { const cs = sel.map((id) => r.cells[id]).filter(Boolean);
    return cs.length ? { ...r, j: mean(cs.map((c) => c.j)), c: mean(cs.map((c) => c.cost1k)), n: cs.length } : null; }).filter(Boolean);
  if (!rows.length) { box.append(el('p', { class: 'fine', text: 'No reviewer in the grid ran on the checked modes.' })); return; }
  const W = Math.max(320, box.clientWidth), H = Math.round(Math.min(420, Math.max(280, W * 0.48)));
  const narrow = W < 560, M = { l: 46, r: 16, t: 12, b: 44 }, freeW = 54;
  const paid = rows.filter((r) => r.c > 0);
  const lo = paid.length ? Math.min(...paid.map((r) => r.c)) : 0.1, hi = paid.length ? Math.max(...paid.map((r) => r.c)) : 1;
  const xmin = Math.pow(10, Math.floor(Math.log10(lo))), xmax = Math.pow(10, Math.ceil(Math.log10(hi)));
  const x0 = M.l + freeW + 14, x1 = W - M.r, L = (v) => (Math.log10(v) - Math.log10(xmin)) / (Math.log10(xmax) - Math.log10(xmin) || 1);
  const xs = (r) => (r.c === 0 ? M.l + freeW / 2 : x0 + L(r.c) * (x1 - x0));
  const jlo = Math.max(0, Math.floor(Math.min(...rows.map((r) => r.j)) * 10) / 10), jhi = Math.min(1, Math.ceil(Math.max(...rows.map((r) => r.j)) * 10) / 10 + 0.05);
  const ys = (j) => M.t + (1 - (j - jlo) / (jhi - jlo)) * (H - M.t - M.b);
  const shade = (j) => `color-mix(in srgb, ${BLUE} ${Math.round(Math.max(0, j) * 85)}%, #fff)`;
  const svg = svgEl('svg', { viewBox: `0 0 ${W} ${H}`, role: 'img', 'aria-label': 'Average J versus average cost per 1,000 reviews for each reviewer, with the Pareto frontier' });
  svg.append(svgEl('rect', { class: 'band', x: M.l, y: M.t, width: freeW, height: H - M.t - M.b, rx: 4 }));
  for (let j = Math.ceil(jlo * 10) / 10; j <= jhi + 0.0001; j += 0.1) { const y = ys(j);
    svg.append(svgEl('line', { class: 'grid', x1: M.l, x2: x1, y1: y, y2: y }));
    const t = svgEl('text', { x: M.l - 8, y: y + 4, 'text-anchor': 'end' }); t.textContent = Math.round(j * 100) + '%'; svg.append(t); }
  for (let v = xmin; v <= xmax * 1.0001; v *= 10) { const x = x0 + L(v) * (x1 - x0);
    const t = svgEl('text', { x, y: H - M.b + 17, 'text-anchor': 'middle' }); t.textContent = '$' + (v < 1 ? v.toFixed(v < 0.1 ? 2 : 1) : v.toFixed(0)); svg.append(t); }
  const tf = svgEl('text', { x: M.l + freeW / 2, y: H - M.b + 17, 'text-anchor': 'middle' }); tf.textContent = 'free'; svg.append(tf);
  svg.append(svgEl('line', { class: 'axis', x1: M.l, x2: x1, y1: H - M.b, y2: H - M.b }));
  const xl = svgEl('text', { x: (x0 + x1) / 2, y: H - 8, 'text-anchor': 'middle' }); xl.textContent = 'Average cost per 1,000 reviews (log scale)'; svg.append(xl);
  const yl = svgEl('text', { x: 12, y: (M.t + H - M.b) / 2, transform: `rotate(-90 12 ${(M.t + H - M.b) / 2})`, 'text-anchor': 'middle' }); yl.textContent = 'Average J'; svg.append(yl);
  const front = rows.filter((r) => !rows.some((o) => o !== r && o.c <= r.c && o.j > r.j)).sort((a, b) => a.c - b.c);
  if (front.length > 1) { let d = ''; front.forEach((r, i) => { d += i === 0 ? `M${xs(r)},${ys(r.j)}` : `H${xs(r)}V${ys(r.j)}`; });
    svg.append(svgEl('path', { d, fill: 'none', stroke: BLUE, 'stroke-width': 2, 'stroke-dasharray': '5 4', opacity: 0.7 })); }
  const tip = el('div', { class: 'tip', hidden: '' }); const placed = [];
  for (const r of [...rows].sort((a, b) => b.j - a.j)) {
    const x = xs(r), y = ys(r.j), onF = front.includes(r);
    const c = svgEl('circle', { cx: x, cy: y, r: onF ? 7 : 5.5, tabindex: 0, style: `fill:${shade(r.j)};stroke:${BLUE};stroke-width:${onF ? 2.5 : 1.25};cursor:pointer` });
    const show = () => { tip.hidden = false; tip.replaceChildren(el('b', { text: r.tool }), `Average J ${pct(r.j)} over ${r.n} of the ${sel.length} checked mode${sel.length === 1 ? '' : 's'}`, el('br'),
        r.c === 0 ? 'Free: $0' : `Average cost: ${money(r.c)} per 1,000 reviews`, el('br'), onF ? 'On the frontier' : '');
      const s = box.clientWidth / W; let left = x * s + 12; if (left + 230 > box.clientWidth) left = x * s - 242; tip.style.left = Math.max(0, left) + 'px'; tip.style.top = Math.max(0, y * s - 10) + 'px'; };
    c.addEventListener('mouseenter', show); c.addEventListener('focus', show);
    c.addEventListener('mouseleave', () => (tip.hidden = true)); c.addEventListener('blur', () => (tip.hidden = true));
    svg.append(c);
    if (!narrow || onF) {
      const short = r.tool + (r.n < sel.length ? ` (${r.n} of ${sel.length})` : '');
      const label = svgEl('text', { class: 'lbl' }); label.textContent = short; svg.append(label);
      const w = short.length * 6.3; let lx = x + 10, anchor = 'start'; if (lx + w > W - 2) { lx = x - 10; anchor = 'end'; }
      let ly = y + 4; const span = () => (anchor === 'start' ? [lx, lx + w] : [lx - w, lx]);
      for (let k = 0; k < 8 && placed.some((p) => { const [a, b] = span(); return a < p.b && b > p.a && Math.abs(ly - p.y) < 13; }); k++) ly += 13;
      label.setAttribute('x', lx); label.setAttribute('y', ly); label.setAttribute('text-anchor', anchor); const [a, b] = span(); placed.push({ a, b, y: ly });
    }
  }
  box.append(svg, tip);
}

function render() {
  const ov = state.mode === 'overview';
  document.querySelectorAll('#lb-tabs button').forEach((b) => b.setAttribute('aria-selected', String(b.dataset.id === state.mode)));
  document.getElementById('lb-ov').hidden = !ov;
  document.getElementById('lb-mode').hidden = ov;
  if (ov) { renderOvChart(); return; }
  const m = DATA.find((d) => d.id === state.mode);
  renderTable(m); renderChart(m);
}
function go(id) { state.mode = id; history.replaceState(null, '', '#' + id); render(); }
const tabs = document.getElementById('lb-tabs');
const tabDefs = (OV ? [{ id: 'overview', name: 'Overview' }] : []).concat(DATA);
tabDefs.forEach((m) => { const b = el('button', { role: 'tab', type: 'button', 'data-id': m.id, text: m.name }); b.addEventListener('click', () => go(m.id)); tabs.append(b); });
if (OV) { renderOverview(); renderOvModes(); }
document.querySelectorAll('#lb-table .sort').forEach((b) => b.addEventListener('click', () => { state.key = b.dataset.k; render(); }));
const cs = document.getElementById('lb-stars'); cs.checked = state.stars;
const typesBox = document.getElementById('lb-types');
const allBtn = el('button', { type: 'button', class: 'chip', text: 'All types' });
allBtn.addEventListener('click', () => { state.types = new Set(ALL_TYPES); syncTypes(); });
typesBox.append(allBtn);
ALL_TYPES.forEach((t) => { const b = el('button', { type: 'button', class: 'chip', 'data-t': t }, el('i', { style: `background:${col(t)}` }), TYPE_LABEL[t]);
  b.addEventListener('click', () => { if (state.types.size === ALL_TYPES.length) state.types = new Set([t]); else if (state.types.has(t)) { state.types.delete(t); if (!state.types.size) state.types = new Set(ALL_TYPES); } else state.types.add(t); syncTypes(); });
  typesBox.append(b); });
function syncTypes() { typesBox.querySelectorAll('.chip[data-t]').forEach((b) => b.setAttribute('aria-pressed', String(state.types.has(b.dataset.t) && state.types.size < ALL_TYPES.length)));
  allBtn.setAttribute('aria-pressed', String(state.types.size === ALL_TYPES.length)); store('types', [...state.types]); render(); }
cs.addEventListener('change', () => { state.stars = cs.checked; store('stars', cs.checked); render(); });
const h = location.hash.slice(1); if (DATA.some((d) => d.id === h) || (OV && h === 'overview')) state.mode = h;
let rt; window.addEventListener('resize', () => { clearTimeout(rt); rt = setTimeout(render, 100); });
syncTypes();
</script>

