---
// SAICA-Bench home: the leaderboard. Data: /bench/results.json (bench/build_report.py), read through
// components/home/bench.ts. Every panel is rendered once, here, at build time: an Overview (first finding,
// reviewer x mode grid in one block per provenance group, the any-flag estimate, findings, caveats), one panel
// per measured failure mode (facts, the results table with run cards, a J-versus-cost chart) and one per mode
// that is not benchmarked (catalog tools by GitHub stars). The script at the bottom only switches panels, sorts
// the static rows and draws the chart from a slim data island; it renders no table.
//
// There is no average over modes, no ordering of modes by score and no "best" taken from the first row:
// who is best in a mode is what the file says (a winner, a top group, or nobody under the floor).
import BaseLayout from '../layouts/BaseLayout.astro';
import ModeFacts from '../components/bench/ModeFacts.astro';
import OverviewGrid from '../components/bench/OverviewGrid.astro';
import ResultsTable from '../components/bench/ResultsTable.astro';
import UnionEstimate from '../components/bench/UnionEstimate.astro';
import {
  AUTHOR, CAVEATS, CITE_AS, COUNTS, FINDINGS, GENERATED_LONG, GROUPS, METHOD, MISSING_MODES, MODES, PARTIAL, STAR_MODES,
  TYPE_LABEL, TYPE_VAR, UNION,
  modeLinks, rankedRows, toolPage, unrankedRows,
} from '../components/home/bench';
import { KG_TO_BENCH, SITE_NAME, abs, fmUrl, jsonLd } from '../lib/seo';
import { andList, int } from '../lib/format';

const title = 'SAICA-Bench: AI Code Review Benchmark for Coding Agent Failures';
const description =
  `What do LLMs, AI code reviewers and free tools flag in the work of AI coding agents? ${COUNTS.modes} failure modes, ` +
  `${int(COUNTS.ranked_rows)} ranked rows, ${int(COUNTS.samples)} labelled samples; ${COUNTS.agent_output} of the sets are real agent output.`;
const jsonld = [
  { '@context': 'https://schema.org', '@type': 'WebSite', name: SITE_NAME, url: abs('/'), description, inLanguage: 'en', creator: AUTHOR },
  {
    '@context': 'https://schema.org',
    '@type': 'ItemList',
    name: 'Failure modes of AI coding agents measured on SAICA-Bench',
    numberOfItems: MODES.length,
    itemListElement: MODES.map((m, i) => ({ '@type': 'ListItem', position: i + 1, name: m.name, url: abs(modeLinks(m).page) })),
  },
];
const lead = FINDINGS[0];

// What the script needs to draw one mode's chart: a slim copy of the rows (no run cards, strata, tables, notes).
const chartData = {
  alias: KG_TO_BENCH,
  typeLabel: TYPE_LABEL,
  modes: Object.fromEntries(
    MODES.map((m) => [
      m.id,
      {
        title: m.title,
        rows: m.rows.map((r) => ({
          short: r.short,
          type: r.type,
          ranked: r.ranked,
          top: !m.below_floor && m.top_group.includes(r.key),
          j: r.j,
          lo: r.j_ci[0],
          hi: r.j_ci[1],
          cost: r.cost1k,
          est: r.cost_estimated,
        })),
      },
    ]),
  ),
};
const MECH: Record<string, string> = { detects: 'Detects', prevents: 'Prevents', records: 'Records only' };
const fin = (v: unknown) => (v === true ? 'yes' : v === false ? 'no' : 'unclear');
---

<BaseLayout title={title} rawTitle description={description} jsonld={jsonld}>
  <div class="lb">
    <h1>Leaderboard</h1>
    <p class="tagline">What do reviewers flag in the work of AI coding agents?</p>
    <p class="byline">Vasyl Rakivnenko, Stanford University · {CITE_AS}, built {GENERATED_LONG}</p>
    <p class="lead">{METHOD.metric}</p>
    <p class="lead"><b>The setting:</b> {METHOD.setting}</p>
    {PARTIAL && <p class="lead warn">This is a partial build of the results: {MISSING_MODES.length ? andList(MISSING_MODES) : 'some modes'} are missing. Do not cite it.</p>}

    <div class="tabs" role="tablist" id="lb-tabs" aria-label="Overview and one tab per failure mode">
      <button role="tab" type="button" id="lb-tab-overview" data-id="overview" aria-controls="lb-panel-overview" aria-selected="true">Overview</button>
      {GROUPS.map((g) => (
        <>
          <span class="tab-group" role="presentation">{g.label}:</span>
          {g.list.map((m) => (
            <button role="tab" type="button" id={`lb-tab-${m.id}`} data-id={m.id} aria-controls={`lb-panel-${m.id}`} aria-selected="false" tabindex="-1">{m.name}</button>
          ))}
        </>
      ))}
      {STAR_MODES.length > 0 && <span class="tab-group" role="presentation">Not benchmarked:</span>}
      {STAR_MODES.map((m) => (
        <button role="tab" type="button" id={`lb-tab-${m.id}`} data-id={m.id} aria-controls={`lb-panel-${m.id}`} aria-selected="false" tabindex="-1">{m.name}</button>
      ))}
    </div>

    <section class="panel" role="tabpanel" id="lb-panel-overview" aria-labelledby="lb-tab-overview" data-panel="overview">
      {lead && <p class="first" data-lead-finding><b>{lead[0]}</b>{lead[1]}</p>}

      <h2>Reviewer by failure mode, one block per kind of set</h2>
      <p class="fine">
        J for each reviewer that ran on several failure modes, with its 95% interval. The blocks are not comparable
        with each other and no average over modes is shown: where the bad samples of a set come from explains most of
        the difference between sets. A mode's name opens its tab.
      </p>
      <OverviewGrid />

      {UNION && (
        <>
          <h2>If the prompt of every mode ran on every change</h2>
          <p class="fine">
            Each cell above is the answer to one question about one failure. In use every question would run on every
            change. This table estimates what that does to false alarms; it was not measured.
          </p>
          <UnionEstimate />
        </>
      )}

      <h2>What the results say</h2>
      <ul class="findings">{FINDINGS.map(([head, rest]) => <li><b>{head}</b>{rest}</li>)}</ul>
      <h2>Read before citing</h2>
      <ul class="ov-caveats">{CAVEATS.map((c) => <li>{c}</li>)}</ul>
      <p class="fine"><a href="/benchmark/#threats">Threats to validity, with what was measured and what was not →</a></p>
    </section>

    {MODES.map((m) => (
      <section class="panel" role="tabpanel" id={`lb-panel-${m.id}`} aria-labelledby={`lb-tab-${m.id}`} data-panel={m.id} hidden>
        <h2 class="mode-h">{m.title}{m.title !== m.name && <span class="fm"> · failure mode: {m.name}</span>}</h2>
        <p class="fine">{m.summary} Data: {m.dataset}.</p>
        <ModeFacts m={m} />
        <ResultsTable m={m} />
        <h3>J against cost</h3>
        <p class="fine">
          Each point is one row: J with its 95% interval (the vertical line) against cost per 1,000 reviews. Filled
          points are ranked reviewers, hollow ones are reference rows. Overlapping intervals mean the rows cannot be
          told apart by this picture; the table marks the top group.
        </p>
        <div class="chart" data-chart={m.id} role="img" aria-label={`${m.title}: J with 95% interval against cost per 1,000 reviews, ${rankedRows(m).length} ranked rows and ${unrankedRows(m).length} reference rows`}></div>
        <p class="more"><a href={modeLinks(m).page}>About {m.name.toLowerCase()}, with parts of this set scored apart →</a> · <a href={modeLinks(m).method}>How this set was built →</a> · <a href="/benchmark/#threats">Threats to validity →</a></p>
      </section>
    ))}

    {STAR_MODES.map((m) => (
      <section class="panel" role="tabpanel" id={`lb-panel-${m.id}`} aria-labelledby={`lb-tab-${m.id}`} data-panel={m.id} hidden>
        <h2 class="mode-h">{m.name}</h2>
        <p class="fine">
          Not benchmarked yet: no public dataset with confirmed labels exists for {m.name.toLowerCase()}, so these are
          the SAICA catalog's tools tagged for it, by GitHub stars. Stars measure popularity, not what a tool
          catches, and a tag is the catalog's claim, not a test result. {m.description}
          {' '}<a href={fmUrl(m.id)}>About {m.name.toLowerCase()} →</a>
        </p>
        <div class="tbl-wrap">
          <table class="lb-star">
            <thead>
              <tr><th scope="col">Tool</th><th scope="col">How it addresses this</th><th scope="col">Mechanism</th><th scope="col">Checks a finished change</th><th scope="col" class="num">Stars</th></tr>
            </thead>
            <tbody>
              {[...m.tools].sort((a, b) => (b.stars ?? 0) - (a.stars ?? 0)).map((t) => {
                const href = toolPage(t.id) ?? t.repository_url ?? null;
                return (
                  <tr>
                    <th scope="row">{href ? <a href={href}>{t.name}</a> : t.name}</th>
                    <td class="how">{t.how}</td>
                    <td>{MECH[t.mechanism ?? ''] ?? t.mechanism}</td>
                    <td>{fin(t.runs_on_finished_change)}</td>
                    <td class="num">{t.stars ? int(t.stars) : '—'}{t.stars_updated_at && <span class="sub">as of {t.stars_updated_at}</span>}</td>
                  </tr>
                );
              })}
            </tbody>
          </table>
        </div>
        <p class="fine">Detects = flags it after the fact; prevents = stops it during a run; records only = keeps traces a person could inspect. {m.note}</p>
      </section>
    ))}

    <p class="legend">{Object.entries(TYPE_LABEL).filter(([t]) => MODES.some((m) => m.rows.some((r) => r.type === t))).map(([t, label]) => <span><i style={`background:var(${TYPE_VAR[t] ?? '--t-base'})`}></i>{label}</span>)}</p>
    <p class="more"><a href="/benchmark/">How each failure mode is tested →</a> · <a href="/findings/">Findings report →</a> · <a href="/graph/">Knowledge graph of supervision tools →</a></p>
  </div>
  <script type="application/json" id="lb-data" set:html={jsonLd(chartData)} />
</BaseLayout>

<script>
  import { money, signedPct } from '../lib/format';

  interface ChartRow { short: string; type: string; ranked: boolean; top: boolean; j: number; lo: number; hi: number; cost: number; est: boolean }
  interface Data { alias: Record<string, string>; typeLabel: Record<string, string>; modes: Record<string, { title: string; rows: ChartRow[] }> }
  const DATA = JSON.parse(document.getElementById('lb-data')?.textContent ?? '{}') as Data;
  const TYPE_VAR: Record<string, string> = { deterministic: '--t-free', llm_based: '--t-ai', hybrid: '--t-hybrid', prompt_artifact: '--t-skill', baseline_model: '--t-base', baseline_rule: '--t-rule' };

  const tabs = document.getElementById('lb-tabs') as HTMLElement;
  const buttons = Array.from(tabs.querySelectorAll<HTMLButtonElement>('button[role="tab"]'));
  const panels = Array.from(document.querySelectorAll<HTMLElement>('.lb .panel'));
  const valid = (id: string) => buttons.some((b) => b.dataset.id === id);
  // A tab also answers to the knowledge-graph id of its failure mode (#test_manipulation, #security_vulnerability).
  const tabFor = (id: string): string | null => (valid(id) ? id : valid(DATA.alias?.[id] ?? '') ? DATA.alias[id] : null);
  let current = 'overview';

  function show(id: string): void {
    current = id;
    for (const b of buttons) {
      const on = b.dataset.id === id;
      b.setAttribute('aria-selected', String(on));
      b.tabIndex = on ? 0 : -1;
    }
    for (const p of panels) p.hidden = p.dataset.panel !== id;
    const active = buttons.find((b) => b.dataset.id === id);
    if (active && tabs.scrollWidth > tabs.clientWidth) active.scrollIntoView({ block: 'nearest', inline: 'center' });
    draw(id);
  }
  function go(id: string): void {
    history.replaceState(null, '', '#' + id);
    show(id);
  }
  for (const b of buttons) b.addEventListener('click', () => go(b.dataset.id ?? 'overview'));
  // Keyboard: arrow keys / Home / End move between tabs (WAI-ARIA tabs pattern).
  tabs.addEventListener('keydown', (e) => {
    const i = buttons.indexOf(document.activeElement as HTMLButtonElement);
    if (i < 0) return;
    const n = ({ ArrowRight: i + 1, ArrowLeft: i - 1, Home: 0, End: buttons.length - 1 } as Record<string, number>)[e.key];
    if (n === undefined) return;
    e.preventDefault();
    const b = buttons[(n + buttons.length) % buttons.length];
    go(b.dataset.id ?? 'overview');
    b.focus();
  });
  window.addEventListener('hashchange', () => {
    const id = tabFor(location.hash.slice(1));
    if (id && id !== current) { show(id); tabs.scrollIntoView({ block: 'start' }); }
  });

  // Sorting: reorder the static rows of a ranked table by the clicked column. The rank column keeps the file's rank.
  document.querySelectorAll<HTMLTableElement>('.lb table[data-rt="ranked"]').forEach((table) => {
    const body = table.tBodies[0];
    table.querySelectorAll<HTMLButtonElement>('.rt-sort').forEach((btn) => {
      btn.addEventListener('click', () => {
        const k = btn.dataset.k ?? 'j';
        const asc = k === 'fpr' || k === 'cost';
        const rows = Array.from(body.rows).sort((a, b) => {
          const d = Number(a.dataset[k]) - Number(b.dataset[k]);
          return asc ? d : -d;
        });
        rows.forEach((r) => body.appendChild(r));
        table.querySelectorAll('.rt-sort').forEach((o) => o.setAttribute('aria-pressed', String(o === btn)));
      });
    });
  });

  // Chart of one mode: J with its 95% interval against cost per 1,000 reviews (log scale; free rows in a band).
  const NS = 'http://www.w3.org/2000/svg';
  const svgEl = (tag: string, attrs: Record<string, string | number>): SVGElement => {
    const e = document.createElementNS(NS, tag);
    for (const [k, v] of Object.entries(attrs)) e.setAttribute(k, String(v));
    return e;
  };
  function draw(id: string): void {
    const box = document.querySelector<HTMLElement>(`.lb .chart[data-chart="${CSS.escape(id)}"]`);
    const mode = DATA.modes?.[id];
    if (!box || !mode) return;
    box.replaceChildren();
    const rows = mode.rows;
    const W = Math.max(320, box.clientWidth), H = Math.round(Math.min(420, Math.max(280, W * 0.46)));
    const M = { l: 48, r: 14, t: 12, b: 44 }, freeW = 56;
    const paid = rows.filter((r) => r.cost > 0);
    const lo = paid.length ? Math.min(...paid.map((r) => r.cost)) : 0.1, hi = paid.length ? Math.max(...paid.map((r) => r.cost)) : 1;
    const xmin = Math.pow(10, Math.floor(Math.log10(lo))), xmax = Math.pow(10, Math.ceil(Math.log10(hi) + 1e-9));
    const x0 = M.l + freeW + 14, x1 = W - M.r;
    const L = (v: number) => (Math.log10(v) - Math.log10(xmin)) / (Math.log10(xmax) - Math.log10(xmin) || 1);
    const xs = (r: ChartRow) => (r.cost === 0 ? M.l + freeW / 2 : x0 + L(r.cost) * (x1 - x0));
    const jmin = Math.max(-1, Math.floor(Math.min(0, ...rows.map((r) => r.lo)) * 10) / 10);
    const ys = (j: number) => M.t + (1 - (j - jmin) / (1 - jmin)) * (H - M.t - M.b);
    const svg = svgEl('svg', { viewBox: `0 0 ${W} ${H}`, 'aria-hidden': 'true' });
    svg.append(svgEl('rect', { class: 'band', x: M.l, y: M.t, width: freeW, height: H - M.t - M.b, rx: 4 }));
    for (let j = Math.ceil(jmin * 10) / 10; j <= 1.0001; j += 0.1) {
      const y = ys(j);
      svg.append(svgEl('line', { class: Math.abs(j) < 1e-9 ? 'axis' : 'grid', x1: M.l, x2: x1, y1: y, y2: y }));
      const t = svgEl('text', { x: M.l - 8, y: y + 4, 'text-anchor': 'end' });
      t.textContent = signedPct(j, 0);
      svg.append(t);
    }
    for (let v = xmin; v <= xmax * 1.0001; v *= 10) {
      const t = svgEl('text', { x: x0 + L(v) * (x1 - x0), y: H - M.b + 17, 'text-anchor': 'middle' });
      t.textContent = '$' + (v < 1 ? v.toFixed(v < 0.1 ? 2 : 1) : v.toFixed(0));
      svg.append(t);
    }
    const tf = svgEl('text', { x: M.l + freeW / 2, y: H - M.b + 17, 'text-anchor': 'middle' });
    tf.textContent = 'free';
    svg.append(tf);
    const xl = svgEl('text', { x: (x0 + x1) / 2, y: H - 8, 'text-anchor': 'middle' });
    xl.textContent = 'Cost per 1,000 reviews (log scale)';
    svg.append(xl);
    const tip = document.createElement('div');
    tip.className = 'tip';
    tip.hidden = true;
    for (const r of [...rows].sort((a, b) => Number(a.ranked) - Number(b.ranked) || a.j - b.j)) {
      const x = xs(r), y = ys(r.j), colour = `var(${TYPE_VAR[r.type] ?? '--t-base'})`;
      svg.append(svgEl('line', { x1: x, x2: x, y1: ys(r.hi), y2: ys(r.lo), style: `stroke:${colour};stroke-width:1.5;opacity:${r.ranked ? 0.55 : 0.3}` }));
      const c = svgEl('circle', { cx: x, cy: y, r: r.top ? 6 : 4.5, tabindex: 0, style: `fill:${r.ranked ? colour : '#fff'};stroke:${colour};stroke-width:${r.top ? 2.5 : 1.5};cursor:pointer` });
      const open = () => {
        tip.hidden = false;
        const b = document.createElement('b');
        b.textContent = r.short;
        tip.replaceChildren(b, `J ${signedPct(r.j)} (95% interval ${signedPct(r.lo)} to ${signedPct(r.hi)})`, document.createElement('br'),
          r.cost === 0 ? 'Free' : `${money(r.cost, r.est)} per 1,000 reviews`, document.createElement('br'),
          `${DATA.typeLabel?.[r.type] ?? r.type}${r.ranked ? (r.top ? ' · in the top group' : '') : ' · not ranked'}`);
        const s = box.clientWidth / W;
        let left = x * s + 12;
        if (left + 240 > box.clientWidth) left = x * s - 252;
        tip.style.left = Math.max(0, left) + 'px';
        tip.style.top = Math.max(0, y * s - 10) + 'px';
      };
      const close = () => { tip.hidden = true; };
      c.addEventListener('mouseenter', open);
      c.addEventListener('focus', open);
      c.addEventListener('mouseleave', close);
      c.addEventListener('blur', close);
      svg.append(c);
      if (r.top) {
        const right = x + 10 + r.short.length * 6.3 < x1;
        const label = svgEl('text', { class: 'lbl', x: right ? x + 10 : x - 10, y: y + 4, 'text-anchor': right ? 'start' : 'end' });
        label.textContent = r.short;
        svg.append(label);
      }
    }
    box.append(svg, tip);
  }

  const first = tabFor(location.hash.slice(1));
  if (first) show(first);
  let rt: number | undefined;
  window.addEventListener('resize', () => { clearTimeout(rt); rt = window.setTimeout(() => draw(current), 120); });
</script>

<style is:global>
  .lb { --t-free: #1f3a93; --t-ai: #8a3f9e; --t-hybrid: #b7791f; --t-skill: #3b7d4f; --t-base: #5f6676; --t-rule: #9a9fab; }
  .lb h1 { margin: 0; }
  .lb h2 { font-size: 1.15rem; margin-top: 2.2rem; }
  .lb h3 { font-size: 1rem; margin-top: 1.6rem; }
  .lb .mode-h { margin-top: .4rem; }
  .lb .mode-h .fm { font-weight: 400; font-size: 14px; color: #6b7180; }
  .lb .tagline { margin: .45rem 0 0; font: 500 18px/1.4 ui-sans-serif, system-ui, sans-serif; color: #111418; }
  .lb .byline { margin: .2rem 0 0; font: 14px/1.4 ui-sans-serif, system-ui, sans-serif; color: #6b7180; }
  .lb .lead { margin: .8rem 0 0; color: #4a5160; max-width: 90ch; font: 15px/1.55 ui-sans-serif, system-ui, sans-serif; text-align: left; }
  .lb .lead b { color: #111418; font-weight: 600; }
  .lb .lead.warn { border: 1px solid #b7791f; background: #fdf6e7; border-radius: 8px; padding: .5rem .7rem; }
  .lb .first { margin: 0 0 .4rem; max-width: 86ch; font: 15.5px/1.6 ui-sans-serif, system-ui, sans-serif; color: #111418; }
  /* sheet tabs (like a spreadsheet's): grey tabs with rounded tops on a baseline; the active tab is white, joins the
     baseline and has a blue top edge. Small labels name the provenance group of the tabs that follow. */
  .lb .tabs { position: relative; display: flex; flex-wrap: wrap; align-items: flex-end; gap: 3px; border-bottom: 1px solid rgb(17 20 24 / .15); margin: 1.4rem 0 .9rem; padding: 0 2px; font-family: ui-sans-serif, system-ui, sans-serif; }
  .lb .tabs button { background: #f3f1ec; border: 1px solid rgb(17 20 24 / .12); border-bottom: 0; border-top: 2px solid transparent; border-radius: 7px 7px 0 0; padding: .4rem .8rem .45rem; font-size: 14px; font-weight: 500; color: #4a5160; cursor: pointer; margin-bottom: -1px; line-height: 1.3; }
  .lb .tabs button:hover { background: #fff; color: #111418; }
  .lb .tabs button[aria-selected="true"] { background: #fff; color: #1f3a93; font-weight: 600; border-top-color: #1f3a93; position: relative; padding-bottom: calc(.45rem + 1px); }
  .lb .tabs button:focus-visible { outline: 2px solid #1f3a93; outline-offset: 2px; }
  .lb .tabs .tab-group { align-self: center; margin: 0 .15rem 0 .7rem; font-size: 11.5px; color: #6b7180; white-space: nowrap; }
  .lb .tbl-wrap { overflow-x: auto; padding-bottom: 4px; }
  .lb table.lb-star { width: 100%; border-collapse: collapse; font: 14px ui-sans-serif, system-ui, sans-serif; font-variant-numeric: tabular-nums; }
  .lb table.lb-star th, .lb table.lb-star td { text-align: left; padding: .5rem .6rem; border-bottom: 1px solid rgb(17 20 24 / .08); vertical-align: top; }
  .lb table.lb-star thead th { font-size: 12px; font-weight: 600; color: #4a5160; white-space: nowrap; }
  .lb table.lb-star tbody th { font-weight: 500; white-space: nowrap; }
  .lb table.lb-star .num { text-align: right; white-space: nowrap; }
  .lb table.lb-star .sub { display: block; font-size: 11px; color: #6b7180; }
  .lb table.lb-star td.how { min-width: 260px; max-width: 460px; color: #4a5160; font-size: 13px; line-height: 1.4; }
  .lb .fine { font: 13px/1.5 ui-sans-serif, system-ui, sans-serif; color: #6b7180; margin-top: .6rem; max-width: 86ch; }
  .lb .chart { position: relative; min-height: 280px; margin-top: .5rem; }
  .lb .chart svg { display: block; width: 100%; height: auto; overflow: visible; }
  .lb .chart text { font: 11.5px ui-sans-serif, system-ui, sans-serif; fill: #6b7180; }
  .lb .chart .lbl { fill: #111418; font-size: 12px; }
  .lb .chart .grid { stroke: rgb(17 20 24 / .08); }
  .lb .chart .axis { stroke: rgb(17 20 24 / .3); }
  .lb .chart .band { fill: #e4ebf7; }
  .lb .tip { position: absolute; pointer-events: none; background: #fff; border: 1px solid rgb(17 20 24 / .15); border-radius: 6px; padding: 6px 9px; font: 12.5px ui-sans-serif, system-ui, sans-serif; box-shadow: 0 6px 18px rgb(0 0 0 / .12); max-width: 240px; }
  .lb .tip b { display: block; }
  .lb .legend { display: flex; flex-wrap: wrap; gap: .3rem 1rem; font: 12.5px ui-sans-serif, system-ui, sans-serif; color: #4a5160; margin-top: 1.6rem; }
  .lb .legend span { display: inline-flex; align-items: center; gap: 6px; }
