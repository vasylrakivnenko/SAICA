---
// SAICA-Bench home: the leaderboard. Data: /bench/results.json, written by
// bench/build_report.py from each failure mode's results. An Overview tab (results.overview: reviewer x mode
// grid, quality-vs-cost chart, findings) and one tab per mode. The best-tool-per-mode table lives on /tools/.
import BaseLayout from '../layouts/BaseLayout.astro';
import { OVERVIEW as OV, MODES, CLASSIC as SUMMARIES, STAR_MODES, TYPE_LABEL, TYPE_VAR, THINKING_LABEL as OV_THINKING_LABEL, AUTHOR, FILE_ORDER, pct, money, toolPage } from '../components/home/bench';
import { SITE_NAME, abs, fmUrl } from '../lib/seo';

// SEO: the Overview tab (grid, legend, findings, caveats) is rendered here at build time,
// so the page has its results in static HTML; the inline script below re-renders them identically and adds the rest.
const hi = [...SUMMARIES].sort((a, b) => b.best.j - a.best.j);
const title = 'SAICA-Bench: AI Code Review Benchmark for Coding Agent Failures';
const description = `Which LLMs, AI code reviewers and free tools catch coding agent failures? Measured on ${MODES.length} failure modes: best J ${Math.round(hi[0].best.j * 100)}% on ${hi[0].m.name.toLowerCase()}, ${Math.round(hi[hi.length - 1].best.j * 100)}% on ${hi[hi.length - 1].m.name.toLowerCase()}.`;
const jsonld = [
  { '@context': 'https://schema.org', '@type': 'WebSite', name: SITE_NAME, url: abs('/'), description, inLanguage: 'en', creator: AUTHOR },
  {
    '@context': 'https://schema.org',
    '@type': 'ItemList',
    name: 'Failure modes of AI coding agents measured on SAICA-Bench',
    numberOfItems: SUMMARIES.length,
    itemListElement: SUMMARIES.map((s, i) => ({ '@type': 'ListItem', position: i + 1, name: s.m.name, url: abs(s.url) })),
  },
];

// Links the inline script cannot compute itself (it has no imports): failure-mode page per tab, tool page per catalog id
// (only ids the catalog has a page for), and the catalog id behind each Overview grid row (the grid carries names only).
const FM_URL = Object.fromEntries([...MODES, ...STAR_MODES].map((m) => [m.id, fmUrl(m.id)]));
const ids = new Set([...MODES.flatMap((m) => m.rows.map((r) => r.kg_id)), ...STAR_MODES.flatMap((m) => m.tools.map((t) => t.id))]);
const TOOL_URL = Object.fromEntries([...ids].map((id) => [id, toolPage(id)]).filter(([, u]) => u));
const OV_KG: Record<string, string> = {};
for (const r of OV.rows)
  for (const [mid, c] of Object.entries(r.cells)) {
    const kg = MODES.find((m) => m.id === mid)?.rows.find((x) => x.tool === c.tool)?.kg_id;
    if (kg && TOOL_URL[kg]) { OV_KG[r.tool] = kg; break; }
  }

// Static copy of the Overview grid: same markup and inline styles as renderOverview() in the script.
const short = (t: string) => t.replace(', zero-shot', '').split(' (')[0].split(':')[0];
const THINKING_LABEL: Record<string, string> = OV_THINKING_LABEL;
const thinkCell = (t?: string | null) => t ?? '—';
const fill = (j: number) => `color-mix(in srgb, #1f3a93 ${Math.round(Math.max(0, j) * 85)}%, transparent)`;
const col = (t: string) => `var(${TYPE_VAR[t]})`;
const cellTip = (name: string, c: { tool: string; j: number; fa: number; cost1k: number }) =>
  `${name} · ${c.tool}: J ${pct(c.j)}, FPR ${pct(c.fa)}, ` + (c.cost1k === 0 ? 'free' : `${money(c.cost1k)} per 1,000 reviews`);
const ovTypes = [...new Set(OV.rows.map((r) => r.type))];
const tieTip = (b: { tool: string; j: number; winner: boolean; top_group: string[] }) =>
  `${b.tool}: J ${pct(b.j)}` + (b.winner ? '' : `. Cannot be told apart from: ${b.top_group.slice(1).join(', ')}`);

// What the page script gets: the rows each tab lists and the fields it prints, not the whole results file.
// Tabs keep the order of the results file; the Overview grid goes from the best caught mode to the least.
const byId = new Map(SUMMARIES.map((s) => [s.m.id, s]));
const results = {
  type_label: TYPE_LABEL,
  thinking_label: THINKING_LABEL,
  overview: OV,
  star_modes: STAR_MODES,
  modes: FILE_ORDER.map((id) => byId.get(id)!).map((s) => ({
    id: s.m.id, name: s.m.name, n: s.m.n, n_pos: s.m.n_pos, n_neg: s.m.n_neg, pos_label: s.m.pos_label, dataset: s.m.dataset,
    shortcut: s.shortcut ? { short: s.shortcut.short, j: s.shortcut.j } : null,
    rows: s.listed.map((r) => ({
      key: r.key, tool: r.tool, type: r.type, thinking: r.thinking ?? null, thinking_note: r.thinking_note ?? null,
      // chart label: the row name, or its short form when another listed row has the same name (North Mini Code, thinking-off / -on)
      label: s.listed.some((o) => o !== r && o.tool === r.tool) ? r.short : r.tool, j: r.j, j_ci: r.j_ci, catch: r.catch, catch_ci: r.catch_ci, fa: r.fa, fa_ci: r.fa_ci,
      cost: r.cost, cost1k: r.cost1k, cost_note: r.cost_note, cost_estimated: r.cost_estimated, kg_id: r.kg_id,
      repository_url: r.repository_url, stars: r.stars, stars_updated_at: r.stars_updated_at,
      incomplete: r.incomplete, unreadable: r.unreadable, n_read: r.n_pos + r.n_neg,
    })),
  })),
};
---

<BaseLayout title={title} rawTitle description={description} jsonld={jsonld}>
  <div class="lb">
    <h1>Leaderboard</h1>
    <p class="subtitle">Supervising AI Coding Agents Benchmark</p>
    <p class="tagline">Can Language Models reliably detect failures made by AI coding agents?</p>
    <p class="byline">Vasyl Rakivnenko, Stanford University</p>
    <p class="lead">How often each supervision tool flags a failure of an AI coding agent (<b>true positive rate</b>, TPR) and how often it flags clean work (<b>false positive rate</b>, FPR). Each entry reports <b>J = TPR − FPR</b> (0% = chance, 100% = perfect).</p>

    <div class="tabs" role="tablist" id="lb-tabs"></div>

    <section id="lb-ov">
      <p class="fine ov-intro">J for each language model, evaluated zero-shot on the failure modes. The bottom row names the highest-scoring reviewer in each mode, tools included; “tie of 4” means the top 4 cannot be told apart. Hover a cell for its false positive rate and cost; click a mode to open its tab.</p>
      <p class="fine ov-scope">Tools are not listed here. Linters, type checkers and review bots each target one or a few failure modes, so their averages would not be comparable with the models’. Their results are in the tab of each mode they cover.</p>
      <div class="tbl-wrap"><table class="ov" id="lb-ov-table"><thead><tr><th>Model</th><th class="think" data-tip="Whether the model thinks before it answers, and at what effort level">Thinking</th>{OV.modes.map((m) => <th class="mcol"><button type="button" class="mlink" data-id={m.id}>{m.name}</button></th>)}<th class="num" data-tip="Mean J over the modes the model ran on (number of modes in brackets)">Average</th></tr></thead><tbody>{OV.rows.map((r) => <tr><td class="rname"><i class="dot" style={`background:${col(r.type)}`}></i>{OV_KG[r.tool] ? <a href={TOOL_URL[OV_KG[r.tool]]}>{r.tool}</a> : r.tool}</td><td class="think" data-tip={r.thinking_note || (r.thinking ? THINKING_LABEL[r.thinking] : '')}>{thinkCell(r.thinking)}</td>{OV.modes.map((m) => { const c = r.cells[m.id]; return c ? <td class={'cell' + (c.j < 0.05 ? ' low' : '')} style={`background:${fill(c.j)};${c.j > 0.55 ? 'color:#fff' : ''}`} data-tip={cellTip(m.name, c)}>{Math.round(c.j * 100) + '%'}</td> : <td class="na" data-tip="not run on this mode">·</td>; })}<td class="num avg">{Math.round(r.avg * 100) + '%'}<span class="nm">{` (${r.n_modes})`}</span></td></tr>)}<tr class="best"><td><b>Best in this mode</b></td><td></td>{OV.modes.map((m) => { const b = OV.best[m.id]; return <td class="cell" data-tip={tieTip(b)}><b>{Math.round(b.j * 100) + '%'}</b><br />{b.short || short(b.tool)}{!b.winner && <span class="nm tie">{`tie of ${b.top_group.length}`}</span>}</td>; })}<td></td></tr></tbody></table></div>
      <div class="legend" id="lb-ov-legend">{ovTypes.map((t) => <span><i style={`background:${col(t)}`}></i>{TYPE_LABEL[t]}</span>)}<span>Darker cell = higher J · “·” = not run</span></div>
      <h2>Average quality vs average cost</h2>
      <p class="fine">Each point is one model’s average J and cost over the checked modes (darker = higher J); the dashed line marks the best J at each price. “(3 of 7)” means the model ran on only 3 of them.</p>
      <div class="ov-modes" id="lb-ov-modes" role="group" aria-label="Failure modes included in the averages"></div>
      <div class="chart" id="lb-ov-chart"></div>
      <h2>What the grid says</h2>
      <ul class="findings" id="lb-ov-findings">{OV.findings.map(([lead, rest]) => <li><b>{lead}</b>{rest}</li>)}</ul>
      <h2>Read before citing</h2>
      <ul class="ov-caveats" id="lb-ov-caveats">{OV.caveats.map((c) => <li>{c}</li>)}</ul>
    </section>

    <section id="lb-star" hidden>
      <p class="fine ov-intro" id="lb-star-intro"></p>
      <div class="tbl-wrap"><table id="lb-star-table"></table></div>
      <p class="fine" id="lb-star-note"></p>
    </section>

    <div id="lb-mode" hidden>
    <div class="controls">
      <div class="types" id="lb-types" role="group" aria-label="Filter by type"></div>
      <span class="mode-note" id="lb-note"></span>
    </div>

    <div class="tbl-wrap">
      <table id="lb-table">
        <thead>
          <tr>
            <th class="num">#</th>
            <th>Tool</th>
            <th>Type</th>
            <th data-tip="Whether a model thinks before it answers, and at what effort level (models only)">Thinking</th>
            <th class="num"><button class="sort" data-k="j" type="button" data-tip="J = TPR − FPR. 0% = no better than chance, 100% = flags every bad sample and no clean one">J</button></th>
            <th class="num"><button class="sort" data-k="catch" type="button" data-tip="True positive rate (recall)">TPR</button></th>
            <th class="num"><button class="sort" data-k="fa" type="button" data-tip="False positive rate">FPR</button></th>
            <th class="num"><button class="sort" data-k="cost" type="button" data-tip="Cost per 1,000 reviews, averaged over our run">Cost</button></th>
          </tr>
        </thead>
        <tbody></tbody>
      </table>
    </div>
    <p class="fine">
      <b>Cost / 1k reviews</b>: what the tool costs to review 1,000 items of this mode (code changes, functions or agent sessions), averaged
      over our run. API models: the price the API reports, or the provider's list price × tokens where it reports none (Azure,
      Fireworks, Cohere, Groq, Mistral; Groq and Mistral ran on free plans but show list price). Self-hosted: GPU time at $0.89/h while
      requests ran. North Mini Code, which has no published price: A100 80 GB time at $1.62/h per call. Free tools: $0. Hover a cost for the run total, a rate for its 95% confidence interval. GitHub stars after a tool's name
      are a popularity reference only, not part of the score.
    </p>
    <p class="fine" id="lb-ref"></p>

    <h2>Quality vs cost</h2>
    <p class="fine">Up is better, left is cheaper. The dashed line is the Pareto frontier: nothing cheaper scores higher.</p>
    <div class="chart" id="lb-chart"></div>
    <div class="legend" id="lb-legend"></div>
    </div>

    <p class="more"><a href="/benchmark/">How each failure mode is tested →</a> · <a href="/findings/">Findings report →</a> · <a href="/graph/">Knowledge graph of supervision tools →</a></p>
  </div>
</BaseLayout>

<script is:inline define:vars={{ results, FM_URL, TOOL_URL, OV_KG }}>
const DATA = results.modes, TYPE_LABEL = results.type_label, THINKING_LABEL = results.thinking_label || {}, OV = results.overview, STAR = results.star_modes || [];
const TYPE_VAR = {deterministic: '--t-free', llm_based: '--t-ai', hybrid: '--t-hybrid', prompt_artifact: '--t-skill', baseline_model: '--t-base', baseline_rule: '--t-rule'};
const isBaseline = (r) => r.type === 'baseline_model' || r.type === 'baseline_rule';
const pct = (x) => (x * 100).toFixed(1) + '%';
const money = (c) => (c === 0 ? '$0' : '$' + c.toFixed(2));
const col = (t) => `var(${TYPE_VAR[t]})`;
const el = (tag, attrs = {}, ...kids) => { const e = document.createElement(tag);
  for (const [k, v] of Object.entries(attrs)) { if (k === 'text') e.textContent = v; else if (k === 'style') e.style.cssText = v; else e.setAttribute(k, v); }
  kids.flat().forEach((k) => k != null && e.append(k)); return e; };
const svgEl = (tag, attrs = {}) => { const e = document.createElementNS('http://www.w3.org/2000/svg', tag);
  for (const [k, v] of Object.entries(attrs)) e.setAttribute(k, v); return e; };
// Tool name -> its page on this site when the catalog has one, else its GitHub repo; GitHub stays one click away in the stars cell.
const toolLink = (kgId, repo, text) => kgId && TOOL_URL[kgId] ? el('a', { href: TOOL_URL[kgId], text }) : repo ? el('a', { href: repo, rel: 'noopener', text }) : text;
// GitHub stars as a tag after a tool's name, e.g. "12k ★ Stars" (same format on every page: site/src/lib/data.ts starsShort)
const starsShort = (n) => (n >= 10000 ? Math.round(n / 1000) + 'k' : n >= 1000 ? (n / 1000).toFixed(1).replace(/\.0$/, '') + 'k' : String(n)) + ' ★ Stars';
const starsTag = (n, repo, asOf) => { if (!n) return null; const a = { class: 'stars', text: starsShort(n), 'data-tip': `${n.toLocaleString('en-US')} GitHub stars` + (asOf ? `, as of ${asOf}` : '') };
  return repo ? el('a', { ...a, href: repo, rel: 'noopener' }) : el('span', a); };
const thinkCell = (t, note) => el('td', { class: 'think', 'data-tip': note || (t ? THINKING_LABEL[t] || '' : ''), text: t || '—' });
const fmLink = (m, sep) => FM_URL[m.id] ? [sep, el('a', { href: FM_URL[m.id], text: `About ${m.name.toLowerCase()} →` })] : [];
const ALL_TYPES = Object.keys(TYPE_LABEL).filter((t) => DATA.some((m) => m.rows.some((r) => r.type === t)));
const state = { mode: OV ? 'overview' : DATA[0].id, key: 'j', types: new Set(ALL_TYPES) };
const store = (k, v) => { try { localStorage.setItem('saica-lb-' + k, JSON.stringify(v)); } catch (e) {} };
const load = (k, d) => { try { const v = localStorage.getItem('saica-lb-' + k); return v === null ? d : JSON.parse(v); } catch (e) { return d; } };
const savedTypes = load('types', null); if (Array.isArray(savedTypes) && savedTypes.length) state.types = new Set(savedTypes.filter((t) => ALL_TYPES.includes(t)));

function rowsFor(m) { return m.rows.filter((r) => state.types.has(r.type)); }
function pareto(rows) { return rows.filter((r) => !rows.some((o) => o !== r && o.cost <= r.cost && o.j > r.j)).sort((a, b) => a.cost - b.cost); }

// Point labels: try right of the dot, above-right, below-right, then the same on the left, then a step or two further;
// a spot is taken when it overlaps another label, another dot or the dashed frontier (which leaves every frontier point
// horizontally to the right, so a frontier label lands above its segment instead of on it).
function placeLabels(svg, items, segs, X0, W, H) {
  const boxes = items.map((it, i) => ({ a: it.x - it.r - 1, b: it.x + it.r + 1, top: it.y - it.r - 1, bot: it.y + it.r + 1, own: i })).concat(segs);
  // frontier labels first (always drawn), then the rest wherever there is still room
  const order = items.map((it, i) => i).sort((p, q) => (items[q].must ? 1 : 0) - (items[p].must ? 1 : 0));
  order.forEach((i) => { const it = items[i]; if (!it.text) return;
    // a label wider than 60% of the plot is cut with an ellipsis (the dot's tooltip has the full name)
    const maxc = Math.min(44, Math.floor((W - X0) * 0.6 / 6.3)), text = it.text.length > maxc ? it.text.slice(0, maxc - 1).trimEnd() + '…' : it.text;
    const w = text.length * 6.3, g = it.r + 3;
    const cands = [];
    for (const side of [1, -1]) for (const by of [it.y + 4, it.y - it.r - 2, it.y + it.r + 12]) cands.push([side, by]);
    for (let k = 2; k <= 3; k++) for (const side of [1, -1]) cands.push([side, it.y + 4 + 13 * k], [side, it.y + 4 - 13 * k]); // stay near the dot
    const box = ([side, by]) => { const lx = it.x + side * g; return { lx, side, by, a: side > 0 ? lx : lx - w, b: side > 0 ? lx + w : lx, top: by - 10, bot: by + 3 }; };
    const inside = (c) => c.a >= X0 && c.b <= W - 2 && c.top >= 0 && c.bot <= H;
    // overlap cost: another label 4, a dot 2, a frontier segment 1 (a thin dashed line under text still reads)
    const hits = (c) => boxes.reduce((n, p) => n + (p.own !== i && c.a < p.b && c.b > p.a && c.top < p.bot && c.bot > p.top ? (p.lx !== undefined ? 4 : p.own !== undefined ? 2 : 1) : 0), 0);
    // first free spot; if none is free (a dense cluster, a long label crossing a frontier step), the cheapest in-bounds one
    const fit = cands.map(box).filter(inside).map((c) => [c, hits(c)]);
    const free = fit.find(([, h]) => h === 0);
    if (!free && !it.must) return; // no room near the dot: leave it unlabelled (hover / focus shows the name) rather than overprint
    const c = (free || fit.sort((x, y) => x[1] - y[1])[0] || [box(cands[0])])[0];
    const label = svgEl('text', { class: 'lbl', x: c.lx, y: c.by, 'text-anchor': c.side > 0 ? 'start' : 'end' }); label.textContent = text; svg.append(label);
    boxes.push(c); });
}
// Boxes covering the dashed frontier path (H then V between consecutive frontier points), for placeLabels.
function frontierSegs(pts) { const s = [];
  for (let i = 1; i < pts.length; i++) { const [x0, y0] = pts[i - 1], [x1, y1] = pts[i];
    s.push({ a: x0, b: x1, top: y0 - 2, bot: y0 + 2 }, { a: x1 - 2, b: x1 + 2, top: Math.min(y0, y1), bot: Math.max(y0, y1) }); }
  return s; }

function renderTable(m) {
  const asc = state.key === 'fa' || state.key === 'cost';
  const rows = [...rowsFor(m)].sort((a, b) => {
    const av = a[state.key] ?? -1, bv = b[state.key] ?? -1; return asc ? av - bv : bv - av; });
  const tb = document.querySelector('#lb-table tbody');
  tb.replaceChildren(...rows.map((r, i) => el('tr', { class: isBaseline(r) ? 'baseline' : '' },
    el('td', { class: 'num rank', text: String(i + 1) }),
    el('td', { class: 'tname' }, toolLink(r.kg_id, r.repository_url, r.tool), starsTag(r.stars, r.repository_url, r.stars_updated_at)),
    el('td', {}, el('span', { class: 'pill', style: `color:${col(r.type)}`, text: TYPE_LABEL[r.type] })),
    thinkCell(r.thinking, r.thinking_note),
    el('td', { class: 'num j', 'data-tip': `95% interval ${pct(r.j_ci[0])} to ${pct(r.j_ci[1])}` + (r.incomplete ? `. † ${r.unreadable} of ${r.n_read} answers had no readable verdict and are left out` : '') }, el('span', { class: 'bar', style: `width:${Math.max(2, r.j * 56)}px` }), pct(r.j) + (r.incomplete ? ' †' : '')),
    el('td', { class: 'num', 'data-tip': `95% CI ${Math.round(r.catch_ci[0] * 100)}–${Math.round(r.catch_ci[1] * 100)}%`, text: pct(r.catch) }),
    el('td', { class: 'num', 'data-tip': `95% CI ${Math.round(r.fa_ci[0] * 100)}–${Math.round(r.fa_ci[1] * 100)}%`, text: pct(r.fa) }),
    el('td', { class: 'num', 'data-tip': `${money(r.cost)} for this run` + (r.cost_note ? `. ${r.cost_note}` : ''), text: (r.cost_estimated ? '~' : '') + money(r.cost1k) }))));
  document.querySelectorAll('#lb-table .sort').forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.k === state.key)));
  document.getElementById('lb-note').replaceChildren(`${m.n_pos} ${m.pos_label} vs ${m.n_neg} clean · ${m.dataset}`, ...fmLink(m, ' · '));
  const ref = [];
  if (m.shortcut) ref.push(`For reference: a rule that understands nothing about the failure (${m.shortcut.short.replace(/^./, (c) => c.toLowerCase())}) scores J ${pct(m.shortcut.j)} on this dataset.`);
  if (rows.some((r) => r.incomplete)) ref.push('† fewer than 95% of the answers had a readable verdict; the rates are on the readable ones.');
  document.getElementById('lb-ref').textContent = ref.join(' ');
}

function renderChart(m) {
  const box = document.getElementById('lb-chart'); box.replaceChildren();
  const rows = rowsFor(m); if (!rows.length) return;
  const W = Math.max(320, box.clientWidth), H = Math.round(Math.min(420, Math.max(280, W * 0.48)));
  const narrow = W < 560, M = { l: 46, r: 16, t: 12, b: 44 }, freeW = 54;
  const per1k = (r) => r.cost1k; const paid = rows.filter((r) => r.cost > 0);
  const lo = paid.length ? Math.min(...paid.map(per1k)) : 0.1, hi = paid.length ? Math.max(...paid.map(per1k)) : 1;
  const xmin = Math.pow(10, Math.floor(Math.log10(lo))), xmax = Math.pow(10, Math.ceil(Math.log10(hi)));
  const x0 = M.l + freeW + 14, x1 = W - M.r, L = (v) => (Math.log10(v) - Math.log10(xmin)) / (Math.log10(xmax) - Math.log10(xmin) || 1);
  const xs = (r) => (r.cost === 0 ? M.l + freeW / 2 : x0 + L(per1k(r)) * (x1 - x0));
  // floor at -100%, not 0: a tool scoring below chance (negative J) was drawn under the x axis, over its tick labels
  const jmin = Math.max(-1, Math.floor(Math.min(...rows.map((r) => r.j)) * 10) / 10 - 0.05);
  const ys = (j) => M.t + (1 - (j - jmin) / (1 - jmin)) * (H - M.t - M.b);
  const svg = svgEl('svg', { viewBox: `0 0 ${W} ${H}`, role: 'img', 'aria-label': `${m.name}: J versus cost per 1,000 reviews` });
  svg.append(svgEl('rect', { class: 'band', x: M.l, y: M.t, width: freeW, height: H - M.t - M.b, rx: 4 }));
  for (let j = Math.ceil(jmin * 10) / 10; j <= 1.0001; j += 0.1) { const y = ys(j);
    svg.append(svgEl('line', { class: 'grid', x1: M.l, x2: x1, y1: y, y2: y }));
    const t = svgEl('text', { x: M.l - 8, y: y + 4, 'text-anchor': 'end' }); t.textContent = Math.round(j * 100) + '%'; svg.append(t); }
  for (let v = xmin; v <= xmax * 1.0001; v *= 10) { const x = x0 + L(v) * (x1 - x0);
    const t = svgEl('text', { x, y: H - M.b + 17, 'text-anchor': 'middle' }); t.textContent = '$' + (v < 1 ? v.toFixed(v < 0.1 ? 2 : 1) : v.toFixed(0)); svg.append(t); }
  const tf = svgEl('text', { x: M.l + freeW / 2, y: H - M.b + 17, 'text-anchor': 'middle' }); tf.textContent = 'free'; svg.append(tf);
  svg.append(svgEl('line', { class: 'axis', x1: M.l, x2: x1, y1: H - M.b, y2: H - M.b }));
