---
// Hub for "AI coding agent failure modes": a definition, every mode with its one-line definition and other names,
// what SAICA-Bench measured for it (static HTML from public/bench/results.json, grouped by where the bad samples
// come from, never as one ranking), and a compact crosswalk to other taxonomies. Copy and data joins live in
// src/components/fm/fm.ts; benchmark values come through components/home/bench.ts.
import BaseLayout from '../../layouts/BaseLayout.astro';
import { crosswalkReviews, graph } from '../../lib/data.ts';
import { reviewNotes } from '../../lib/catalog.ts';
import { abs, breadcrumbs, fmUrl } from '../../lib/seo.ts';
import { GENERATED, altNames, copyFor, crosswalksFor, measured, text } from '../../components/fm/fm.ts';
import {
  CAVEATS, COUNTS, FINDINGS, GROUPS, METHOD,
  bestLabel, bestState, highestJ, rowByKey, rowHref, samplesOf,
} from '../../components/home/bench.ts';
import { int, signedPct } from '../../lib/format.ts';

const all = Object.values(graph.failureModes).map((fm) => ({ fm, c: copyFor(fm.id), m: measured(fm.id) }));
const total = all.length;
const benched = all.filter((x) => x.m);
const unbenched = all.filter((x) => !x.m).sort((a, b) => a.fm.name.localeCompare(b.fm.name));
// Measured modes in the file's neutral order, one block per provenance group; unmeasured modes last.
const blocks = [
  ...GROUPS.map((g) => ({
    id: g.id,
    label: g.label,
    description: g.description,
    rows: g.list.map((m) => all.find((x) => x.m?.id === m.id)!).filter(Boolean),
  })),
  { id: 'unmeasured', label: 'Not benchmarked yet', description: 'No dataset with confirmed labels exists for these modes, so nothing is scored.', rows: unbenched },
].filter((b) => b.rows.length > 0);
const modes = blocks.flatMap((b) => b.rows);

// Compact crosswalk: exact and partial mappings to the four agent-failure taxonomies closest to ours.
const XTAX = [
  { id: 'daplab-9-patterns', short: 'DAPLab 9 patterns' },
  { id: 'mast', short: 'MAST' },
  { id: 'owasp-agentic-top-10-2026', short: 'OWASP Agentic Top 10' },
  { id: 'microsoft-airt-2025', short: 'Microsoft AIRT' },
].filter((t) => graph.taxonomies[t.id]);
const xrows = modes.map(({ fm, c }) => {
  const xw = crosswalksFor(fm.id).filter((x) => x.confidence !== 'related');
  return { fm, c, cells: XTAX.map((t) => xw.filter((x) => x.taxonomy === t.id)) };
});
// Counted from the table, so the legend stays true when the crosswalks change.
const xShown = xrows.flatMap((r) => r.cells.flat());
const xExact = xShown.filter((x) => x.confidence === 'exact').length;
const xReview = reviewNotes(XTAX.map((t) => ({ name: t.short, states: crosswalkReviews(t.id).map((r) => r.state) })));

const description = `The ${total} ways AI coding agents fail, from code hallucination to test manipulation and scope creep. SAICA-Bench measures reviewers on ${COUNTS.modes} of them, ${COUNTS.agent_output} on real agent output.`;

const jsonld = [
  {
    '@context': 'https://schema.org',
    '@type': 'DefinedTermSet',
    '@id': abs('/failure-modes/'),
    name: 'AI coding agent failure modes',
    description: `The ${total} failure modes of AI coding agents that SAICA-Bench defines and measures detectors on.`,
    url: abs('/failure-modes/'),
    dateModified: GENERATED,
    hasDefinedTerm: modes.map(({ fm, c }) => ({
      '@type': 'DefinedTerm',
      '@id': abs(fmUrl(fm.id)),
      name: fm.name,
      alternateName: altNames(fm),
      description: text(c.definition),
      termCode: fm.id,
      url: abs(fmUrl(fm.id)),
      inDefinedTermSet: abs('/failure-modes/'),
    })),
  },
  breadcrumbs([
    ['SAICA-Bench', '/'],
    ['Failure modes', '/failure-modes/'],
  ]),
];
const th = 'py-2 px-2 font-semibold';
---

<BaseLayout title={`AI Coding Agent Failure Modes: ${total} Types, Measured`} description={description} jsonld={jsonld}>
  <nav aria-label="Breadcrumb" class="font-sans text-xs uppercase tracking-widest text-ink-faint">
    <a href="/" class="no-underline hover:underline">SAICA-Bench</a>
    <span aria-hidden="true"> › </span>
    <span aria-current="page">Failure modes</span>
  </nav>
  <h1 class="mt-2">AI Coding Agent Failure Modes</h1>

  <div class="max-w-3xl">
    <p class="mt-4 text-lg leading-8">
      An AI coding agent failure mode is a recurring way an agent’s work goes wrong that a reviewer, a program or a
      test could catch: code that calls APIs that don’t exist, tests edited until they pass, changes nobody asked for,
      a “done” for work that isn’t. SAICA-Bench defines {total} of them, each with a plain definition, the other names
      it goes by and the signals that point to it. The modes are tags, not exclusive classes: one failure can carry
      several of them, and each mode’s page names the modes it is most easily confused with.
    </p>
    <p class="mt-3 leading-7">
      For {benched.length} of the {total}, SAICA-Bench measured what supervision tools and language models flag on
      labelled samples: see <a href="/benchmark/">how the benchmark works</a> and the <a href="/">full leaderboard</a>.
      The table groups the modes by where the bad samples of each set come from, because that decides how a score
      should be read; inside a group the order is alphabetical. {METHOD.setting}
      Terms are defined in the <a href="/glossary/">glossary</a>.
    </p>
  </div>

  <h2>All {total} failure modes</h2>
  <div class="mt-3 overflow-x-auto">
    <table class="w-full border-collapse font-sans text-sm">
      <caption class="sr-only">AI coding agent failure modes and what SAICA-Bench measured for each, grouped by where the bad samples come from</caption>
      <thead>
        <tr class="border-b border-ink/20 text-left text-xs uppercase tracking-wide text-ink-faint align-bottom">
          <th scope="col" class={`${th} pl-0`}>Failure mode</th>
          <th scope="col" class={th}>What it is</th>
          <th scope="col" class={th}>Also called</th>
          <th scope="col" class={th}>Best reviewer on our set</th>
          <th scope="col" class={th}>Best free catalog program</th>
          <th scope="col" class={`${th} pr-0 text-right`}>Samples</th>
        </tr>
      </thead>
      {blocks.map((b) => (
        <tbody data-group={b.id}>
          <tr class="border-b border-ink/10 bg-paper-alt">
            <th scope="colgroup" colspan="6" class="py-2 px-2 text-left">
              <span class="font-semibold">{b.label}</span>
              <span class="ml-2 font-normal text-ink-muted">{b.description}</span>
            </th>
          </tr>
          {b.rows.map(({ fm, c, m }) => {
            const free = m?.best_free_program ?? null;
            const freeRow = m && free ? rowByKey(m, free.key) : undefined;
            const freeHref = freeRow ? rowHref(freeRow) : null;
            return (
              <tr class="border-b border-ink/10 align-top">
                <th scope="row" class="py-2 pr-2 text-left font-normal min-w-[9rem]">
                  <a href={fmUrl(fm.id)} class="font-semibold">{fm.name}</a>
                  {m && m.title !== m.name && <div class="mt-0.5 text-[11px] text-ink-faint">scored as: {m.title}</div>}
                  <div class="mt-0.5 text-[11px] text-ink-faint" data-tier-for={m?.id}>{m ? m.tier_label : 'Not measured'}</div>
                </th>
                <td class="py-2 px-2 font-serif text-[15px] leading-6 min-w-[14rem]">{c.short}</td>
                <td class="py-2 px-2 text-ink-muted min-w-[9rem]">{c.aka.join(', ')}</td>
                <td class="py-2 px-2 tabular-nums min-w-[12rem]">
                  {m ? (
                    <>
                      <span class="font-semibold" data-best-for={m.id} data-best-state={bestState(m)}>{bestLabel(m)}</span>
                      <div class="text-xs text-ink-faint">highest J {highestJ(m)}</div>
                    </>
                  ) : (
                    <span class="text-ink-faint">not measured</span>
                  )}
                </td>
                <td class="py-2 px-2 tabular-nums min-w-[8rem]">
                  {m && free && !m.below_floor ? (
                    <>
                      {freeHref ? <a href={freeHref}>{free.short}</a> : free.short}
                      <div class="text-xs text-ink-faint">J {signedPct(free.j)}</div>
                    </>
                  ) : (
                    <span class="text-ink-faint">{m ? (free ? 'none above the floor' : 'none ran') : '—'}</span>
                  )}
                </td>
                <td class="py-2 pl-2 text-right tabular-nums text-ink-muted whitespace-nowrap">
                  {m ? <span title={`${int(m.n_pos)} ${m.pos_label} vs ${int(m.n_neg)} clean`}>{int(samplesOf(m))}</span> : '—'}
                </td>
              </tr>
            );
          })}
        </tbody>
      ))}
    </table>
  </div>
  <p class="mt-2 font-sans text-xs text-ink-faint leading-5 max-w-3xl">
    {METHOD.metric} {METHOD.best} Samples = bad plus clean samples scored. Results of {GENERATED}; per-reviewer
    tables are on each mode’s page and on the <a href="/">leaderboard</a>.
  </p>

  <h2>What the scores can and cannot say</h2>
  <div class="max-w-3xl">
    <p class="mt-2 leading-7"><strong>{FINDINGS[0]?.[0]}</strong>{FINDINGS[0]?.[1]}</p>
    <p class="mt-3 text-sm text-ink-muted leading-6">{CAVEATS[0]} {METHOD.tiers}</p>
    <p class="mt-3 font-sans text-sm"><a href="/findings/">All findings and caveats →</a> · <a href="/benchmark/#threats">Threats to validity →</a></p>
  </div>

  {XTAX.length > 0 && (
    <>
      <h2>How these map to other taxonomies</h2>
      <p class="max-w-3xl text-ink-muted">
        Each mode is cross-walked to published agent-failure taxonomies. Bold = the same failure (exact match), plain =
        partial overlap; looser “related” links are on each mode’s page and on the <a href="/taxonomies/">taxonomy pages</a>.
        Of the {xShown.length} mappings in this table, {xExact} {xExact === 1 ? 'is' : 'are'} exact.{xReview.map((note) => <> <span data-review-note>{note}</span></>)}
      </p>
      <div class="mt-3 overflow-x-auto">
        <table class="w-full border-collapse font-sans text-sm">
          <caption class="sr-only">SAICA-Bench failure modes mapped to DAPLab, MAST, OWASP Agentic Top 10 and Microsoft AIRT categories</caption>
          <thead>
            <tr class="border-b border-ink/20 text-left text-xs uppercase tracking-wide text-ink-faint align-bottom">
              <th scope="col" class={`${th} pl-0`}>SAICA-Bench</th>
              {XTAX.map((t) => (
                <th scope="col" class={th}><a href={`/taxonomies/${t.id}/`} class="text-ink-faint">{t.short}</a></th>
              ))}
            </tr>
          </thead>
          <tbody>
            {xrows.map(({ fm, cells }) => (
              <tr class="border-b border-ink/10 align-top">
                <th scope="row" class="py-2 pr-2 text-left font-normal whitespace-nowrap"><a href={fmUrl(fm.id)}>{fm.name}</a></th>
                {cells.map((list) => (
                  <td class="py-2 px-2 leading-5 min-w-[9rem]">
                    {list.length === 0 ? (
                      <span class="text-ink-faint">—</span>
                    ) : (
                      list.map((x) => (
                        <div class={x.confidence === 'exact' ? 'font-semibold' : 'text-ink-muted'}>
                          <span class="text-xs text-ink-faint">{x.externalId}</span> {x.label}
                        </div>
                      ))
                    )}
                  </td>
                ))}
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </>
  )}

  <h2>Where to go next</h2>
  <ul class="list-disc pl-5 leading-7 max-w-3xl">
    <li><a href="/">Leaderboard</a>: every tool and model on every measured mode, with cost per 1,000 reviews.</li>
    <li><a href="/benchmark/">Benchmark method</a>: datasets, labels and scoring for each mode.</li>
    <li><a href="/tool-coverage/">Supervision kit builder</a>: pick the modes you care about and get the best-measured tool for each.</li>
    <li><a href="/glossary/">Glossary</a>: the failure modes, their other names and the metrics used here.</li>
    <li><a href="/tools/">Tool catalog</a> and <a href="/incidents/">incidents</a> behind each mode.</li>
  </ul>
</BaseLayout>
