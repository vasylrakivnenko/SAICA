---
import BaseLayout from '../../layouts/BaseLayout.astro';
import RawYamlLink from '../../components/RawYamlLink.astro';
import { graph, paperLabel } from '../../lib/data.ts';
import type { FailureMode } from '../../lib/types.ts';

export function getStaticPaths() {
  return Object.values(graph.failureModes).map((fm) => ({
    params: { id: fm.id },
    props: { fm },
  }));
}

interface Props { fm: FailureMode }
const { fm } = Astro.props;

const priorWork = fm.prior_work.map((id) => graph.papers[id]).filter(Boolean);
const relatedModes = fm.related_modes.map((id) => graph.failureModes[id]).filter(Boolean);
const mitigatingTools = (graph.toolsByFailureMode[fm.id] ?? [])
  .map((id) => graph.tools[id])
  .filter(Boolean);

// Expanded crosswalks with taxonomy + external_label resolved.
const crosswalks = fm.crosswalks.map((cw) => {
  const tax = graph.taxonomies[cw.taxonomy];
  const cat = tax?.categories.find((c) => c.external_id === cw.external_id);
  return {
    ...cw,
    taxonomyName: tax?.name ?? cw.taxonomy,
    taxonomyId: tax?.id ?? cw.taxonomy,
    externalLabel: cat?.label ?? cw.external_id,
    externalDescription: cat?.description,
  };
});

const desc = fm.tagline ?? fm.description.slice(0, 160);
---

<BaseLayout title={fm.name} description={desc}>
  <p class="font-sans text-xs uppercase tracking-widest text-ink-faint">
    <a href="/failure-modes" class="no-underline hover:underline">Failure modes</a>
  </p>
  <h1 class="mt-1">{fm.name}</h1>
  {fm.tagline && <p class="mt-2 text-lg text-ink-muted">{fm.tagline}</p>}

  {fm.aliases.length > 0 && (
    <div class="mt-3 flex flex-wrap gap-1.5">
      {fm.aliases.map((a) => <span class="chip" title="Alias">a.k.a. {a}</span>)}
    </div>
  )}

  <h2>Description</h2>
  <p class="whitespace-pre-line leading-7">{fm.description}</p>

  {fm.detection_signals.length > 0 && (
    <>
      <h2>Detection signals</h2>
      <ul class="list-disc pl-5">
        {fm.detection_signals.map((s) => <li>{s}</li>)}
      </ul>
    </>
  )}

  {priorWork.length > 0 && (
    <>
      <h2>Prior work</h2>
      <ul class="list-disc pl-5">
        {priorWork.map((p) => (
          <li><a href={`/papers/${p.id}`}>{paperLabel(p.id)}</a></li>
        ))}
      </ul>
    </>
  )}

  {crosswalks.length > 0 && (
    <>
      <h2>Crosswalks</h2>
      <ul class="mt-2 space-y-2">
        {crosswalks.map((cw) => (
          <li class="card">
            <div class="flex flex-wrap items-baseline gap-2">
              <a href={`/taxonomies/${cw.taxonomyId}`} class="font-sans font-semibold">
                {cw.taxonomyName}
              </a>
              <span class="text-ink-faint font-sans text-xs">&rarr;</span>
              <span class="font-sans"><code>{cw.external_id}</code> — {cw.externalLabel}</span>
              <span class="chip ml-auto" title="Confidence">{cw.confidence}</span>
            </div>
            {cw.externalDescription && (
              <p class="mt-2 text-sm text-ink-muted">{cw.externalDescription}</p>
            )}
            {cw.note && <p class="mt-2 text-sm">{cw.note}</p>}
          </li>
        ))}
      </ul>
    </>
  )}

  {relatedModes.length > 0 && (
    <>
      <h2>Related failure modes</h2>
      <ul class="list-disc pl-5">
        {relatedModes.map((m) => (
          <li><a href={`/failure-modes/${m.id}`}>{m.name}</a>{m.tagline && <span class="text-ink-muted"> — {m.tagline}</span>}</li>
        ))}
      </ul>
    </>
  )}

  <h2>Mitigating tools</h2>
  {mitigatingTools.length === 0 ? (
    <p class="text-ink-muted">No tools currently indexed address this mode.</p>
  ) : (
    <ul class="list-disc pl-5">
      {mitigatingTools.map((t) => (
        <li>
          <a href={`/tools/${t.id}`}>{t.name}</a>
          {t.tagline && <span class="text-ink-muted"> — {t.tagline}</span>}
        </li>
      ))}
    </ul>
  )}

  <RawYamlLink kind="failure_modes" id={fm.id} />
</BaseLayout>
