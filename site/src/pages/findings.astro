---
// /findings: the SAICA-Bench results as one static report (the page to link to). Every number, name and finding
// comes from /bench/results.json via components/home/bench.ts: the findings and caveats are the file's own
// sentences, and the per-set text is built from the file's fields by its naming rules (a winner only where the
// file names one, a top group otherwise, nobody under the floor). Results are shown in one block per provenance
// group; there is no ranking or average across failure modes.
import BaseLayout from '../layouts/BaseLayout.astro';
import BestPerMode from '../components/home/BestPerMode.astro';
import UnionEstimate from '../components/bench/UnionEstimate.astro';
import {
  AUTHOR, CAVEATS, CITE_AS, COUNTS, FINDINGS, GENERATED, GENERATED_LONG, GROUPS, METHOD, MISSING_MODES, PARTIAL, RAN,
  SOURCES, STAR_MODES, TOTAL_SAMPLES, UNION,
  modeLinks, rankedRows, rowByKey, rowHref, topShortcut,
} from '../components/home/bench';
import { SITE_NAME, abs, fmUrl, leaderboardUrl, breadcrumbs } from '../lib/seo';
import { andList, int, signedPct } from '../lib/format';

const headline = 'Can supervision tools and LLMs catch AI coding agent failures?';
const lead = FINDINGS[0];
const description = lead ? lead[0] : `Findings of ${SITE_NAME} on ${COUNTS.modes} failure modes of AI coding agents.`;
const modeNames = GROUPS.flatMap((g) => g.list.map((m) => m.name));

const jsonld = [
  {
    '@context': 'https://schema.org',
    '@type': 'TechArticle',
    headline: `${headline} Findings from ${SITE_NAME}`,
    description,
    author: AUTHOR,
    datePublished: GENERATED,
    dateModified: GENERATED,
    version: CITE_AS,
    url: abs('/findings/'),
    mainEntityOfPage: abs('/findings/'),
    image: abs('/og.png'),
    inLanguage: 'en',
    isPartOf: { '@type': 'WebSite', name: SITE_NAME, url: abs('/') },
    isBasedOn: abs('/benchmark/'),
    keywords: ['AI coding agents', 'AI code review benchmark', 'coding agent failure modes', 'LLM-as-judge', ...modeNames].join(', '),
  },
  breadcrumbs([[SITE_NAME, '/'], ['Findings', '/findings/']]),
];
---

<BaseLayout title="Can Supervision Tools and LLMs Catch AI Coding Agent Failures?" rawTitle description={description} jsonld={jsonld} ogType="article">
  <article class="fd">
    <p class="font-sans text-xs uppercase tracking-widest text-ink-faint">SAICA-Bench report · {CITE_AS} · built {GENERATED_LONG}</p>
    <h1 class="fd-h1">{headline}</h1>
    <p class="fd-sub">Findings from SAICA-Bench</p>
    <p class="fd-by">Vasyl Rakivnenko, Stanford University</p>

    {PARTIAL && (
      <p class="fd-p fd-warn">This is a partial build of the results: {MISSING_MODES.length ? andList(MISSING_MODES) : 'some modes'} are missing. Do not cite it.</p>
    )}

    <p class="fd-lead">
      AI coding agents fail in recurring ways: they call functions that don't exist, edit tests until they pass, slip
      vulnerabilities into working code, or report a task as done when it isn't. SAICA-Bench asks what reviewers
      flag when they are shown such work. We ran {RAN.models} language models asked directly, {RAN.tools} supervision
      tools ({RAN.catalogTools} of them from our catalog) and {RAN.baselines} baseline and shortcut rules on
      {int(TOTAL_SAMPLES)} labelled samples across {COUNTS.modes} failure modes, and scored every verdict against
      the labels.
    </p>
    {lead && (
      <p class="fd-p" data-lead-finding>
        <strong>{lead[0]}</strong>{lead[1]}
      </p>
    )}
    <p class="fd-p fd-fine">{METHOD.setting} {METHOD.metric}</p>

    <h2>Key findings</h2>
    <ol class="fd-list">
      {FINDINGS.map(([head, rest]) => <li><strong>{head}</strong>{rest}</li>)}
    </ol>

    <h2>Results at a glance</h2>
    <p class="fd-p">
      One line per failure mode, in one block per kind of set, because where the bad samples come from decides how
      a score should be read. “Best reviewer” is the best ranked row of any kind; “best catalog tool” is the highest-scoring
      tool of our catalog running a check of its own. They are different things. Names link to what each failure is; the
      last column opens the set's full table.
    </p>
    <div class="fd-wide"><BestPerMode /></div>

    {UNION && (
      <>
        <h2>If the prompt of every mode ran on every change</h2>
        <p class="fd-p">
          Each score above is for one question about one failure. In use nobody knows which failure a change has, so
          every question would run on every change and their false alarms add up. This was not run; the table is an
          estimate.
        </p>
        <UnionEstimate />
      </>
    )}

    <h2>Set by set</h2>
    {GROUPS.map((g) => (
      <section class="fd-group" data-group={g.id}>
        <h3 class="fd-gh">{g.label}</h3>
        <p class="fd-p fd-fine">{g.description}</p>
        {g.list.map((m) => {
          const l = modeLinks(m);
          const tool = m.best_catalog_tool;
          const toolRow = tool ? rowByKey(m, tool.key) : undefined;
          const th = toolRow ? rowHref(toolRow) : null;
          const s = topShortcut(m);
          return (
            <section class="fd-mode" id={m.id}>
              <h4><a href={l.page}>{m.title}</a>{m.title !== m.name && <span class="fd-fm"> · failure mode: {m.name}</span>}</h4>
              <p class="fd-p">
                {m.summary} On {int(m.n_pos)} {m.pos_label} and {int(m.n_neg)} clean samples, with {rankedRows(m).length} ranked
                rows: <span data-ranking-for={m.id}>{m.ranking}</span>
                {!tool && <> No tool of the catalog ran a check of its own on this set.</>}
                {tool && !m.below_floor && (
                  <> The best catalog tool running its own check is {th ? <a href={th}>{tool.short}</a> : tool.short}, at J {signedPct(tool.j)}.</>
                )}
                {s && <> A shortcut baseline ({s.short}) scores J {signedPct(s.j)} on the same set.</>}
              </p>
              {m.tuning_disclosure && <p class="fd-p fd-fine" data-tuning-for={m.id}>{m.tuning_disclosure}</p>}
              <p class="fd-data">
                {m.tier_label} · Data: {m.dataset}. <a href={l.page}>What {m.name.toLowerCase()} is →</a> · <a href={l.tab}>All rows →</a> ·
                {' '}<a href={l.method}>How it was tested →</a>
              </p>
            </section>
          );
        })}
      </section>
    ))}

    {STAR_MODES.length > 0 && (
      <>
        <h2>Not benchmarked yet</h2>
        <p class="fd-p">
          No public dataset with confirmed labels exists for {andList(STAR_MODES.map((m) => m.name.toLowerCase()))}, so
          nothing is scored for them. The leaderboard lists the catalog's tools for each by GitHub stars, which measure
          popularity, not detection.
        </p>
        <ul class="fd-list">
          {STAR_MODES.map((m) => (
            <li><a href={fmUrl(m.id)}><strong>{m.name}</strong></a>: {m.description} <a href={leaderboardUrl(m.id)}>Catalog tools →</a></li>
          ))}
        </ul>
      </>
    )}

    <h2>Read before citing</h2>
    <ul class="fd-list fd-muted">
      {CAVEATS.map((c) => <li>{c}</li>)}
    </ul>
    <p class="fd-p"><a href="/benchmark/#threats">The full table of threats to validity →</a></p>

    <h2>How it was measured</h2>
    <p class="fd-p">
      Each sample is a task plus what an agent or a model produced for it (a patch, a function or a whole session),
      labelled bad if it contains the failure and clean if it does not. How the samples of each set were made is
      stated per set above and on the benchmark page. Every reviewer sees the samples without the labels.
    </p>
    <ul class="fd-list fd-muted">
      <li>{METHOD.unreadable}</li>
      <li>{METHOD.intervals}</li>
      <li>{METHOD.paired}</li>
      <li>{METHOD.best}</li>
      <li>{METHOD.tiers}</li>
      <li>{METHOD.cost} {METHOD.cheap}</li>
    </ul>
    <p class="fd-p">
      Source datasets: {SOURCES.map((src, i) => <>{i > 0 && (i === SOURCES.length - 1 ? ' and ' : ', ')}<a href={src.url} rel="noopener">{src.name}</a></>)}.
      The full setup and caveats of each set are in the <a href="/benchmark/">benchmark methodology</a>; the raw
      numbers are in <a href="/bench/results.json">results.json</a> (CC-BY-4.0).
    </p>

    <h2>Cite</h2>
    <p class="fd-p fd-cite">
      Vasyl Rakivnenko. {headline} Findings from SAICA-Bench. Stanford University, {GENERATED.slice(0, 4)}. {CITE_AS}. https://saica.ai/findings/
    </p>

    <p class="fd-more font-sans text-sm">
      <a href="/">Leaderboard →</a> · <a href="/failure-modes/">All failure modes →</a> · <a href="/benchmark/">Benchmark methodology →</a> ·
      <a href="/tool-coverage/">Build a supervision kit →</a>
    </p>
  </article>
</BaseLayout>

<style>
  .fd-h1 { margin: .35rem 0 0; line-height: 1.2; }
  .fd-sub { margin: .4rem 0 0; font: 500 18px/1.4 ui-sans-serif, system-ui, sans-serif; color: #111418; }
  .fd-by { margin: .2rem 0 0; font: 14px/1.4 ui-sans-serif, system-ui, sans-serif; color: #6b7180; }
  .fd-lead { margin: 1.2rem 0 0; max-width: 48rem; font-size: 1.08rem; }
  .fd-p { margin: .75rem 0 0; max-width: 48rem; }
  .fd-fine { font: 13px/1.5 ui-sans-serif, system-ui, sans-serif; color: #6b7180; }
  .fd-warn { border: 1px solid #b7791f; background: #fdf6e7; border-radius: 8px; padding: .6rem .8rem; }
  .fd h2 { margin-top: 2.6rem; font-size: 1.3rem; }
  .fd-gh { margin-top: 1.8rem; margin-bottom: 0; font-size: 1.1rem; }
  .fd h4 { margin: 1.3rem 0 0; font: 600 1rem ui-sans-serif, system-ui, sans-serif; }
  .fd h4 a { color: #111418; text-decoration: none; border-bottom: 1px dotted #6b7180; }
  .fd h4 a:hover { color: #1f3a93; }
  .fd-fm { font-weight: 400; font-size: 13px; color: #6b7180; }
  .fd-list { margin: .8rem 0 0; padding-left: 1.3rem; max-width: 48rem; }
  ol.fd-list { list-style: decimal; }
  ul.fd-list { list-style: disc; }
  .fd-list li { margin: .5rem 0; }
  .fd-muted { color: #4a5160; font-size: .95rem; }
  .fd-wide { margin-top: 1rem; }
  .fd-mode .fd-p { margin-top: .4rem; }
  .fd-data { margin: .35rem 0 0; max-width: 48rem; font: 13px/1.5 ui-sans-serif, system-ui, sans-serif; color: #6b7180; }
  .fd-cite { font: 13px/1.5 ui-monospace, SFMono-Regular, Menlo, monospace; color: #4a5160; background: #fff; border: 1px solid rgb(17 20 24 / .1); border-radius: 8px; padding: .7rem .85rem; }
  .fd-more { margin-top: 2.4rem; }
</style>
