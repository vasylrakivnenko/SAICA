---
import BaseLayout from '../../layouts/BaseLayout.astro';
import InlineCode from '../../components/InlineCode.astro';
import RawYamlLink from '../../components/RawYamlLink.astro';
import { graph, facetLabel, paperLabel } from '../../lib/data.ts';
import { abs, breadcrumbs, fmUrl, leaderboardUrl, toolUrl } from '../../lib/seo.ts';
import { benchGenerated, fmName, fmPhrase, measuredFor, money, pct, toolDescription, toolTitle } from '../../lib/catalog.ts';
import type { Tool } from '../../lib/types.ts';
import maturityData from '../../../public/maturity.json';

// Auto-computed maturity tier (Stage 9 of the v2 ingestion pipeline).
// Source of truth: pipeline/maturity/score.py. Regenerate via:
//   python -m validator.generate_maturity
type MaturityRow = {
  tier: '1A'|'1B'|'2A'|'2B'|'3'|'4';
  computed_tier: '1A'|'1B'|'2A'|'2B'|'3'|'4';
  score: number;
  facets: Record<string, number>;
  notes: string[];
  is_override: boolean;
  override: { tier: string; justification: string; by?: string; at?: string } | null;
};
const maturityTools = (maturityData as { tools: Record<string, MaturityRow> }).tools;

const TIER_COLORS: Record<string, string> = {
  '1A': 'bg-emerald-600 text-white',
  '1B': 'bg-emerald-500 text-white',
  '2A': 'bg-amber-400 text-stone-900',
  '2B': 'bg-amber-300 text-stone-900',
  '3':  'bg-orange-400 text-stone-900',
  '4':  'bg-stone-400 text-white',
};

export function getStaticPaths() {
  // Re-import inside getStaticPaths for type safety.
  // (Astro inlines the import-time `graph` across top-level and this fn.)
  return Object.values(graph.tools).map((t) => ({
    params: { id: t.id },
    props: { tool: t },
  }));
}

interface Props { tool: Tool }
const { tool } = Astro.props;
const maturity = maturityTools[tool.id];

const composesWith = tool.composes_with.map((id) => graph.tools[id]).filter(Boolean);
const feedsInto = tool.feeds_into.map((id) => graph.tools[id]).filter(Boolean);
const supersedes = tool.supersedes.map((id) => graph.tools[id]).filter(Boolean);
const citedIn = tool.cited_in.map((id) => graph.papers[id]).filter(Boolean);
const documentedIn = tool.documented_in.map((id) => graph.papers[id]).filter(Boolean);
const evaluatedOn = tool.evaluated_on.map((id) => graph.papers[id]).filter(Boolean);
const desc = toolDescription(tool.id);
const measured = measuredFor(tool.id);
const measuredModes = [...new Set(measured.map((r) => r.modeId))];
const jsonld = [
  {
    '@context': 'https://schema.org',
    '@type': 'SoftwareApplication',
    name: tool.name,
    url: abs(toolUrl(tool.id)),
    description: desc,
    applicationCategory: 'DeveloperApplication',
    ...(tool.repository_url ? { sameAs: tool.repository_url } : {}),
  },
  breadcrumbs([
    ['SAICA-Bench', '/'],
    ['Tools', '/tools/'],
    [tool.name, toolUrl(tool.id)],
  ]),
];
const starsLabel = typeof tool.stars === 'number'
  ? tool.stars.toLocaleString('en-US')
  : null;
// URL text for the narrow sidebar card: without the scheme, with a line-break opportunity after each '/'
// (otherwise a long repo URL either overflows the card or breaks mid-word).
const urlParts = (u: string) => u.replace(/^https?:\/\//, '').split('/').map((seg, i) => (i ? '/' + seg : seg));
---

<BaseLayout title={toolTitle(tool.id)} description={desc} jsonld={jsonld}>
  <p class="font-sans text-xs uppercase tracking-widest text-ink-faint">
    <a href="/tools/" class="no-underline hover:underline">Tools</a>
  </p>
  <div class="mt-1 flex flex-wrap items-baseline gap-x-4 gap-y-1">
    <h1 class="!mb-0">{tool.name}</h1>
    {starsLabel && (
      <a
        href={tool.repository_url}
        rel="noopener"
        title={tool.stars_updated_at ? `GitHub stars (refreshed ${tool.stars_updated_at})` : 'GitHub stars'}
        class="font-sans text-base text-ink-muted no-underline hover:underline"
      >
        <span aria-hidden="true">★</span> <span>{starsLabel}</span>
      </a>
    )}
  </div>
  {tool.tagline && <p class="mt-2 text-lg text-ink-muted">{tool.tagline}</p>}

  <div class="mt-4 flex flex-wrap gap-2">
    <span class="chip-accent">{facetLabel('control_paradigm', tool.control_paradigm)}</span>
    <span class="chip-accent">{facetLabel('temporal_phase', tool.temporal_phase)}</span>
    <span class="chip-accent">{facetLabel('autonomy_level', tool.autonomy_level)}</span>
    <span class="chip">{facetLabel('maturity_status', tool.maturity_status)}</span>
    {maturity && (
      <span
        class={`inline-flex items-center rounded px-2 py-0.5 font-sans text-xs font-bold ${TIER_COLORS[maturity.tier] ?? 'bg-stone-300'}`}
        title={`Maturity tier (auto-computed score=${maturity.score})${maturity.is_override ? ' — curator override' : ''}`}
      >
        Tier {maturity.tier}
        {maturity.is_override && <span class="ml-1 rounded bg-white/30 px-1 text-[10px] uppercase">override</span>}
      </span>
    )}
    {tool.locus_of_control.map((l) => (
      <span class="chip" title="Locus of control">{facetLabel('locus_of_control', l)}</span>
    ))}
  </div>

  {maturity && (
    <details class="mt-3 max-w-3xl rounded border border-ink/10 bg-paper-soft p-3 text-sm">
      <summary class="cursor-pointer font-semibold">
        Maturity tier details
      </summary>
      <div class="mt-2 space-y-2 leading-6">
        <p>
          Computed tier: <strong>{maturity.computed_tier}</strong>
          (raw score <code>{maturity.score}</code>).
          Effective tier: <strong>{maturity.tier}</strong>
          {maturity.is_override && <span> — curator override</span>}.
        </p>
        <p class="text-xs text-ink-faint">
          Facets:
          {Object.entries(maturity.facets).map(([k, v]) => (
            <span class="ml-2"><code>{k}</code>={v}</span>
          ))}
        </p>
        {maturity.notes.length > 0 && (
          <p class="text-xs text-amber-700">{maturity.notes.join(' · ')}</p>
        )}
        {maturity.override && (
          <p class="text-xs text-ink-muted">
            Override justification: <em>{maturity.override.justification}</em>
            {maturity.override.by && <span> — {maturity.override.by}</span>}
            {maturity.override.at && <span> ({maturity.override.at})</span>}
          </p>
        )}
        <p class="text-xs text-ink-faint">
          Source of truth:
          <a href="https://github.com/vasylrakivnenko/SAICA/blob/main/pipeline/maturity/score.py" class="ml-1 underline">pipeline/maturity/score.py</a>
        </p>
      </div>
    </details>
  )}

  {measured.length > 0 && (
    <section class="mt-8" aria-labelledby="measured">
      <h2 id="measured" class="!mt-0">Measured on SAICA-Bench</h2>
      <p class="max-w-3xl leading-7">
        How well {tool.name} catches AI coding agent failures, measured on labelled sets of faulty and clean
        samples (<a href="/benchmark/">how we test</a>). J = TPR &minus; FPR: the share of faulty samples it flags
        minus the share of clean ones it wrongly flags, so 0 is no better than chance. Results as of {benchGenerated}.
      </p>
      <div class="mt-3 overflow-x-auto rounded border border-ink/10">
        <table class="w-full font-sans text-sm">
          <thead class="bg-paper-alt text-xs uppercase tracking-wide text-ink-faint">
            <tr>
              <th scope="col" class="px-3 py-2 text-left">Failure mode</th>
              <th scope="col" class="px-3 py-2 text-left">Configuration</th>
              <th scope="col" class="px-3 py-2 text-right">J</th>
              <th scope="col" class="px-3 py-2 text-right">TPR</th>
              <th scope="col" class="px-3 py-2 text-right">FPR</th>
              <th scope="col" class="px-3 py-2 text-right">Cost per 1,000 reviews</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-ink/10 bg-white">
            {measured.map((r) => (
              <tr>
                <td class="px-3 py-2 align-top">
                  <a href={fmUrl(r.fmId)}>{fmName(r.fmId)}</a>
                  <div class="text-xs text-ink-faint">{fmPhrase(r.fmId)}</div>
                </td>
                <td class="px-3 py-2 align-top">
                  {r.config}
                  <div class="text-xs text-ink-faint">{r.typeLabel}</div>
                </td>
                <td class="px-3 py-2 text-right align-top font-semibold tabular-nums">{pct(r.j)}</td>
                <td class="px-3 py-2 text-right align-top tabular-nums">{pct(r.tpr)}</td>
                <td class="px-3 py-2 text-right align-top tabular-nums">{pct(r.fpr)}</td>
                <td class="px-3 py-2 text-right align-top tabular-nums">{money(r.cost1k, r.estimated)}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <p class="mt-2 font-sans text-sm text-ink-muted">
        {measured.some((r) => r.estimated) && <>~ estimated from a subset of the samples. </>}
        Compare with every tool and model we measured:
        {measuredModes.map((m, i) => (
          <>{i > 0 && ', '}<a href={leaderboardUrl(m)}>{fmName(m)} leaderboard</a></>
        ))}.
      </p>
    </section>
  )}

  <section class="mt-8 grid gap-10 lg:grid-cols-[minmax(0,2fr)_minmax(0,1fr)]">
    <div>
      <h2 class="!mt-0">Description</h2>
      <p class="whitespace-pre-line leading-7"><InlineCode text={tool.description} /></p>

      {tool.inclusion_rationale && (
        <>
          <h2>Why it's included</h2>
          <p class="whitespace-pre-line leading-7"><InlineCode text={tool.inclusion_rationale} /></p>
        </>
      )}

      {tool.security_notes && (
        <>
          <h2>Security notes</h2>
          <p class="whitespace-pre-line leading-7"><InlineCode text={tool.security_notes} /></p>
        </>
      )}

      {tool.addresses_failure_modes.length > 0 && (
        <>
          <h2>Addresses failure modes</h2>
          <ul class="mt-2 list-disc pl-5">
            {tool.addresses_failure_modes.map((fm) => {
              const node = graph.failureModes[fm];
              return (
                <li>
                  {node ? (
                    <a href={fmUrl(fm)}>{node.name}</a>
                  ) : (
                    <span>{fm}</span>
                  )}
                  {node?.tagline && <span class="text-ink-muted"> — {node.tagline}</span>}
                </li>
              );
            })}
          </ul>
        </>
      )}

      {(composesWith.length > 0 || feedsInto.length > 0 || supersedes.length > 0) && (
        <>
          <h2>Related tools</h2>
          {composesWith.length > 0 && (
            <p class="mt-2">
              <span class="font-sans text-xs uppercase tracking-wide text-ink-faint">Composes with:</span>{' '}
              {composesWith.map((t, i) => (
                <>
                  <a href={toolUrl(t.id)}>{t.name}</a>{i < composesWith.length - 1 ? ', ' : ''}
                </>
              ))}
            </p>
          )}
          {feedsInto.length > 0 && (
            <p class="mt-1">
              <span class="font-sans text-xs uppercase tracking-wide text-ink-faint">Feeds into:</span>{' '}
              {feedsInto.map((t, i) => (
                <>
                  <a href={toolUrl(t.id)}>{t.name}</a>{i < feedsInto.length - 1 ? ', ' : ''}
                </>
              ))}
            </p>
          )}
          {supersedes.length > 0 && (
            <p class="mt-1">
              <span class="font-sans text-xs uppercase tracking-wide text-ink-faint">Supersedes:</span>{' '}
              {supersedes.map((t, i) => (
                <>
                  <a href={toolUrl(t.id)}>{t.name}</a>{i < supersedes.length - 1 ? ', ' : ''}
                </>
              ))}
            </p>
          )}
        </>
      )}

      {tool.implements_techniques.length > 0 && (
        <>
          <h2>Techniques</h2>
          <div class="mt-2 flex flex-wrap gap-1.5">
            {tool.implements_techniques.map((tech) => (
              <span class="chip">{tech}</span>
            ))}
          </div>
        </>
      )}

      {(citedIn.length > 0 || documentedIn.length > 0 || evaluatedOn.length > 0) && (
        <>
          <h2>Citations</h2>
          {citedIn.length > 0 && (
            <>
              <h3 class="!mt-3">Cited in</h3>
              <ul class="list-disc pl-5">
                {citedIn.map((p) => (
                  <li><a href={`/papers/${p.id}/`}>{paperLabel(p.id)}</a></li>
                ))}
              </ul>
            </>
          )}
          {documentedIn.length > 0 && (
            <>
              <h3 class="!mt-3">Documented in</h3>
              <ul class="list-disc pl-5">
                {documentedIn.map((p) => (
                  <li><a href={`/papers/${p.id}/`}>{paperLabel(p.id)}</a></li>
                ))}
              </ul>
            </>
          )}
          {evaluatedOn.length > 0 && (
            <>
              <h3 class="!mt-3">Evaluated on</h3>
              <ul class="list-disc pl-5">
                {evaluatedOn.map((p) => (
                  <li><a href={`/papers/${p.id}/`}>{paperLabel(p.id)}</a></li>
                ))}
              </ul>
            </>
          )}
        </>
      )}

      <RawYamlLink kind="tools" id={tool.id} />
    </div>

    <aside class="card h-max">
      <dl class="kv">
        <dt>ID</dt>
        <dd><code>{tool.id}</code></dd>
        <dt>First released</dt>
        <dd>{tool.first_released}</dd>
        {tool.last_updated && (
          <>
            <dt>Last updated</dt>
            <dd>{tool.last_updated}</dd>
          </>
        )}
        <dt>Maturity</dt>
        <dd>{facetLabel('maturity_status', tool.maturity_status)}</dd>
        <dt>License</dt>
        <dd>{tool.license}</dd>
        {tool.published_by && (
          <>
            <dt>Published by</dt>
            <dd>{tool.published_by}</dd>
          </>
        )}
        {tool.repository_url && (
          <>
            <dt>Repository</dt>
            <dd><a href={tool.repository_url} rel="noopener">{urlParts(tool.repository_url).map((seg, i) => <>{i > 0 && <wbr />}{seg}</>)}</a></dd>
          </>
        )}
        {tool.documentation_url && (
          <>
            <dt>Documentation</dt>
            <dd><a href={tool.documentation_url} rel="noopener">{urlParts(tool.documentation_url).map((seg, i) => <>{i > 0 && <wbr />}{seg}</>)}</a></dd>
          </>
        )}
        {typeof tool.signed_manifest === 'boolean' && (
          <>
            <dt>Signed manifest</dt>
            <dd>{tool.signed_manifest ? 'Yes' : 'No'}</dd>
          </>
        )}
        {typeof tool.openssf_scorecard_score === 'number' && (
          <>
            <dt>OpenSSF score</dt>
            <dd>{tool.openssf_scorecard_score}</dd>
          </>
        )}
        {starsLabel && (
          <>
            <dt>GitHub stars</dt>
            <dd>
              {starsLabel}
              {tool.stars_updated_at && (
                <span class="text-ink-faint"> (as of {tool.stars_updated_at})</span>
              )}
            </dd>
          </>
        )}
      </dl>
    </aside>
  </section>
</BaseLayout>
