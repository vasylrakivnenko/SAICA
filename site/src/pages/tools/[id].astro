---
import BaseLayout from '../../layouts/BaseLayout.astro';
import InlineCode from '../../components/InlineCode.astro';
import RawYamlLink from '../../components/RawYamlLink.astro';
import { graph, facetLabel, paperLabel, IMPLEMENTATION_NOTE } from '../../lib/data.ts';
import { abs, breadcrumbs, fmUrl, toolUrl } from '../../lib/seo.ts';
import {
  BAND_AS_OF,
  BAND_COLORS,
  BAND_DESCRIPTION,
  activityBand,
  measuredFor,
  toolDescription,
  toolTitle,
} from '../../lib/catalog.ts';
import type { Tool } from '../../lib/types.ts';
import RunCard from '../../components/bench/RunCard.astro';
import { CITE_AS, GENERATED, METHOD, groupOf, modeLinks, rankedRows, rowTags } from '../../components/home/bench.ts';
import { andList, interval, money, pct, signedPct } from '../../lib/format.ts';
export function getStaticPaths() {
  // Re-import inside getStaticPaths for type safety.
  // (Astro inlines the import-time `graph` across top-level and this fn.)
  return Object.values(graph.tools).map((t) => ({
    params: { id: t.id },
    props: { tool: t },
  }));
}

interface Props { tool: Tool }
const { tool } = Astro.props;
// Activity band (formerly "maturity tier"): popularity and activity, not evidence. See lib/catalog.ts.
const maturity = activityBand(tool.id);

const composesWith = tool.composes_with.map((id) => graph.tools[id]).filter(Boolean);
const feedsInto = tool.feeds_into.map((id) => graph.tools[id]).filter(Boolean);
const supersedes = tool.supersedes.map((id) => graph.tools[id]).filter(Boolean);
const citedIn = tool.cited_in.map((id) => graph.papers[id]).filter(Boolean);
const documentedIn = tool.documented_in.map((id) => graph.papers[id]).filter(Boolean);
const evaluatedOn = tool.evaluated_on.map((id) => graph.papers[id]).filter(Boolean);
const desc = toolDescription(tool.id);
const measured = measuredFor(tool.id);
// Failure-mode tags of the catalog with no measured row for this tool: the claim is untested here.
const measuredFm = new Set(measured.map((r) => r.m.id).map((id) => fmUrl(id)));
const untested = tool.addresses_failure_modes.filter((fm) => !measuredFm.has(fmUrl(fm)));
const jsonld = [
  {
    '@context': 'https://schema.org',
    '@type': 'SoftwareApplication',
    name: tool.name,
    url: abs(toolUrl(tool.id)),
    description: desc,
    applicationCategory: 'DeveloperApplication',
    ...(tool.repository_url ? { sameAs: tool.repository_url } : {}),
  },
  breadcrumbs([
    ['SAICA-Bench', '/'],
    ['Tools', '/tools/'],
    [tool.name, toolUrl(tool.id)],
  ]),
];
const starsLabel = typeof tool.stars === 'number'
  ? tool.stars.toLocaleString('en-US')
  : null;
// URL text for the narrow sidebar card: without the scheme, with a line-break opportunity after each '/'
// (otherwise a long repo URL either overflows the card or breaks mid-word).
const urlParts = (u: string) => u.replace(/^https?:\/\//, '').split('/').map((seg, i) => (i ? '/' + seg : seg));
---

<BaseLayout title={toolTitle(tool.id)} description={desc} jsonld={jsonld}>
  <p class="font-sans text-xs uppercase tracking-widest text-ink-faint">
    <a href="/tools/" class="no-underline hover:underline">Tools</a>
  </p>
  <div class="mt-1 flex flex-wrap items-baseline gap-x-4 gap-y-1">
    <h1 class="!mb-0">{tool.name}</h1>
    {starsLabel && (
      <a
        href={tool.repository_url}
        rel="noopener"
        title={tool.stars_updated_at ? `GitHub stars (refreshed ${tool.stars_updated_at})` : 'GitHub stars'}
        class="font-sans text-base text-ink-muted no-underline hover:underline"
      >
        <span aria-hidden="true">★</span> <span>{starsLabel}</span>
      </a>
    )}
  </div>
  {tool.tagline && <p class="mt-2 text-lg text-ink-muted">{tool.tagline}</p>}

  {tool.archived && (
    <p class="mt-3 max-w-3xl rounded border border-ink/20 bg-paper-alt px-3 py-2 text-sm leading-6" role="note">
      <strong>Upstream archived.</strong> The repository of {tool.name} is read-only: it gets no further changes.
      {tool.editorial_notes && <> {tool.editorial_notes.replace(/\s+/g, ' ').trim()}</>}
    </p>
  )}

  <div class="mt-4 flex flex-wrap gap-2">
    <span class="chip-accent">{facetLabel('control_paradigm', tool.control_paradigm)}</span>
    <span class="chip-accent">{facetLabel('temporal_phase', tool.temporal_phase)}</span>
    <span class="chip-accent">{facetLabel('autonomy_level', tool.autonomy_level)}</span>
    {tool.implementation && <span class="chip-accent">{facetLabel('implementation', tool.implementation)}</span>}
    <span class="chip">{facetLabel('maturity_status', tool.maturity_status)}</span>
    {tool.archived && <span class="chip" data-archived>Upstream archived</span>}
    {maturity && (
      <span
        class={`inline-flex items-center rounded px-2 py-0.5 font-sans text-xs font-bold ${BAND_COLORS[maturity.band] ?? 'bg-stone-300'}`}
        title={`Activity band (stars, recent push, integration surfaces; score ${maturity.score})${maturity.isOverride ? ' — curator override' : ''}`}
      >
        Activity band {maturity.band}
        {maturity.isOverride && <span class="ml-1 rounded bg-white/30 px-1 text-[10px] uppercase">override</span>}
      </span>
    )}
    {tool.locus_of_control.map((l) => (
      <span class="chip" title="Locus of control">{facetLabel('locus_of_control', l)}</span>
    ))}
  </div>

  {maturity && (
    <details class="mt-3 max-w-3xl rounded border border-ink/10 bg-paper-alt p-3 text-sm">
      <summary class="cursor-pointer font-semibold">
        Activity band details
      </summary>
      <div class="mt-2 space-y-2 leading-6">
        <p>{BAND_DESCRIPTION}{BAND_AS_OF && <> Recency is judged as of {BAND_AS_OF}.</>}</p>
        <p>
          Computed band: <strong>{maturity.computedBand}</strong>
          (raw score <code>{maturity.score}</code>).
          Shown band: <strong>{maturity.band}</strong>
          {maturity.isOverride && <span> — curator override</span>}.
        </p>
        <p class="text-xs text-ink-faint">
          Facets:
          {Object.entries(maturity.facets).map(([k, v]) => (
            <span class="ml-2"><code>{k}</code>={v}</span>
          ))}
        </p>
        {maturity.notes.length > 0 && (
          <p class="text-xs text-amber-700">{maturity.notes.join(' · ')}</p>
        )}
        {maturity.override && (
          <p class="text-xs text-ink-muted">
            Override justification: <em>{maturity.override.justification}</em>
            {maturity.override.by && <span> — {maturity.override.by}</span>}
            {maturity.override.at && <span> ({maturity.override.at})</span>}
          </p>
        )}
        <p class="text-xs text-ink-faint">
          Source of truth:
          <a href="https://github.com/vasylrakivnenko/SAICA/blob/main/pipeline/maturity/score.py" class="ml-1 underline">pipeline/maturity/score.py</a>
        </p>
      </div>
    </details>
  )}

  {measured.length > 0 && (
    <section class="mt-8" aria-labelledby="measured">
      <h2 id="measured" class="!mt-0">Measured on SAICA-Bench in this configuration</h2>
      <p class="max-w-3xl leading-7">
        Each row is one run of {tool.name}, set up by us as its run card says, on one labelled set of faulty and
        clean samples (<a href="/benchmark/">how we test</a>). It says what that configuration flagged on that set,
        not how good {tool.name} is in general: another model, another input or the tool's own defaults could
        score differently. {METHOD.metric}
      </p>
      <div class="mt-3 overflow-x-auto rounded border border-ink/10">
        <table class="w-full font-sans text-sm">
          <thead class="bg-paper-alt text-xs uppercase tracking-wide text-ink-faint">
            <tr>
              <th scope="col" class="px-3 py-2 text-left">Set</th>
              <th scope="col" class="px-3 py-2 text-left">Configuration and run card</th>
              <th scope="col" class="px-3 py-2 text-right">J (95% interval)</th>
              <th scope="col" class="px-3 py-2 text-right">TPR</th>
              <th scope="col" class="px-3 py-2 text-right">FPR</th>
              <th scope="col" class="px-3 py-2 text-right">No verdict</th>
              <th scope="col" class="px-3 py-2 text-right">Cost per 1,000 reviews</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-ink/10 bg-white">
            {measured.map(({ m, row: r }) => (
              <tr data-measured={`${m.id}/${r.key}`}>
                <td class="px-3 py-2 align-top min-w-[11rem]">
                  <a href={fmUrl(m.id)}>{m.title}</a>
                  {m.title !== m.name && <div class="text-xs text-ink-faint">failure mode: {m.name}</div>}
                  <div class="text-xs text-ink-faint">{groupOf(m)?.label}</div>
                  <div class="text-xs text-ink-faint"><a href={modeLinks(m).tab} class="text-ink-faint">all rows of this set →</a></div>
                </td>
                <td class="px-3 py-2 align-top min-w-[16rem]">
                  {r.tool}
                  <div class="text-xs text-ink-faint">{rowTags(r).join(' · ')}</div>
                  <div class="text-xs text-ink-muted">
                    {r.ranked
                      ? `Rank ${r.rank} of ${rankedRows(m).length} ranked rows` + (m.below_floor ? `; no reviewer reaches J ${pct(m.floor, 0)} on this set` : '')
                      : `Not ranked: ${r.unranked_reason ?? r.scope}`}.
                  </div>
                  <RunCard row={r} m={m} open />
                </td>
                <td class="px-3 py-2 text-right align-top tabular-nums whitespace-nowrap">
                  <span class="font-semibold">{signedPct(r.j)}</span>
                  <div class="text-xs text-ink-faint">{interval(r.j_ci, 1, true)}</div>
                </td>
                <td class="px-3 py-2 text-right align-top tabular-nums">{pct(r.catch)}</td>
                <td class="px-3 py-2 text-right align-top tabular-nums">{pct(r.fa)}</td>
                <td class="px-3 py-2 text-right align-top tabular-nums">{r.unreadable}{r.incomplete && <div class="text-xs text-ink-faint">incomplete</div>}</td>
                <td class="px-3 py-2 text-right align-top tabular-nums">{money(r.cost1k, r.cost_estimated)}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <p class="mt-2 font-sans text-sm text-ink-muted max-w-3xl">
        {METHOD.unreadable.split('. ')[0]}. “~” marks an estimated cost. {CITE_AS}, built {GENERATED}.
      </p>
    </section>
  )}

  <section class="mt-8 grid gap-10 lg:grid-cols-[minmax(0,2fr)_minmax(0,1fr)]">
    <div>
      <h2 class="!mt-0">Description</h2>
      <p class="whitespace-pre-line leading-7"><InlineCode text={tool.description} /></p>

      {tool.inclusion_rationale && (
        <>
          <h2>Why it's included</h2>
          <p class="whitespace-pre-line leading-7"><InlineCode text={tool.inclusion_rationale} /></p>
        </>
      )}

      {tool.security_notes && (
        <>
          <h2>Security notes</h2>
          <p class="whitespace-pre-line leading-7"><InlineCode text={tool.security_notes} /></p>
        </>
      )}

      {tool.addresses_failure_modes.length > 0 && (
        <>
          <h2>Addresses failure modes</h2>
          <p class="text-sm text-ink-muted">
            These tags are the catalog's claim about what {tool.name} is built to catch or prevent. A tag is not a
            test result.
            {measured.length > 0
              ? <> The rows under <a href="#measured">Measured on SAICA-Bench</a> are the evidence, for the sets and the configuration we ran.{untested.length > 0 && <> Not measured here: {andList(untested.map((fm) => graph.failureModes[fm]?.name ?? fm))}.</>}</>
              : <> SAICA-Bench has not measured {tool.name}, so none of these tags is tested here.</>}
          </p>
          <ul class="mt-2 list-disc pl-5">
            {tool.addresses_failure_modes.map((fm) => {
              const node = graph.failureModes[fm];
              return (
                <li>
                  {node ? (
                    <a href={fmUrl(fm)}>{node.name}</a>
                  ) : (
                    <span>{fm}</span>
                  )}
                  {node?.tagline && <span class="text-ink-muted"> — {node.tagline}</span>}
                </li>
              );
            })}
          </ul>
        </>
      )}

      {tool.records_failure_modes.length > 0 && (
        <>
          <h2>Records evidence of</h2>
          <p class="text-sm text-ink-muted">
            {tool.name} can record evidence of these failures (traces, or checks you configure yourself), but it does
            not detect or prevent them on its own. They are not counted as failure modes it addresses.
          </p>
          <ul class="mt-2 list-disc pl-5">
            {tool.records_failure_modes.map((fm) => {
              const node = graph.failureModes[fm];
              return <li>{node ? <a href={fmUrl(fm)}>{node.name}</a> : <span>{fm}</span>}</li>;
            })}
          </ul>
        </>
      )}

      {(composesWith.length > 0 || feedsInto.length > 0 || supersedes.length > 0) && (
        <>
          <h2>Related tools</h2>
          {composesWith.length > 0 && (
            <p class="mt-2">
              <span class="font-sans text-xs uppercase tracking-wide text-ink-faint">Composes with:</span>{' '}
              {composesWith.map((t, i) => (
                <>
                  <a href={toolUrl(t.id)}>{t.name}</a>{i < composesWith.length - 1 ? ', ' : ''}
                </>
              ))}
            </p>
          )}
          {feedsInto.length > 0 && (
            <p class="mt-1">
              <span class="font-sans text-xs uppercase tracking-wide text-ink-faint">Feeds into:</span>{' '}
              {feedsInto.map((t, i) => (
                <>
                  <a href={toolUrl(t.id)}>{t.name}</a>{i < feedsInto.length - 1 ? ', ' : ''}
                </>
              ))}
            </p>
          )}
          {supersedes.length > 0 && (
            <p class="mt-1">
              <span class="font-sans text-xs uppercase tracking-wide text-ink-faint">Supersedes:</span>{' '}
              {supersedes.map((t, i) => (
                <>
                  <a href={toolUrl(t.id)}>{t.name}</a>{i < supersedes.length - 1 ? ', ' : ''}
                </>
              ))}
            </p>
          )}
        </>
      )}

      {tool.implements_techniques.length > 0 && (
        <>
          <h2>Techniques</h2>
          <div class="mt-2 flex flex-wrap gap-1.5">
            {tool.implements_techniques.map((tech) => (
              <span class="chip">{tech}</span>
            ))}
          </div>
        </>
      )}

      {(citedIn.length > 0 || documentedIn.length > 0 || evaluatedOn.length > 0) && (
        <>
          <h2>Citations</h2>
          {citedIn.length > 0 && (
            <>
              <h3 class="!mt-3">Cited in</h3>
              <ul class="list-disc pl-5">
                {citedIn.map((p) => (
                  <li><a href={`/papers/${p.id}/`}>{paperLabel(p.id)}</a></li>
                ))}
              </ul>
            </>
          )}
          {documentedIn.length > 0 && (
            <>
              <h3 class="!mt-3">Documented in</h3>
              <ul class="list-disc pl-5">
                {documentedIn.map((p) => (
                  <li><a href={`/papers/${p.id}/`}>{paperLabel(p.id)}</a></li>
                ))}
              </ul>
            </>
          )}
          {evaluatedOn.length > 0 && (
            <>
              <h3 class="!mt-3">Evaluated on</h3>
              <ul class="list-disc pl-5">
                {evaluatedOn.map((p) => (
                  <li><a href={`/papers/${p.id}/`}>{paperLabel(p.id)}</a></li>
                ))}
              </ul>
            </>
          )}
        </>
      )}

      <RawYamlLink kind="tools" id={tool.id} />
    </div>

    <aside class="card h-max">
      <dl class="kv">
        <dt>ID</dt>
        <dd><code>{tool.id}</code></dd>
        <dt>First released</dt>
        <dd>{tool.first_released}</dd>
        {(tool.upstream_pushed_at ?? tool.last_updated) && (
          <>
            <dt>Last upstream push</dt>
            <dd>{tool.upstream_pushed_at ?? tool.last_updated}</dd>
          </>
        )}
        {tool.last_reviewed && (
          <>
            <dt>Record checked on</dt>
            <dd>{tool.last_reviewed}</dd>
          </>
        )}
        {tool.implementation && (
          <>
            <dt>Implementation</dt>
            <dd>
              {facetLabel('implementation', tool.implementation)}
              {IMPLEMENTATION_NOTE[tool.implementation] && (
                <span class="text-ink-faint"> ({IMPLEMENTATION_NOTE[tool.implementation]})</span>
              )}
            </dd>
          </>
        )}
        <dt>Maturity</dt>
        <dd>{facetLabel('maturity_status', tool.maturity_status)}</dd>
        <dt>License</dt>
        <dd>{tool.license}</dd>
        {tool.published_by && (
          <>
            <dt>Published by</dt>
            <dd>{tool.published_by}</dd>
          </>
        )}
        {tool.repository_url && (
          <>
            <dt>Repository</dt>
            <dd><a href={tool.repository_url} rel="noopener">{urlParts(tool.repository_url).map((seg, i) => <>{i > 0 && <wbr />}{seg}</>)}</a></dd>
          </>
        )}
        {tool.documentation_url && (
          <>
            <dt>Documentation</dt>
            <dd><a href={tool.documentation_url} rel="noopener">{urlParts(tool.documentation_url).map((seg, i) => <>{i > 0 && <wbr />}{seg}</>)}</a></dd>
          </>
        )}
        {typeof tool.signed_manifest === 'boolean' && (
          <>
            <dt>Signed manifest</dt>
            <dd>{tool.signed_manifest ? 'Yes' : 'No'}</dd>
          </>
        )}
        {typeof tool.openssf_scorecard_score === 'number' && (
          <>
            <dt>OpenSSF score</dt>
            <dd>{tool.openssf_scorecard_score}</dd>
          </>
        )}
        {starsLabel && (
          <>
            <dt>GitHub stars</dt>
            <dd>
              {starsLabel}
              {tool.stars_updated_at && (
                <span class="text-ink-faint"> (as of {tool.stars_updated_at})</span>
              )}
            </dd>
          </>
        )}
      </dl>
    </aside>
  </section>
</BaseLayout>
