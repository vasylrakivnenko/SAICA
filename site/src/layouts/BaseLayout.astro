---
// SAICA-Bench site layout. Structure follows swebench.com: a short sidebar
// (Leaderboard, Benchmark, About, Contact) and one content column.
// Pages not in the sidebar (tools, failure modes, ask, ...) still build and
// stay reachable by URL; they are just not linked.
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
}

const { title, description } = Astro.props;
const fullTitle = title === 'SAICA-Bench' ? 'SAICA-Bench' : `${title} · SAICA-Bench`;
const desc =
  description ??
  'SAICA-Bench measures how well supervision tools catch typical failures of AI coding agents.';
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const nav = [
  { href: '/', label: 'Leaderboard' },
  { href: '/benchmark', label: 'Benchmark' },
  { href: '/graph', label: 'Graph' },
  { href: '/tool-coverage', label: 'Coverage' },
  { href: '/about', label: 'About' },
  { href: '/about#contact', label: 'Contact' },
];
const isActive = (href: string) => (href === '/' ? path === '/' : path === href);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={desc} />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body class="min-h-screen bg-paper text-ink">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:absolute focus:top-2 focus:left-2 bg-white p-2 border border-ink/20 rounded"
      >Skip to main content</a
    >
    <div class="mx-auto max-w-prose-wide px-5 md:flex md:gap-10">
      <aside class="md:w-44 md:shrink-0 md:sticky md:top-0 md:self-start md:max-h-screen md:overflow-y-auto border-b md:border-b-0 border-ink/10 py-4 md:py-10 font-sans">
        <a href="/" class="no-underline text-ink hover:text-accent font-semibold tracking-tight text-lg">SAICA-Bench</a>
        <nav aria-label="Primary" class="mt-3 md:mt-6 text-sm">
          <ul class="flex flex-wrap md:flex-col gap-x-5 gap-y-1 md:gap-y-2">
            {nav.map((n) => (
              <li>
                <a
                  href={n.href}
                  class={isActive(n.href) ? 'text-ink font-semibold no-underline' : 'text-ink-muted no-underline hover:text-accent'}
                  aria-current={isActive(n.href) ? 'page' : undefined}>{n.label}</a
                >
              </li>
            ))}
            <li class="md:mt-3">
              <a href="https://github.com/vasylrakivnenko/SAICA" rel="noopener" class="text-ink-muted no-underline hover:text-accent">GitHub</a>
            </li>
          </ul>
        </nav>
      </aside>

      <main id="main" class="min-w-0 flex-1 py-8 md:py-10">
        <slot />
      </main>
    </div>

    <footer class="border-t border-ink/10 mt-16 bg-paper-alt">
      <div class="mx-auto max-w-prose-wide px-5 py-6 text-xs text-ink-faint font-sans flex flex-wrap justify-between gap-4">
        <div>SAICA-Bench · Code Apache-2.0 · Data CC-BY-4.0</div>
        <div>
          <a href="/bench/results.json">Results JSON</a>
          &middot;
          <a href="https://github.com/vasylrakivnenko/SAICA" rel="noopener">GitHub</a>
        </div>
      </div>
    </footer>
  </body>
</html>
