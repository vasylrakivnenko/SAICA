---
// SAICA-Bench site layout: a fixed sidebar rail and one content column.
// SEO: every page gets a canonical URL (https://saica.ai + trailing slash), Open Graph / Twitter tags, optional
// JSON-LD (`jsonld` prop, one object or a list) and optional `noindex` (duplicates, utility pages).
// Helpers live in ../lib/seo.ts; the sitemap is written after the build by scripts/gen-sitemap.mjs.
import '../styles/global.css';
import { SITE_NAME, OG_IMAGE, abs, clip, jsonLd } from '../lib/seo';

interface Props {
  title: string;
  description?: string;
  /** Exclude from search results (and from the sitemap). */
  noindex?: boolean;
  /** schema.org JSON-LD object(s) for this page. */
  jsonld?: unknown;
  /** Open Graph type: "website" (default) or "article". */
  ogType?: string;
  /** Use the title as-is instead of appending " · SAICA-Bench". */
  rawTitle?: boolean;
}

const { title, description, noindex = false, jsonld, ogType = 'website', rawTitle = false } = Astro.props;
const fullTitle = rawTitle || title === SITE_NAME ? title : `${title} · ${SITE_NAME}`;
const desc = clip(
  description ??
    'SAICA-Bench measures how well supervision tools and LLMs catch the typical failures of AI coding agents.',
  160,
);
const canonical = abs(Astro.url.pathname);
const ogImage = abs(OG_IMAGE);
const ld = jsonld == null ? [] : Array.isArray(jsonld) ? jsonld : [jsonld];
const gscToken = import.meta.env.PUBLIC_GSC_VERIFICATION; // Google Search Console HTML-tag verification (optional)
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const nav = [
  { href: '/', label: 'Leaderboard' },
  { href: '/benchmark/', label: 'Benchmark' },
  { href: '/failure-modes/', label: 'Failure modes' },
  { href: '/tools/', label: 'Tools' },
  { href: '/graph/', label: 'Graph' },
  { href: '/tool-coverage/', label: 'Kit' },
  { href: '/about/', label: 'About' },
  { href: '/about/#contact', label: 'Contact' },
];
const norm = (href: string) => href.split('#')[0].replace(/\/$/, '') || '/';
const isActive = (href: string) => {
  if (href.includes('#')) return false;
  const h = norm(href);
  return h === '/' ? path === '/' : path === h || path.startsWith(h + '/');
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={desc} />
    <meta name="generator" content={Astro.generator} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    {gscToken && <meta name="google-site-verification" content={gscToken} />}
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={desc} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={desc} />
    <meta name="twitter:image" content={ogImage} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="sitemap" type="application/xml" href="/sitemap.xml" />
    {ld.map((d) => <script type="application/ld+json" set:html={jsonLd(d)} />)}
  </head>
  <body class="min-h-screen flex flex-col bg-paper text-ink">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:absolute focus:top-2 focus:left-2 bg-white p-2 border border-ink/20 rounded"
      >Skip to main content</a
    >
    <!-- md+: full-height light-blue rail fixed to the left edge; content and footer start to its right (md:ml-48) -->
    <aside class="bg-accent-soft border-b border-accent/15 px-5 py-4 md:fixed md:inset-y-0 md:left-0 md:z-30 md:w-48 md:border-b-0 md:border-r md:px-6 md:py-10 md:overflow-y-auto font-sans">
        <a href="/" class="no-underline text-ink hover:text-accent font-semibold tracking-tight text-lg">SAICA-Bench</a>
        <nav aria-label="Primary" class="mt-5 md:mt-6 text-sm">
          <ul class="flex flex-wrap md:flex-col gap-x-5 gap-y-1 md:gap-y-2">
            {nav.map((n) => (
              <li>
                <a
                  href={n.href}
                  class={isActive(n.href) ? 'text-ink font-semibold no-underline' : 'text-ink-muted no-underline hover:text-accent'}
                  aria-current={isActive(n.href) ? 'page' : undefined}>{n.label}</a
                >
              </li>
            ))}
            <li class="md:mt-3">
              <a href="https://github.com/vasylrakivnenko/SAICA" rel="noopener" class="text-ink-muted no-underline hover:text-accent">GitHub</a>
            </li>
          </ul>
        </nav>
    </aside>

    <!-- flex-1: on short pages the footer sits at the bottom of the window instead of mid-screen -->
    <div class="flex-1 md:ml-48">
      <main id="main" class="mx-auto max-w-prose-wide min-w-0 px-5 md:px-8 py-8 md:py-10">
        <slot />
      </main>
    </div>

    <footer class="border-t border-ink/10 mt-16 bg-paper-alt md:ml-48">
      <div class="mx-auto max-w-prose-wide px-5 md:px-8 py-6 text-xs text-ink-faint font-sans flex flex-wrap justify-between gap-4">
        <div>SAICA-Bench · Code Apache-2.0 · Data CC-BY-4.0</div>
        <nav aria-label="Footer" class="flex flex-wrap gap-x-3 gap-y-1">
          <a href="/findings/">Findings</a>
          <a href="/failure-modes/">Failure modes</a>
          <a href="/glossary/">Glossary</a>
          <a href="/tools/">Tools</a>
          <a href="/recipes/">Recipes</a>
          <a href="/explore/">Explore</a>
          <a href="/bench/results.json">Results JSON</a>
          <a href="https://github.com/vasylrakivnenko/SAICA" rel="noopener">GitHub</a>
        </nav>
      </div>
    </footer>
  </body>
</html>
