---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
}

const { title, description } = Astro.props;
const fullTitle = title === 'SAICA-KG' ? 'SAICA-KG' : `${title} — SAICA-KG`;
const desc =
  description ??
  'A faceted, queryable knowledge graph of supervision tools and techniques for AI coding agents.';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={desc} />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body class="min-h-screen bg-paper text-ink">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:absolute focus:top-2 focus:left-2 bg-white p-2 border border-ink/20 rounded"
      >Skip to main content</a
    >

    <header class="border-b border-ink/10 bg-paper/80 backdrop-blur">
      <div class="mx-auto max-w-prose-wide px-5 py-3 flex flex-wrap items-baseline gap-x-6 gap-y-2">
        <a
          href="/"
          class="no-underline text-ink hover:text-accent font-sans font-semibold tracking-tight"
          >SAICA-KG</a
        >
        <nav aria-label="Primary" class="text-sm">
          <ul class="flex flex-wrap gap-x-5 gap-y-1">
            <li><a href="/tools">Tools</a></li>
            <li><a href="/failure-modes">Failure Modes</a></li>
            <li><a href="/taxonomies">Taxonomies</a></li>
            <li><a href="/papers">Papers</a></li>
            <li><a href="/incidents">Incidents</a></li>
            <li><a href="/recipes">Recipes</a></li>
            <li><a href="/graph">Graph</a></li>
            <li><a href="/explore">Explore</a></li>
            <li><a href="/pipeline">Pipeline</a></li>
            <li><a href="/ask">Ask</a></li>
            <li><a href="/about">About</a></li>
            <li>
              <a href="https://github.com/saica-kg/saica-kg" rel="noopener">GitHub</a>
            </li>
          </ul>
        </nav>
      </div>
    </header>

    <main id="main" class="mx-auto max-w-prose-wide px-5 py-10">
      <slot />
    </main>

    <footer class="border-t border-ink/10 mt-16 bg-paper-alt">
      <div
        class="mx-auto max-w-prose-wide px-5 py-6 text-xs text-ink-faint font-sans flex flex-wrap justify-between gap-4"
      >
        <div>
          SAICA-KG v0.1 &middot; Code Apache-2.0 &middot; Data CC-BY-4.0
        </div>
        <div>
          <a href="/api/v1/snapshot.json">JSON API</a>
          &middot;
          <a href="https://github.com/saica-kg/saica-kg" rel="noopener">GitHub</a>
        </div>
      </div>
    </footer>
  </body>
</html>
