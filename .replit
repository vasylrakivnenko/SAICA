modules = ["python-3.12", "bash", "nodejs-22"]

[nix]
channel = "stable-25_05"

[agent]
expertMode = true

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start website"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Ask backend"

[[workflows.workflow]]
name = "Start website"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "npm --prefix site run dev"
waitForPort = 5000

[workflows.workflow.metadata]
outputType = "webview"

[[workflows.workflow]]
name = "Ask backend"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "python3 -m pipeline.webapp"

[[ports]]
localPort = 5000
externalPort = 80

[deployment]
deploymentTarget = "autoscale"
build = ["sh", "-c", "pip install -q torch --index-url https://download.pytorch.org/whl/cpu && pip install -q -r pipeline/requirements-web.txt && npm --prefix site ci --no-audit --no-fund && npm --prefix site run build && python3 -c 'from pipeline.webapp import ensure_embeddings; ensure_embeddings()'"]
run = ["sh", "-c", "SERVE_STATIC=1 ASK_HOST=0.0.0.0 ASK_PORT=5000 python3 -m pipeline.webapp"]
