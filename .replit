modules = ["python-3.12", "bash", "nodejs-22"]

[nix]
channel = "stable-25_05"

[agent]
expertMode = true

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start website"

[[workflows.workflow]]
name = "Start website"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "npm --prefix site run dev"
waitForPort = 5000

[workflows.workflow.metadata]
outputType = "webview"

[[ports]]
localPort = 5000
externalPort = 80

[deployment]
deploymentTarget = "static"
build = ["sh", "-c", "npm --prefix site ci --no-audit --no-fund && npm --prefix site run build"]
publicDir = "site/dist"

[deployment.run]
args = ["sh", "-c", "/nix/store/hkbylipx1iiawqdcjv858p501wv81bpm-bash-interactive-5.3p3/bin/bash $file"]
